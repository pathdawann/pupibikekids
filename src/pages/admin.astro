---
import Layout from '../layouts/Layout.astro';
import { supabaseServer } from '../lib/supabase-server.js';

// 1. Inicializamos cliente de servidor
const supabase = supabaseServer(Astro);

// 2. Verificamos la autenticidad
const { data: { user }, error } = await supabase.auth.getUser();

if (!user || error) {
  return Astro.redirect('/login');
}

// 3. Verificamos autorización administrativa
const correosAutorizados = ["pathdawann@gmail.com", "cesar@gmail.com"];
if (!user.email || !correosAutorizados.includes(user.email)) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Panel Administrativo | Pupi Bike Kids" noindex={true}>
  <!-- Navegación Corporativa -->
  <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
    <div class="container mx-auto px-4 lg:px-8 max-w-7xl flex justify-between items-center h-16">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
          <span class="text-white font-black text-sm italic">PK</span>
        </div>
        <a href="/admin" class="text-xl font-black italic tracking-tight text-gray-900">
          PUPIBIKE <span class="text-blue-600">ADMIN</span>
        </a>
      </div>
      <div class="flex items-center gap-4">
        <a href="/dashboard" class="text-sm font-medium text-gray-500 hover:text-blue-600 transition">Vista Atleta</a>
        <button id="btnAdminLogout" class="text-sm font-medium text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-4 py-1.5 rounded-md transition">
          Cerrar Sesión
        </button>
      </div>
    </div>
  </nav>

  <main id="adminContenido" class="bg-gray-50 min-h-screen pb-12">
    <div class="container mx-auto px-4 lg:px-8 py-8 max-w-7xl">
      
      <!-- Encabezado y Acciones Globales -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Centro de Control</h1>
          <p class="text-sm text-gray-500 mt-1">Gestión administrativa y financiera de la academia.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="btnCorreoMasivo" class="bg-white border border-gray-300 text-gray-700 text-sm font-medium px-4 py-2 rounded-md hover:bg-gray-50 shadow-sm transition flex items-center gap-2">
            <span>✉️</span> Enviar Correo (BCC)
          </button>
          <button id="btnExportarAlumnos" class="bg-white border border-gray-300 text-gray-700 text-sm font-medium px-4 py-2 rounded-md hover:bg-gray-50 shadow-sm transition flex items-center gap-2">
            <span>👥</span> Backup Alumnos CSV
          </button>
          <button id="btnExportarPagos" class="bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded-md hover:bg-blue-700 shadow-sm transition flex items-center gap-2">
            <span>💰</span> Backup Pagos CSV
          </button>
        </div>
      </div>

      <!-- DASHBOARD MÉTRICAS (Inyectado por JS) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8" id="metricasDashboard">
        <!-- Tarjetas de resumen estadístico -->
      </div>

      <!-- SECCIÓN SUPERIOR: Tasa e Ingresos -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        
        <!-- Tasa del Día -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-4">
              <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide">Tasa de Cambio (BCV)</h2>
              <span id="fechaTasa" class="text-xs text-gray-400">Actualizando...</span>
            </div>
            <form id="formTasa" class="flex items-center gap-3">
              <div class="relative flex-1">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500 font-medium">Bs.</span>
                <input type="number" step="0.01" id="inputTasa" required class="w-full pl-9 pr-3 py-2 bg-gray-50 border border-gray-300 rounded-md text-gray-900 font-bold focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="0.00">
              </div>
              <button type="submit" id="btnGuardarTasa" class="bg-blue-600 text-white font-medium px-4 py-2 rounded-md hover:bg-blue-700 transition shadow-sm">Guardar</button>
            </form>
          </div>
          <p id="mensajeTasa" class="text-xs font-medium mt-3 text-center hidden"></p>
        </div>

        <!-- Resumen Financiero -->
        <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-4">Control Operativo e Instrucciones</h2>
          <div class="text-sm text-gray-600 space-y-2">
            <p>1. <strong>Tasa Histórica:</strong> Al aprobar un pago hoy, el sistema guardará automáticamente la tasa actual que configuraste arriba. Esto garantiza que el cálculo en Bolívares sea exacto al día de la operación.</p>
            <p>2. <strong>Directorio:</strong> Usa la tabla inferior para buscar atletas por nombre o cédula. Haz clic en "Editar" para modificar sus datos o niveles.</p>
            <p>3. <strong>Respaldos:</strong> Se recomienda descargar el CSV de pagos a final de cada mes para los cierres contables.</p>
          </div>
        </div>
      </div>

      <!-- SECCIÓN: Historial Financiero (Pagos) -->
      <div class="mb-10 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4 bg-gray-50 flex justify-between items-center">
          <h2 class="text-base font-bold text-gray-900">Historial de Recibos y Transferencias</h2>
          <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2.5 py-1 rounded-full" id="contadorPagosMes">Cargando...</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-white border-b border-gray-200 text-gray-500 font-medium">
              <tr>
                <th class="px-6 py-3">Fecha</th>
                <th class="px-6 py-3">Atleta (Cédula)</th>
                <th class="px-6 py-3">Referencia / Método</th>
                <th class="px-6 py-3 text-right">Monto USD</th>
                <th class="px-6 py-3 text-right">Monto BS (Tasa)</th>
                <th class="px-6 py-3 text-center">Mes a Cancelar</th>
                <th class="px-6 py-3 text-center">Estado</th>
              </tr>
            </thead>
            <tbody id="tablaPagosPendientes" class="divide-y divide-gray-100 text-gray-700 bg-white">
              <!-- JS inyecta filas -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECCIÓN: Directorio Total de Atletas -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-12">
        <div class="border-b border-gray-200 px-6 py-4 flex flex-col sm:flex-row justify-between items-center gap-4 bg-gray-50">
          <h2 class="text-base font-bold text-gray-900">Directorio de Alumnos</h2>
          
          <!-- Filtros de Directorio -->
          <div class="flex bg-gray-100 p-1 rounded-lg border border-gray-200">
            <button onclick="window.filtrarDirectorio('TODOS')" id="filtro-TODOS" class="filtro-btn active px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Todos</button>
            <button onclick="window.filtrarDirectorio('AVANZADO')" id="filtro-AVANZADO" class="filtro-btn px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Avanzado</button>
            <button onclick="window.filtrarDirectorio('INTERMEDIO')" id="filtro-INTERMEDIO" class="filtro-btn px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Intermedio</button>
            <button onclick="window.filtrarDirectorio('PRINCIPIANTE')" id="filtro-PRINCIPIANTE" class="filtro-btn px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Principiante</button>
            <button onclick="window.filtrarDirectorio('INACTIVO')" id="filtro-INACTIVO" class="filtro-btn px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Inactivos</button>
          </div>
        </div>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-white border-b border-gray-200 text-gray-500 font-medium">
              <tr>
                <th class="px-6 py-3">Alumno</th>
                <th class="px-6 py-3">Contacto</th>
                <th class="px-6 py-3 text-center">Nivel</th>
                <th class="px-6 py-3 text-center">Solvencia (Mes Actual)</th>
                <th class="px-6 py-3 text-center">Acciones</th>
              </tr>
            </thead>
            <tbody id="tablaDirectorioAtletas" class="divide-y divide-gray-100 text-gray-700 bg-white">
              <!-- JS inyecta filas -->
            </tbody>
          </table>
        </div>
      </div>
      
    </div> <!-- End Container -->

    <!-- ESTILOS PARA LOS BOTONES DE FILTRO -->
    <style>
      .filtro-btn.active {
        background-color: white;
        color: #111827; /* gray-900 */
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      }
    </style>

    <!-- MODAL CONFIRMAR PAGO (Corporativo) -->
    <div id="modalConfirmarPago" class="fixed inset-0 bg-gray-900/50 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 text-center border border-gray-200">
        <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4 text-green-600 text-xl">✓</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Aprobar Pago</h2>
        <p class="text-sm text-gray-500 mb-6">El pago se marcará como aprobado usando la tasa de cambio actual. Esta acción refleja solvencia inmediata para el atleta.</p>
        <div class="flex justify-center gap-3">
          <button id="btnCancelarAprobacion" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancelar</button>
          <button id="btnConfirmarAprobacion" class="px-5 py-2.5 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 shadow-sm">Confirmar Aprobación</button>
        </div>
      </div>
    </div>

    <!-- MODAL DESHACER PAGO (Corporativo) -->
    <div id="modalRevertirPago" class="fixed inset-0 bg-gray-900/50 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 text-center border border-gray-200">
        <div class="w-12 h-12 rounded-full bg-yellow-100 flex items-center justify-center mx-auto mb-4 text-yellow-600 text-xl">⚠️</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Revertir a Revisión</h2>
        <p class="text-sm text-gray-500 mb-6">El recibo volverá al estado "En Revisión" y se eliminará la tasa histórica guardada temporalmente.</p>
        <div class="flex justify-center gap-3">
          <button id="btnCancelarReversion" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancelar</button>
          <button id="btnConfirmarReversion" class="px-5 py-2.5 text-sm font-medium text-white bg-yellow-600 rounded-lg hover:bg-yellow-700 shadow-sm">Revertir Pago</button>
        </div>
      </div>
    </div>

    <!-- MODAL EDICIÓN Y GESTIÓN TOTAL DEL ATLETA (Corporativo) -->
    <div id="modalFichaAtleta" class="fixed inset-0 bg-gray-900/60 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col relative">
        <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-bold text-gray-900">Gestión de Atleta</h2>
          <button id="btnCerrarModalFicha" class="text-gray-400 hover:text-gray-600 focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <div id="contenidoFichaAtleta" class="p-6 overflow-y-auto bg-white flex-1">
          <!-- Inyectado dinámicamente -->
        </div>
      </div>
    </div>

  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  let cacheAlumnos = [];
  let cachePagos = [];
  let tasaActualDolar = 0;
  let filtroActual = 'TODOS';

  document.addEventListener('DOMContentLoaded', async () => {
    try {
      // 1. Cargar Tasa del Día Global
      const { data: tasaData } = await supabase.from('configuracion').select('valor, updated_at').eq('clave', 'tasa_dolar').single();
      
      if (tasaData) {
        tasaActualDolar = parseFloat(tasaData.valor);
        document.getElementById('inputTasa').value = tasaActualDolar;
        const fechaUpd = new Date(tasaData.updated_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', hour: '2-digit', minute:'2-digit' });
        document.getElementById('fechaTasa').textContent = `Act. ${fechaUpd}`;
      }

      // 2. Cargar datos base
      await cargarDatosGlobales();

    } catch (err) {
      console.error("Error inicial:", err);
    }
  });

  async function cargarDatosGlobales() {
    const [{ data: alumnos }, { data: pagos }] = await Promise.all([
      supabase.from('alumnos').select('id, nombre, cedula, telefono, email, nivel, estatus, foto_url, tipo_sangre, direccion, fecha_nacimiento, tipos_bici').order('nombre', { ascending: true }),
      supabase.from('pagos').select('*').order('created_at', { ascending: false })
    ]);

    cacheAlumnos = alumnos || [];
    cachePagos = pagos || [];

    renderizarMetricas();
    renderizarPagos();
    window.filtrarDirectorio(filtroActual);
  }

  function renderizarMetricas() {
    const contenedor = document.getElementById('metricasDashboard');
    
    const totalActivos = cacheAlumnos.filter(a => (a.estatus || 'activo').toLowerCase() !== 'inactivo').length;
    const activosAvanzado = cacheAlumnos.filter(a => (a.nivel || '').toUpperCase() === 'AVANZADO' && (a.estatus || 'activo').toLowerCase() !== 'inactivo').length;
    const activosIntermedio = cacheAlumnos.filter(a => (a.nivel || '').toUpperCase() === 'INTERMEDIO' && (a.estatus || 'activo').toLowerCase() !== 'inactivo').length;
    
    // Calcular ingresos del mes (Solo aprobados del mes en curso)
    const fechaActual = new Date();
    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const mesActualStr = `${mesesNombres[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;
    
    const pagosMesAprobados = cachePagos.filter(p => p.mes_correspondiente === mesActualStr && p.estado === 'aprobado');
    const totalIngresos = pagosMesAprobados.reduce((sum, pago) => sum + Number(pago.monto || 0), 0);

    const pagosRevision = cachePagos.filter(p => p.estado === 'revision').length;

    contenedor.innerHTML = `
      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500 mb-1">Matrícula Total</p>
          <p class="text-3xl font-black text-gray-900">${totalActivos}</p>
        </div>
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center text-2xl">🎓</div>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500 mb-1">Distribución Niveles</p>
          <p class="text-sm font-bold text-gray-900 mt-1">Avz: <span class="text-blue-600">${activosAvanzado}</span> | Int: <span class="text-green-600">${activosIntermedio}</span></p>
          <p class="text-xs text-gray-400 mt-1">Principiantes: ${totalActivos - activosAvanzado - activosIntermedio}</p>
        </div>
        <div class="w-12 h-12 bg-green-50 text-green-600 rounded-full flex items-center justify-center text-2xl">🚲</div>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500 mb-1">Ingresos Aprobados (${mesesNombres[fechaActual.getMonth()]})</p>
          <p class="text-3xl font-black text-gray-900">$${totalIngresos}</p>
        </div>
        <div class="w-12 h-12 bg-gray-50 text-gray-700 rounded-full flex items-center justify-center text-2xl">💵</div>
      </div>

      <div class="bg-white rounded-xl border ${pagosRevision > 0 ? 'border-orange-300 bg-orange-50/30' : 'border-gray-200'} p-5 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-sm font-medium ${pagosRevision > 0 ? 'text-orange-600' : 'text-gray-500'} mb-1">Pagos en Revisión</p>
          <p class="text-3xl font-black ${pagosRevision > 0 ? 'text-orange-600' : 'text-gray-900'}">${pagosRevision}</p>
        </div>
        <div class="w-12 h-12 ${pagosRevision > 0 ? 'bg-orange-100 text-orange-600' : 'bg-gray-100 text-gray-500'} rounded-full flex items-center justify-center text-2xl">⏳</div>
      </div>
    `;
  }

  function renderizarPagos() {
    const tbody = document.getElementById('tablaPagosPendientes');
    tbody.innerHTML = '';
    
    // Limitar visualización a 30 para rendimiento de admin, el CSV baja todos
    const pagosLimitados = cachePagos.slice(0, 30);
    document.getElementById('contadorPagosMes').textContent = `Últimos ${pagosLimitados.length}`;

    if (pagosLimitados.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-sm text-gray-500">No hay pagos registrados en el sistema.</td></tr>`;
      return;
    }

    pagosLimitados.forEach(pago => {
      const fecha = new Date(pago.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
      const atleta = cacheAlumnos.find(a => a.id === pago.alumno_id);
      const nombreAtleta = atleta ? atleta.nombre : 'Atleta Eliminado';
      const cedulaAtleta = atleta ? atleta.cedula : 'N/A';

      // LÓGICA DE TASA HISTÓRICA
      let stringBs = '<span class="text-gray-400 text-xs">Pendiente</span>';
      if (pago.monto_bs && pago.tasa_historica) {
        // Tiene tasa histórica guardada
        stringBs = `<span class="font-medium text-gray-900">${Number(pago.monto_bs).toLocaleString('es-VE')} Bs</span> <br> <span class="text-[10px] text-gray-500">Tasa: ${pago.tasa_historica}</span>`;
      } else if (pago.estado === 'aprobado') {
         // Es un pago viejo aprobado que no tenía tasa, no mostramos error
         stringBs = '<span class="text-gray-400 text-xs">No registrada</span>';
      }

      let badgeEstado = '';
      let btnAccion = '';

      if (pago.estado === 'aprobado') {
        badgeEstado = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Aprobado</span>`;
        btnAccion = `<button onclick="window.revertirPago('${pago.id}')" class="text-xs text-gray-500 hover:text-orange-600 underline focus:outline-none">Revertir</button>`;
      } else {
        badgeEstado = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">Revisión</span>`;
        btnAccion = `<button onclick="window.aprobarPago('${pago.id}', ${pago.monto})" class="bg-blue-600 text-white px-3 py-1.5 rounded text-xs font-medium hover:bg-blue-700 shadow-sm transition">Aprobar</button>`;
      }

      tbody.innerHTML += `
        <tr class="hover:bg-gray-50 transition">
          <td class="px-6 py-4 text-gray-500 font-medium">${fecha}</td>
          <td class="px-6 py-4">
            <div class="text-sm font-bold text-gray-900 uppercase">${nombreAtleta}</div>
            <div class="text-xs text-gray-500">${cedulaAtleta}</div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm text-gray-900 font-mono">${pago.referencia}</div>
            <div class="text-xs text-gray-500">${pago.metodo_pago}</div>
          </td>
          <td class="px-6 py-4 text-right text-sm font-black text-gray-900">$${pago.monto}</td>
          <td class="px-6 py-4 text-right text-sm leading-tight">${stringBs}</td>
          <td class="px-6 py-4 text-center text-sm text-gray-600">${pago.mes_correspondiente}</td>
          <td class="px-6 py-4 text-center">
            <div class="flex flex-col items-center gap-2">
              ${badgeEstado}
              ${btnAccion}
            </div>
          </td>
        </tr>
      `;
    });
  }

  // Lógica de Tabs del Directorio
  window.filtrarDirectorio = function(filtro) {
    filtroActual = filtro;
    document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(`filtro-${filtro}`).classList.add('active');
    
    renderizarDirectorio();
  };

  function renderizarDirectorio() {
    const tbody = document.getElementById('tablaDirectorioAtletas');
    tbody.innerHTML = '';

    let lista = cacheAlumnos;
    if (filtroActual === 'INACTIVO') {
      lista = cacheAlumnos.filter(a => (a.estatus || 'activo').toLowerCase() === 'inactivo');
    } else if (filtroActual !== 'TODOS') {
      lista = cacheAlumnos.filter(a => (a.nivel || '').toUpperCase() === filtroActual && (a.estatus || 'activo').toLowerCase() !== 'inactivo');
    } else {
       lista = cacheAlumnos.filter(a => (a.estatus || 'activo').toLowerCase() !== 'inactivo');
    }

    if (lista.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">No hay atletas en esta vista.</td></tr>`;
      return;
    }

    const fechaActual = new Date();
    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const mesActualStr = `${mesesNombres[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;

    lista.forEach(alumno => {
      const pagosAlumno = cachePagos.filter(p => p.alumno_id === alumno.id);
      const pagoMes = pagosAlumno.find(p => p.mes_correspondiente === mesActualStr);
      
      let badgeEstatusMes = '';
