                  <label for="adminBici2Marca" class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Marca</label>
                  <input type="text" id="adminBici2Marca" value="${escaparHTML(b2.marca || '')}" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm text-gray-900 uppercase bg-white font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                  <label for="adminBici2Color" class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Color</label>
                  <input type="text" id="adminBici2Color" value="${escaparHTML(b2.color || '')}" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm text-gray-900 uppercase bg-white font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-gray-200">
          <button type="submit" id="btnAdminGuardarAtleta" class="bg-blue-600 text-white font-bold px-6 py-2.5 rounded-lg hover:bg-blue-700 transition shadow-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            💾 Guardar Cambios en Ficha
          </button>
        </div>
      </form>

      <!-- NUEVA SECCIÓN: CONTROL FINANCIERO Y CARGA RÁPIDA -->
      <div class="mt-8 pt-6 border-t border-gray-200">
        <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-4 text-emerald-600">3. Control Financiero y Pagos</h4>
        
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
          
          <!-- Columna Izquierda: Historial -->
          <div class="lg:col-span-3 bg-white rounded-xl border border-gray-200 overflow-hidden flex flex-col h-full shadow-sm">
            <div class="px-4 py-3 border-b border-gray-200 bg-gray-50">
              <span class="text-xs font-bold text-gray-600 uppercase">Historial del Alumno</span>
            </div>
            <div class="overflow-y-auto max-h-60">
              <table class="w-full text-left whitespace-nowrap">
                <tbody class="divide-y divide-gray-100">
                  ${filasPagosHtml}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Columna Derecha: Formulario de Carga -->
          <div class="lg:col-span-2 bg-emerald-50/50 rounded-xl border border-emerald-100 p-5 shadow-sm">
            <span class="text-xs font-bold text-emerald-800 uppercase mb-3 block">➕ Carga Rápida (Auto-Aprobado)</span>
            <form id="formAdminPagoRapido" class="space-y-3">
              <input type="hidden" id="pagoRapidoUserId" value="${alumno.user_id || ''}">
              
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Mes a Cancelar</label>
                  <input type="text" id="pagoRapidoMes" value="${mesSugeridoStr}" class="w-full px-2.5 py-1.5 border border-gray-300 rounded text-sm text-gray-900 font-bold focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Monto ($)</label>
                  <input type="number" step="0.1" id="pagoRapidoMonto" value="70" class="w-full px-2.5 py-1.5 border border-gray-300 rounded text-sm text-gray-900 font-bold focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
              </div>
              
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Método</label>
                  <select id="pagoRapidoMetodo" class="w-full px-2.5 py-1.5 border border-gray-300 rounded text-sm text-gray-900 font-bold focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                    <option value="EFECTIVO PISTA">Efectivo en Pista</option>
                    <option value="PAGO MOVIL">Pago Móvil</option>
                    <option value="TRANSFERENCIA">Transferencia</option>
                    <option value="ZELLE">Zelle</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Referencia</label>
                  <input type="text" id="pagoRapidoRef" value="PAGO EN PISTA" placeholder="Ej. 123456" class="w-full px-2.5 py-1.5 border border-gray-300 rounded text-sm text-gray-900 font-bold uppercase focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
              </div>

              <button type="submit" id="btnGuardarPagoRapido" class="w-full mt-2 bg-emerald-600 text-white font-bold px-4 py-2.5 rounded-md hover:bg-emerald-700 transition shadow-sm text-sm">
                Cargar Pago
              </button>
            </form>
          </div>
        </div>
      </div>
    `;


    document.getElementById('formAdminEditarAtleta').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnAdminGuardarAtleta');
      btn.textContent = 'Guardando...';
      btn.disabled = true;

      try {
        const nuevoNivel = document.getElementById('adminEditNivel').value.toUpperCase();
        const nuevoNombre = document.getElementById('adminEditNombre').value.trim().toUpperCase();
        const nuevaCedula = document.getElementById('adminEditCedula').value.trim().toUpperCase();
        const nuevoTel = document.getElementById('adminEditTelefono').value.trim().toUpperCase();
        const nuevaSangre = document.getElementById('adminEditSangre').value;
        const nuevoNacimiento = document.getElementById('adminEditNacimiento').value;
        const nuevaDir = document.getElementById('adminEditDireccion').value.trim().toUpperCase();
        const nuevaCondicion = document.getElementById('adminEditCondicion').value.trim().toUpperCase() || 'NINGUNA';

        const listaBicis = [];
        const b1Tipo = document.getElementById('adminBici1Tipo').value;
        if (b1Tipo) {
          listaBicis.push({
            tipo: b1Tipo,
            rin: document.getElementById('adminBici1Rin').value.trim().toUpperCase(),
            marca: document.getElementById('adminBici1Marca').value.trim().toUpperCase(),
            color: document.getElementById('adminBici1Color').value.trim().toUpperCase()
          });
        }
        const b2Tipo = document.getElementById('adminBici2Tipo').value;
        if (b2Tipo) {
          listaBicis.push({
            tipo: b2Tipo,
            rin: document.getElementById('adminBici2Rin').value.trim().toUpperCase(),
            marca: document.getElementById('adminBici2Marca').value.trim().toUpperCase(),
            color: document.getElementById('adminBici2Color').value.trim().toUpperCase()
          });
        }

        const { error } = await supabase
          .from('alumnos')
          .update({
            nivel: nuevoNivel,
            nombre: nuevoNombre,
            cedula: nuevaCedula,
            telefono: nuevoTel,
            tipo_sangre: nuevaSangre,
            fecha_nacimiento: nuevoNacimiento,
            direccion: nuevaDir,
            condicion_especial: nuevaCondicion,
            tipos_bici: listaBicis
          })
          .eq('id', alumnoId);

        if (error) throw error;
        
        alert("¡Ficha actualizada exitosamente!");
        await cargarDatosGlobales();
        window.verFichaAtleta(alumnoId);
      } catch (err) {
        console.error(err);
        alert("Error al actualizar la información.");
      } finally {
        btn.textContent = '💾 Guardar Cambios en Ficha';
        btn.disabled = false;
      }
    });
  };

  // --- NUEVO: LÓGICA DE UX PARA AUTO-RELLENAR LA REFERENCIA ---
    document.getElementById('pagoRapidoMetodo').addEventListener('change', (e) => {
      const refInput = document.getElementById('pagoRapidoRef');
      if (e.target.value === 'EFECTIVO PISTA') {
        refInput.value = 'PAGO EN PISTA';
      } else {
        refInput.value = '';
        refInput.focus();
      }
    });

    // --- NUEVO: LÓGICA PARA ENVIAR EL PAGO RÁPIDO A SUPABASE ---
    document.getElementById('formAdminPagoRapido').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (tasaActualDolar <= 0) {
        alert("¡ATENCIÓN! Configura la Tasa del Día en la parte superior del panel antes de procesar un pago.");
        document.getElementById('btnCerrarModalFicha').click();
        document.getElementById('inputTasa').focus();
        return;
      }

      const btn = document.getElementById('btnGuardarPagoRapido');
      btn.textContent = 'Procesando...';
      btn.disabled = true;

      try {
        const montoUsd = parseFloat(document.getElementById('pagoRapidoMonto').value);
        const montoBs = (montoUsd * tasaActualDolar).toFixed(2);
        
        // Obtenemos el user_id del superadmin si el alumno no tiene uno vinculado
        const authData = await supabase.auth.getUser();
        const userIdAuth = document.getElementById('pagoRapidoUserId').value || authData.data.user.id;

        const payload = {
          alumno_id: alumnoId,
          user_id: userIdAuth,
          monto: montoUsd,
          metodo_pago: document.getElementById('pagoRapidoMetodo').value,
          referencia: document.getElementById('pagoRapidoRef').value.trim().toUpperCase(),
          mes_correspondiente: document.getElementById('pagoRapidoMes').value.trim(),
          estado: 'aprobado',
          tasa_historica: tasaActualDolar,
          monto_bs: montoBs,
          comprobante_url: null // Al ser carga manual presencial, no se exige voucher
        };

        const { error } = await supabase.from('pagos').insert([payload]);
        if (error) throw error;

        alert("¡Pago procesado exitosamente! El alumno ahora está Al Día.");
        
        // Recargamos el sistema y abrimos la ficha de nuevo para ver el cambio instantáneo
        await cargarDatosGlobales();
        window.verFichaAtleta(alumnoId); 
      } catch(err) {
        console.error(err);
        alert("Ocurrió un error al cargar el pago.");
        btn.textContent = 'Cargar Pago';
        btn.disabled = false;
      }
    });
  

  window.alternarEstatusAtleta = async function(alumnoId, nuevoEstatus) {
    const accion = nuevoEstatus === 'inactivo' ? 'suspender a No Activos' : 'reactivar';
    if (!confirm(`¿Estás seguro de ${accion} a este atleta?`)) return;

    try {
      const { error } = await supabase
        .from('alumnos')
        .update({ estatus: nuevoEstatus })
        .eq('id', alumnoId);

      if (error) throw error;
      
      alert(`Atleta ${nuevoEstatus === 'inactivo' ? 'movido a Inactivos' : 'reactivado exitosamente'}.`);
      await cargarDatosGlobales();
      window.verFichaAtleta(alumnoId); 
    } catch (err) {
      console.error(err);
      alert("Error al cambiar el estatus.");
    }
  };

  window.eliminarAtletaDefinitivo = async function(alumnoId) {
    if (!esSuperAdmin) {
      alert("Acción denegada: Solo la Super Administradora puede eliminar atletas.");
      return;
    }

    const alumno = cacheAlumnos.find(a => String(a.id) === String(alumnoId));
    const nombre = alumno ? alumno.nombre : 'este atleta';

    const confirmacion = prompt(`⚠️ ADVERTENCIA: Esta acción eliminará permanentemente a ${nombre} y todo su historial de pagos.\n\nPara confirmar, escribe: ELIMINAR`);
    if (confirmacion !== 'ELIMINAR') return;

    try {
      await supabase.from('pagos').delete().eq('alumno_id', alumnoId);

      const { error } = await supabase.from('alumnos').delete().eq('id', alumnoId);
      if (error) throw error;

      alert(`El atleta ${nombre} ha sido eliminado del sistema.`);
      modalFicha.classList.add('hidden');
      await cargarDatosGlobales();
    } catch (err) {
      console.error(err);
      alert("Error al eliminar el atleta.");
    }
  };
</script>