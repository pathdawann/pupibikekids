---
import Layout from '../layouts/Layout.astro';
import { supabaseServer } from '../lib/supabase-server.js';

// 1. Inicializamos cliente de servidor
const supabase = supabaseServer(Astro);

// 2. Verificamos la autenticidad
const { data: { user }, error } = await supabase.auth.getUser();

if (!user || error) {
  return Astro.redirect('/login');
}

// 3. Verificamos autorización administrativa y roles
const correosAutorizados = ["pathdawann@gmail.com", "pupibikekids27@gmail.com"];
if (!user.email || !correosAutorizados.includes(user.email)) {
  return Astro.redirect('/dashboard');
}

// Solo Patricia Mago tiene permisos de borrado permanente
const esSuperAdmin = user.email === "pathdawann@gmail.com";
---

<Layout title="Panel Administrativo | Pupi Bike Kids" noindex={true}>
  <!-- Navegación Corporativa con ancho al 96% -->
  <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
    <div class="container mx-auto px-4 lg:px-8 max-w-[96%] flex justify-between items-center h-16">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
          <span class="text-white font-black text-sm italic">PK</span>
        </div>
        <a href="/admin" class="text-xl font-black italic tracking-tight text-gray-900">
          PUPIBIKE<span class="text-blue-600">ADMIN</span>
        </a>
      </div>
      <div class="flex items-center gap-4">
        <a href="/dashboard" class="text-sm font-medium text-gray-500 hover:text-blue-600 transition">Vista Atleta</a>
        <button id="btnAdminLogout" class="text-sm font-medium text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-4 py-1.5 rounded-md transition">
          Cerrar Sesión
        </button>
      </div>
    </div>
  </nav>

  <main id="adminContenido" data-superadmin={esSuperAdmin ? "true" : "false"} class="bg-gray-50 min-h-screen pb-12">
    <div class="container mx-auto px-4 lg:px-8 py-8 max-w-[96%]">
      
      <!-- Encabezado y Acciones Globales -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">Centro de Control</h1>
          <p class="text-sm text-gray-500 mt-1">Gestión administrativa y financiera de la academia.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/admin-cambibara" class="bg-green-600 text-white text-sm font-bold px-4 py-2 rounded-md hover:bg-green-700 shadow-sm transition flex items-center gap-2">
            <span>🏆</span> Panel Cambibara Race
          </a>
          <a href="/admin-leads" class="bg-purple-600 text-white text-sm font-bold px-4 py-2 rounded-md hover:bg-purple-700 shadow-sm transition flex items-center gap-2">
            <span>📧</span> Ver Suscriptores (Leads)
          </a>
          <button id="btnRecordatorioPago" class="bg-yellow-50 border border-yellow-200 text-yellow-700 text-sm font-bold px-4 py-2 rounded-md hover:bg-yellow-100 shadow-sm transition flex items-center gap-2">
            <span>🔔</span> Recordatorios Manuales
          </button>
          <button id="btnCorreoMasivo" class="bg-white border border-gray-300 text-gray-700 text-sm font-medium px-4 py-2 rounded-md hover:bg-gray-50 shadow-sm transition flex items-center gap-2">
            <span>✉️</span> Enviar Correo (BCC)
          </button>
          <button id="btnExportarAlumnos" class="bg-white border border-gray-300 text-gray-700 text-sm font-medium px-4 py-2 rounded-md hover:bg-gray-50 shadow-sm transition flex items-center gap-2">
            <span>👥</span> Backup Alumnos CSV
          </button>
          <button id="btnExportarPagos" class="bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded-md hover:bg-blue-700 shadow-sm transition flex items-center gap-2">
            <span>💰</span> Backup Pagos CSV
          </button>
        </div>
      </div>

      <!-- DASHBOARD MÉTRICAS -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8" id="metricasDashboard">
        <!-- Tarjetas de resumen estadístico -->
      </div>

      <!-- SECCIÓN SUPERIOR: Tasa e Ingresos -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        
        <!-- Tasa del Día (Rediseñada) -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <label for="inputTasa" class="text-xs font-black text-gray-600 uppercase tracking-wider">
                  Tasa Oficial (BCV)
                </label>
              </div>
              <span id="fechaTasa" class="text-[11px] font-semibold text-gray-400 bg-gray-50 border border-gray-200 px-2 py-0.5 rounded-md">
                Actualizando...
              </span>
            </div>

            <!-- Input Group Moderno -->
            <form id="formTasa" class="mt-2">
              <div class="flex rounded-lg shadow-sm border border-gray-300 focus-within:border-blue-600 focus-within:ring-2 focus-within:ring-blue-600/20 overflow-hidden transition">
                <span class="inline-flex items-center px-3.5 bg-gray-50 text-gray-500 font-black text-2sm border-r border-gray-200 select-none">
                  Bs.
                </span>
                <input 
                  type="number" 
                  step="0.01" 
                  id="inputTasa" 
                  required 
                  class="flex-1 min-w-0 px-3.5 py-2.5 bg-white text-gray-900 font-black text-lg focus:outline-none placeholder-gray-300" 
                  placeholder="0.00"
                >
                <button 
                  type="submit" 
                  id="btnGuardarTasa" 
                  class="inline-flex items-center px-4 py-2.5 bg-blue-600 text-white font-bold text-xs uppercase tracking-wider hover:bg-blue-700 active:bg-blue-800 transition focus:outline-none"
                >
                  Guardar
                </button>
              </div>
            </form>
          </div>

          <div class="mt-4 pt-3 border-t border-gray-50 flex items-center justify-between text-[14px] text-gray-500">
            <span>⚡ Conversión directa para recibos</span>
            <p id="mensajeTasa" class="font-bold hidden"></p>
          </div>
        </div>

        <!-- Resumen Financiero -->
        <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-4">Control Operativo e Instrucciones</h2>
          <div class="text-sm text-gray-600 space-y-2">
            <p>1. <strong>Tasa Histórica:</strong> Al aprobar un pago hoy, el sistema guardará automáticamente la tasa actual que configuraste arriba. Esto garantiza que el cálculo en Bolívares sea exacto al día de la operación.</p>
            <p>2. <strong>Directorio e Inclusión:</strong> Los alumnos con observaciones de salud o neurodivergencia muestran la insignia <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">💙 Acompañamiento</span>. Haz clic en "Ficha" para ver las recomendaciones del representante.</p>
            <p>3. <strong>Respaldos:</strong> Se recomienda descargar el CSV de pagos a final de cada mes para los cierres contables.</p>
          </div>
        </div>
      </div>

      <!-- SECCIÓN: Historial Financiero (Pagos) CON PESTAÑAS Y BUSCADOR -->
      <div class="mb-10 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4 bg-gray-50 flex flex-col xl:flex-row justify-between items-start xl:items-center gap-4">
          <div>
            <h2 class="text-base font-bold text-gray-900">Historial de Pagos</h2>
            <p class="text-xs text-gray-500">Reportes de transferencias y mensualidades.</p>
          </div>
          
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full xl:w-auto">
            <div class="relative w-full sm:w-64">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400 text-xs">🔍</span>
              <input 
                type="text" 
                id="inputBuscarPago" 
                placeholder="Buscar por atleta o ref..." 
                class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-gray-300 rounded-md text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
            </div>
            
            <!-- Pestañas de Filtro de Pagos -->
            <div class="flex bg-gray-100 p-1 rounded-lg border border-gray-200 w-full sm:w-auto justify-center">
              <button onclick="window.filtrarPagos('REVISION')" id="filtro-pago-REVISION" class="filtro-pago-btn active px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900 flex items-center gap-1.5">
                ⏳ Pendientes <span id="badgePagosPendientes" class="bg-orange-200 text-orange-800 px-1.5 py-0.5 rounded-full text-[10px] leading-none">0</span>
              </button>
              <button onclick="window.filtrarPagos('APROBADO')" id="filtro-pago-APROBADO" class="filtro-pago-btn px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">
                ✓ Aprobados
              </button>
              <button onclick="window.filtrarPagos('TODOS')" id="filtro-pago-TODOS" class="filtro-pago-btn px-3 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">
                Todos
              </button>
            </div>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-base whitespace-normal md:whitespace-nowrap">
            <thead class="bg-white border-b border-gray-200 text-gray-600 text-base font-bold hidden md:table-header-group">
              <tr>
                <th class="px-6 py-3">Fecha</th>
                <th class="px-6 py-3">Atleta (Cédula)</th>
                <th class="px-6 py-3">Referencia / Método</th>
                <th class="px-6 py-3 text-right">Monto USD</th>
                <th class="px-6 py-3 text-right">Monto BS (Tasa)</th>
                <th class="px-6 py-3 text-center">Mes a Cancelar</th>
                <th class="px-6 py-3 text-center">Capture</th>
                <th class="px-6 py-3 text-center">Estado</th>
                <th class="px-6 py-3 text-center">Acciones</th>
              </tr>
            </thead>
            <tbody id="tablaPagosPendientes" class="divide-y divide-gray-100 text-gray-700 bg-white">
              <!-- JS inyecta filas -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECCIÓN: Directorio Total de Atletas CON BUSCADOR Y 5 NIVELES -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-12">
        <div class="border-b border-gray-200 px-6 py-4 flex flex-col xl:flex-row justify-between items-center gap-4 bg-gray-50">
          <div>
            <h2 class="text-base font-bold text-gray-900">Directorio de Alumnos</h2>
            <p class="text-xs text-gray-500">Gestión de fichas técnicas, acompañamiento y solvencias.</p>
          </div>
          
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full xl:w-auto">
            <div class="relative w-full sm:w-64">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400 text-xs">🔍</span>
              <input 
                type="text" 
                id="inputBuscarAlumno" 
                placeholder="Buscar por nombre, cédula o tel..." 
                class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-gray-300 rounded-md text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
            </div>

            <div class="flex flex-wrap bg-gray-100 p-1 rounded-lg border border-gray-200 w-full sm:w-auto justify-center">
              <button onclick="window.filtrarDirectorio('TODOS')" id="filtro-TODOS" class="filtro-btn active px-2.5 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Todos</button>
              <button onclick="window.filtrarDirectorio('PROSPECTO')" id="filtro-PROSPECTO" class="filtro-btn px-2.5 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Prospectos</button>
              <button onclick="window.filtrarDirectorio('AVANZADO')" id="filtro-AVANZADO" class="filtro-btn px-2.5 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Avanzado</button>
              <button onclick="window.filtrarDirectorio('INTERMEDIO')" id="filtro-INTERMEDIO" class="filtro-btn px-2.5 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Intermedio</button>
              <button onclick="window.filtrarDirectorio('PRINCIPIANTE')" id="filtro-PRINCIPIANTE" class="filtro-btn px-2.5 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Principiante</button>
              <button onclick="window.filtrarDirectorio('ADULTOS')" id="filtro-ADULTOS" class="filtro-btn px-2.5 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Adultos</button>
              <button onclick="window.filtrarDirectorio('INACTIVO')" id="filtro-INACTIVO" class="filtro-btn px-2.5 py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-900">Inactivos</button>
            </div>
          </div>
        </div>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-normal md:whitespace-nowrap">
            <!-- Reemplaza el thead actual por este: -->
            <thead class="bg-white border-b border-gray-200 text-gray-600 text-base font-bold hidden md:table-header-group">
              <tr>
                <th class="px-6 py-3">Alumno</th>
                <th class="px-6 py-3">Contacto</th>
                <th class="px-6 py-3 text-center">Nivel</th>
                <th class="px-6 py-3 text-center">Solvencia (Mes Actual)</th>
                <th class="px-6 py-3 text-center">Acciones</th>
              </tr>
            </thead>
            <tbody id="tablaDirectorioAtletas" class="divide-y divide-gray-100 text-gray-700 bg-white">
              <!-- JS inyecta filas -->
            </tbody>
          </table>
        </div>
      </div>
      
    </div>

    <style>
      /* Transición suave para todos los botones al hacer clic */
      .filtro-btn, .filtro-pago-btn {
        transition: all 0.3s ease;
      }

      /* Estilo para el botón SELECCIONADO (Azul PupiBike Admin) */
      .filtro-btn.active, .filtro-pago-btn.active {
        background-color: #2563eb !important; /* Fondo Azul (blue-600) */
        color: #ffffff !important; /* Texto Blanco */
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3) !important; /* Sombra suave azulada */
      }

      /* Ajuste dinámico: Si el botón de "Pendientes" está activo, 
         el circulito con el número cambia a blanco para que contraste perfecto */
      .filtro-pago-btn.active #badgePagosPendientes {
        background-color: #ffffff !important;
        color: #2563eb !important;
      }
    </style>

    <!-- MODAL CONFIRMAR PAGO -->
    <div id="modalConfirmarPago" class="fixed inset-0 bg-gray-900/50 z-100 hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 text-center border border-gray-200">
        <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4 text-green-600 text-xl">✓</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Aprobar Pago</h2>
        <p class="text-sm text-gray-500 mb-6">El pago se marcará como aprobado usando la tasa de cambio actual. Esta acción refleja solvencia inmediata para el atleta.</p>
        <div class="flex justify-center gap-3">
          <button id="btnCancelarAprobacion" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancelar</button>
          <button id="btnConfirmarAprobacion" class="px-5 py-2.5 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 shadow-sm">Confirmar Aprobación</button>
        </div>
      </div>
    </div>

    <!-- MODAL DESHACER PAGO -->
    <div id="modalRevertirPago" class="fixed inset-0 bg-gray-900/50 z-100 hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 text-center border border-gray-200">
        <div class="w-12 h-12 rounded-full bg-yellow-100 flex items-center justify-center mx-auto mb-4 text-yellow-600 text-xl">⚠️</div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Revertir a Revisión</h2>
        <p class="text-sm text-gray-500 mb-6">El recibo volverá al estado "En Revisión" y se eliminará la tasa histórica guardada temporalmente.</p>
        <div class="flex justify-center gap-3">
          <button id="btnCancelarReversion" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancelar</button>
          <button id="btnConfirmarReversion" class="px-5 py-2.5 text-sm font-medium text-white bg-yellow-600 rounded-lg hover:bg-yellow-700 shadow-sm">Revertir Pago</button>
        </div>
      </div>
    </div>

    <!-- MODAL EDICIÓN Y GESTIÓN TOTAL DEL ATLETA -->
    <div id="modalFichaAtleta" class="fixed inset-0 bg-gray-900/60 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col relative">
        <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-bold text-gray-900">Gestión de Atleta</h2>
          <button id="btnCerrarModalFicha" aria-label="Cerrar ficha de atleta" class="text-gray-400 hover:text-gray-600 focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <div id="contenidoFichaAtleta" class="p-6 overflow-y-auto bg-white flex-1">
          <!-- Inyectado dinámicamente -->
        </div>
      </div>
    </div>

  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  let cacheAlumnos = [];
  let cachePagos = [];
  let tasaActualDolar = 0;
  let filtroActual = 'TODOS'; // Para alumnos
  let filtroPagoActual = 'REVISION'; // NUEVO: Por defecto vemos los pendientes
  
  let textoBuscarPago = '';
  let textoBuscarAlumno = '';

  const esSuperAdmin = document.getElementById('adminContenido')?.dataset.superadmin === 'true';
  const FOTO_DEFAULT = 'https://images.unsplash.com/photo-1544717305-2782549b5136?w=200&auto=format&fit=crop&q=80';

  function escaparHTML(texto) {
    if (texto === null || texto === undefined) return '';
    return String(texto)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatearTelefonoWhatsApp(telefonoRaw) {
    let limpio = (telefonoRaw || '').replace(/\D/g, '');
    if (limpio.startsWith('0')) {
      limpio = '58' + limpio.slice(1);
    } else if (limpio.length === 10 && /^(412|414|424|416|426)/.test(limpio)) {
      limpio = '58' + limpio;
    }
    return limpio;
  }

  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const { data: tasaData } = await supabase.from('configuracion').select('valor, updated_at').eq('clave', 'tasa_dolar').single();
      
      if (tasaData) {
        tasaActualDolar = parseFloat(tasaData.valor);
        document.getElementById('inputTasa').value = tasaActualDolar;
        const fechaUpd = new Date(tasaData.updated_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', hour: '2-digit', minute:'2-digit' });
        document.getElementById('fechaTasa').textContent = `Act. ${fechaUpd}`;
      }

      document.getElementById('inputBuscarPago')?.addEventListener('input', (e) => {
        textoBuscarPago = e.target.value.trim().toLowerCase();
        renderizarPagos();
      });

      document.getElementById('inputBuscarAlumno')?.addEventListener('input', (e) => {
        textoBuscarAlumno = e.target.value.trim().toLowerCase();
        renderizarDirectorio();
      });

      await cargarDatosGlobales();
    } catch (err) {
      console.error("Error inicial:", err);
    }
  });

  async function cargarDatosGlobales() {
    const [{ data: alumnos }, { data: pagos }] = await Promise.all([
      // Añadimos "user_id," justo después de "id,"
      supabase.from('alumnos').select('id, user_id, nombre, cedula, telefono, email, nivel, estatus, foto_url, tipo_sangre, condicion_especial, direccion, fecha_nacimiento, tipos_bici').order('nombre', { ascending: true }),
      supabase.from('pagos').select('*').order('created_at', { ascending: false })
    ]);

    cacheAlumnos = alumnos || [];
    cachePagos = pagos || [];

    renderizarMetricas();
    renderizarPagos();
    renderizarDirectorio();
  }

  function renderizarMetricas() {
    const contenedor = document.getElementById('metricasDashboard');
    
    const alumnosActivos = cacheAlumnos.filter(a => (a.estatus || 'activo').toLowerCase() !== 'inactivo');
    const totalActivos = alumnosActivos.length;

    const activosProspecto = alumnosActivos.filter(a => (a.nivel || '').toUpperCase() === 'PROSPECTO').length;
    const activosAvanzado = alumnosActivos.filter(a => (a.nivel || '').toUpperCase() === 'AVANZADO').length;
    const activosIntermedio = alumnosActivos.filter(a => (a.nivel || '').toUpperCase() === 'INTERMEDIO').length;
    const activosPrincipiante = alumnosActivos.filter(a => (a.nivel || '').toUpperCase() === 'PRINCIPIANTE').length;
    const activosAdultos = alumnosActivos.filter(a => (a.nivel || '').toUpperCase() === 'ADULTOS').length;
    
    const fechaActual = new Date();
    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const mesActualStr = `${mesesNombres[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;
    
    const pagosMesAprobados = cachePagos.filter(p => p.mes_correspondiente === mesActualStr && p.estado === 'aprobado');
    const totalIngresos = pagosMesAprobados.reduce((sum, pago) => sum + Number(pago.monto || 0), 0);

    const pagosRevision = cachePagos.filter(p => p.estado === 'revision').length;

    contenedor.innerHTML = `
      <!-- 1. Matrícula Total -->
      <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex items-center justify-between">
        <div>
