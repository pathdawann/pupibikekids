  // Lógica de Tabs del Directorio
  window.filtrarDirectorio = function(filtro) {
    filtroActual = filtro;
    document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(`filtro-${filtro}`)?.classList.add('active');
    renderizarDirectorio();
  };

  function renderizarDirectorio() {
    const tbody = document.getElementById('tablaDirectorioAtletas');
    tbody.innerHTML = '';

    let lista = cacheAlumnos;

    if (filtroActual === 'INACTIVO') {
      lista = cacheAlumnos.filter(a => (a.estatus || 'activo').toLowerCase() === 'inactivo');
    } else if (filtroActual !== 'TODOS') {
      lista = cacheAlumnos.filter(a => (a.nivel || '').toUpperCase() === filtroActual && (a.estatus || 'activo').toLowerCase() !== 'inactivo');
    } else {
      lista = cacheAlumnos.filter(a => (a.estatus || 'activo').toLowerCase() !== 'inactivo');
    }

    if (textoBuscarAlumno) {
      lista = lista.filter(a => {
        const nombre = (a.nombre || '').toLowerCase();
        const cedula = (a.cedula || '').toLowerCase();
        const tel = (a.telefono || '').toLowerCase();
        const email = (a.email || '').toLowerCase();
        const cond = (a.condicion_especial || '').toLowerCase();
        return nombre.includes(textoBuscarAlumno) || 
               cedula.includes(textoBuscarAlumno) || 
               tel.includes(textoBuscarAlumno) || 
               email.includes(textoBuscarAlumno) ||
               cond.includes(textoBuscarAlumno);
      });
    }

    if (lista.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">No se encontraron atletas con ese criterio.</td></tr>`;
      return;
    }

    const fechaActual = new Date();
    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const mesActualStr = `${mesesNombres[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;

    lista.forEach(alumno => {
      const pagosAlumno = cachePagos.filter(p => p.alumno_id === alumno.id);
      const pagoMes = pagosAlumno.find(p => p.mes_correspondiente === mesActualStr);
      
      // Badges de solvencia estandarizados a text-sm y más anchos
      let badgeEstatusMes = '';
      if ((alumno.estatus || 'activo').toLowerCase() === 'inactivo') {
        badgeEstatusMes = `<span class="inline-flex items-center px-3 py-1 rounded-md text-sm font-bold bg-gray-100 text-gray-800">Retirado</span>`;
      } else if (pagoMes?.estado === 'aprobado') {
        badgeEstatusMes = `<span class="inline-flex items-center px-3 py-1 rounded-md text-sm font-bold bg-green-100 text-green-800">Al Día</span>`;
      } else if (pagoMes?.estado === 'revision') {
        badgeEstatusMes = `<span class="inline-flex items-center px-3 py-1 rounded-md text-sm font-bold bg-orange-100 text-orange-800">En Revisión</span>`;
      } else {
        if (fechaActual.getDate() > 5) {
          badgeEstatusMes = `<span class="inline-flex items-center px-3 py-1 rounded-md text-sm font-bold bg-red-100 text-red-800">Moroso</span>`;
        } else {
          badgeEstatusMes = `<span class="inline-flex items-center px-3 py-1 rounded-md text-sm font-bold bg-yellow-100 text-yellow-800">Pendiente</span>`;
        }
      }

      let colorNivel = 'text-gray-600 font-medium';
      const nivelUpper = (alumno.nivel || '').toUpperCase();
      if (nivelUpper === 'PROSPECTO') colorNivel = 'text-amber-600 font-bold';
      else if (nivelUpper === 'AVANZADO') colorNivel = 'text-blue-600 font-bold';
      else if (nivelUpper === 'INTERMEDIO') colorNivel = 'text-green-600 font-bold';
      else if (nivelUpper === 'ADULTOS') colorNivel = 'text-purple-600 font-bold';

      const condTexto = (alumno.condicion_especial || '').trim();
      const tieneCondicion = condTexto !== '' && condTexto.toUpperCase() !== 'NINGUNA';
      const badgeCondicionHtml = tieneCondicion
        ? `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 cursor-help" title="${escaparHTML(condTexto)}">💙 Apoyo</span>`
        : '';

      const telefonoLim = formatearTelefonoWhatsApp(alumno.telefono);
      const btnWp = telefonoLim
        ? `<a href="https://wa.me/${telefonoLim}" target="_blank" rel="noopener noreferrer" class="w-full md:w-auto flex justify-center items-center gap-2 px-4 py-2 md:p-0 bg-green-50 md:bg-transparent text-green-700 md:text-green-600 border border-green-200 md:border-transparent hover:text-green-800 rounded-md transition font-bold text-sm" title="Escribir por WhatsApp">
             <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 3.825 0 6.938 3.112 6.938 6.937 0 3.825-3.113 6.938-6.938 6.938z"/></svg>
             <span class="md:hidden">WhatsApp</span>
           </a>`
        : '';

      const idAlumnoSeguro = escaparHTML(alumno.id);
      const fotoSegura = alumno.foto_url ? escaparHTML(alumno.foto_url) : FOTO_DEFAULT;

      tbody.innerHTML += `
        <tr class="border-b border-gray-200 flex flex-col md:table-row p-6 md:p-0 gap-4 md:gap-0 hover:bg-gray-50 transition relative">
          <!-- Alumno -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle">
            <div class="flex items-center gap-3">
              <!-- Aumentamos el tamaño de la foto en escritorio a w-10 h-10 -->
              <div class="w-14 h-14 md:w-10 md:h-10 rounded-full bg-gray-200 overflow-hidden border border-gray-300 flex-shrink-0 shadow-sm">
                 <img src="${fotoSegura}" alt="${escaparHTML(alumno.nombre)}" class="w-full h-full object-cover" onerror="this.src='${FOTO_DEFAULT}'">
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-base font-black text-gray-900 uppercase leading-tight">${escaparHTML(alumno.nombre)}</span>
                  ${badgeCondicionHtml}
                </div>
                <div class="text-base text-gray-500 mt-0.5">${escaparHTML(alumno.cedula)}</div>
              </div>
            </div>
          </td>

          <!-- Contacto -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle">
             <div class="flex md:block items-start gap-3 mt-1 md:mt-0">
                <span class="text-sm font-bold text-gray-400 uppercase md:hidden w-20 pt-0.5">Contacto:</span>
                <div>
                  <div class="text-base text-gray-900 font-mono font-bold tracking-wide">${escaparHTML(alumno.telefono)}</div>
                  <div class="text-base text-gray-500 lowercase break-all mt-0.5">${escaparHTML(alumno.email)}</div>
                </div>
             </div>
          </td>

          <!-- Nivel -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle md:text-center">
             <div class="flex md:block items-center gap-3">
                <span class="text-sm font-bold text-gray-400 uppercase md:hidden w-20">Nivel:</span>
                <span class="text-sm ${colorNivel} uppercase bg-gray-50 md:bg-transparent px-2.5 py-1 md:p-0 rounded border border-gray-100 md:border-0 font-bold tracking-wide">${escaparHTML(alumno.nivel || 'N/A')}</span>
             </div>
