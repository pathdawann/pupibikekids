  function renderizarPagos() {
    const tbody = document.getElementById('tablaPagosPendientes');
    tbody.innerHTML = '';
    
    // 1. Actualizar el contador del badge naranja de pendientes
    const cantidadPendientes = cachePagos.filter(p => p.estado === 'revision').length;
    const badge = document.getElementById('badgePagosPendientes');
    if (badge) badge.textContent = cantidadPendientes;
    
    // 2. Aplicar filtro de pestaña (En Revisión, Aprobados, Todos)
    let pagosFiltrados = cachePagos;
    if (filtroPagoActual === 'REVISION') {
      pagosFiltrados = cachePagos.filter(p => p.estado === 'revision');
    } else if (filtroPagoActual === 'APROBADO') {
      pagosFiltrados = cachePagos.filter(p => p.estado === 'aprobado');
    }

    // 3. Aplicar filtro de buscador de texto (si existe)
    if (textoBuscarPago) {
      pagosFiltrados = pagosFiltrados.filter(p => {
        const atleta = cacheAlumnos.find(a => a.id === p.alumno_id);
        const nombre = (atleta?.nombre || '').toLowerCase();
        const cedula = (atleta?.cedula || '').toLowerCase();
        const ref = (p.referencia || '').toLowerCase();
        const mes = (p.mes_correspondiente || '').toLowerCase();
        const metodo = (p.metodo_pago || '').toLowerCase();

        return nombre.includes(textoBuscarPago) || 
               cedula.includes(textoBuscarPago) || 
               ref.includes(textoBuscarPago) || 
               mes.includes(textoBuscarPago) ||
               metodo.includes(textoBuscarPago);
      });
    }

    const pagosMostrados = pagosFiltrados.slice(0, 50);

    if (pagosMostrados.length === 0) {
      const msjVacío = filtroPagoActual === 'REVISION' 
        ? '¡Al día! No hay pagos pendientes por revisar.' 
        : 'No se encontraron pagos con ese criterio.';
      tbody.innerHTML = `<tr><td colspan="9" class="px-6 py-12 text-center text-sm font-medium text-gray-500">${msjVacío}</td></tr>`;
      return;
    }

    // (Aquí mantienes intacto el código de generación de HTML que ya tenías)
    // pagosMostrados.forEach(pago => { ... todo igual hasta el });

    pagosMostrados.forEach(pago => {
      const fecha = new Date(pago.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short' });
      const atleta = cacheAlumnos.find(a => a.id === pago.alumno_id);
      const nombreAtleta = atleta ? atleta.nombre : 'Atleta Eliminado';
      const cedulaAtleta = atleta ? atleta.cedula : 'N/A';

      // "Pendiente" y montos a text-base
      let stringBs = '<span class="text-gray-400 text-base font-medium">Pendiente</span>';
      if (pago.monto_bs && pago.tasa_historica) {
        stringBs = `<span class="font-bold text-gray-900 text-base">${Number(pago.monto_bs).toLocaleString('es-VE')} Bs</span> <br> <span class="text-sm text-gray-500">Tasa: ${escaparHTML(pago.tasa_historica)}</span>`;
      } else if (pago.estado === 'aprobado') {
        stringBs = '<span class="text-gray-400 text-base">No registrada</span>';
      }

      const idPagoSeguro = escaparHTML(pago.id);
      const montoSeguro = Number(pago.monto) || 0;
      const urlCapture = pago.comprobante_url ? escaparHTML(pago.comprobante_url) : '';

      // Botones y Badges uniformes a text-sm
      let badgeEstado = '';
      let btnAccion = '';

      if (pago.estado === 'aprobado') {
        badgeEstado = `<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">✓ Aprobado</span>`;
        btnAccion = `<button onclick="window.revertirPago('${idPagoSeguro}')" class="w-full md:w-auto inline-flex justify-center items-center gap-1 px-4 py-2 bg-white hover:bg-amber-50 text-gray-700 hover:text-amber-700 border border-gray-300 hover:border-amber-300 rounded-md text-sm font-bold shadow-sm transition">↩ Revertir</button>`;
      } else {
        badgeEstado = `<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-bold bg-amber-50 text-amber-700 border border-amber-200">⏳ Revisión</span>`;
        btnAccion = `<button onclick="window.aprobarPago('${idPagoSeguro}', ${montoSeguro})" class="w-full md:w-auto inline-flex justify-center items-center gap-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-bold shadow-sm transition">✓ Aprobar</button>`;
      }

      const btnEliminarPagoHtml = esSuperAdmin 
        ? `<button onclick="window.eliminarPago('${idPagoSeguro}')" class="w-full md:w-auto flex justify-center items-center gap-2 px-4 py-2 md:p-2 text-red-600 md:text-gray-400 bg-red-50 md:bg-transparent hover:text-red-600 hover:bg-red-50 rounded-md transition border border-red-200 md:border-transparent font-bold text-sm" title="Eliminar recibo">
             <span class="md:hidden">🗑️ Eliminar</span>
             <svg class="w-5 h-5 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
           </button>` 
        : '';

      tbody.innerHTML += `
        <tr class="border-b border-gray-200 flex flex-col md:table-row p-5 md:p-0 gap-3 md:gap-0 hover:bg-gray-50 transition relative">
          <!-- Fecha -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle">
            <div class="flex justify-between md:block items-center pb-2 md:pb-0 border-b border-gray-100 md:border-0">
              <span class="text-sm font-bold text-gray-400 uppercase md:hidden">Fecha Registro</span>
              <span class="text-gray-500 text-base font-medium">${escaparHTML(fecha)}</span>
            </div>
          </td>

          <!-- Atleta y Cédula (text-base) -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle">
            <div class="text-base font-black text-gray-900 uppercase leading-tight">${escaparHTML(nombreAtleta)}</div>
            <div class="text-base text-gray-500 mt-0.5">${escaparHTML(cedulaAtleta)}</div>
          </td>

          <!-- Referencia y Método (text-base) -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle">
            <div class="flex md:block items-start gap-3">
               <span class="text-sm font-bold text-gray-400 uppercase md:hidden w-16 pt-1">Pago:</span>
               <div>
                 <div class="text-base text-gray-900 font-mono font-bold tracking-wide">${escaparHTML(pago.referencia)}</div>
                 <div class="text-base text-gray-500 uppercase mt-0.5">${escaparHTML(pago.metodo_pago)}</div>
               </div>
            </div>
          </td>

          <!-- Montos (text-base) -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle text-left md:text-right">
             <div class="flex md:block items-center justify-between gap-3">
                <span class="text-sm font-bold text-gray-400 uppercase md:hidden">Monto USD:</span>
                <span class="text-base font-black text-gray-900">$${montoSeguro}</span>
             </div>
          </td>
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle text-left md:text-right">
             <div class="flex md:block items-start justify-between gap-3">
                <span class="text-sm font-bold text-gray-400 uppercase md:hidden pt-0.5">Monto Bs:</span>
                <div class="text-base leading-tight text-right">${stringBs}</div>
             </div>
          </td>

          <!-- Mes (text-base) y Capture -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle text-left md:text-center">
             <div class="flex md:block items-center justify-between gap-3">
                <span class="text-sm font-bold text-gray-400 uppercase md:hidden">Mes Pagado:</span>
                <span class="text-base text-gray-700 font-bold">${escaparHTML(pago.mes_correspondiente)}</span>
             </div>
          </td>
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle text-left md:text-center">
            <div class="flex md:block items-center justify-between gap-3">
                <span class="text-sm font-bold text-gray-400 uppercase md:hidden">Capture:</span>
                ${urlCapture ? `<a href="${urlCapture}" target="_blank" rel="noopener noreferrer" class="inline-block bg-blue-50 text-blue-600 border border-blue-200 px-4 py-1.5 md:px-3 md:py-1 rounded-md text-sm font-bold hover:bg-blue-100 transition shadow-sm">Ver Foto</a>` : '<span class="text-sm text-gray-400 italic">N/D</span>'}
            </div>
          </td>

          <!-- Estado y Acciones -->
          <td class="block md:table-cell px-0 py-0 md:px-6 md:py-4 md:align-middle text-left md:text-center">
             <div class="flex md:block items-center justify-between gap-3">
                <span class="text-sm font-bold text-gray-400 uppercase md:hidden">Estado:</span>
                ${badgeEstado}
             </div>
          </td>
          <td class="block md:table-cell px-0 pt-4 pb-0 md:px-6 md:py-4 md:align-middle text-center border-t border-gray-100 md:border-0 mt-1 md:mt-0">
            <div class="flex flex-col sm:flex-row items-center justify-between md:justify-center gap-2">
              ${btnAccion}
              ${btnEliminarPagoHtml}
            </div>
          </td>
        </tr>
