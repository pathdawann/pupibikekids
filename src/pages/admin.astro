      btn.disabled = false;
      pagoRevertirId = null;
    }
  });

  // Tasa del Dólar Guardar
  document.getElementById('formTasa').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnGuardarTasa');
    const nuevoValor = parseFloat(document.getElementById('inputTasa').value);
    const msg = document.getElementById('mensajeTasa');
    btn.disabled = true;

    try {
      const now = new Date();
      const { error } = await supabase
        .from('configuracion')
        .upsert({ clave: 'tasa_dolar', valor: String(nuevoValor), updated_at: now }, { onConflict: 'clave' });

      if (error) throw error;
      tasaActualDolar = nuevoValor;
      msg.textContent = "Tasa actualizada correctamente.";
      msg.className = "text-xs font-medium mt-3 text-center text-green-600 block";
      document.getElementById('fechaTasa').textContent = `Act. ${now.toLocaleDateString('es-ES', { hour: '2-digit', minute:'2-digit' })}`;
    } catch (err) {
      msg.textContent = "Error al conectar.";
      msg.className = "text-xs font-medium mt-3 text-center text-red-500 block";
    } finally {
      btn.disabled = false;
