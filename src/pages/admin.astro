  // --- LÓGICA DE APROBACIÓN CON TASA HISTÓRICA ---
  let pagoPendiente = null;
  const modalConfirmar = document.getElementById('modalConfirmarPago');
  
  window.aprobarPago = function(pagoId, montoUsd) {
    if(tasaActualDolar <= 0) {
      alert("¡ATENCIÓN! No has configurado la Tasa del Día. Por favor, actualiza la tasa arriba antes de aprobar pagos para que el cálculo en Bolívares sea correcto.");
      document.getElementById('inputTasa').focus();
      return;
    }
    
    pagoPendiente = { id: pagoId, usd: montoUsd };
    modalConfirmar.classList.remove('hidden');
  };

  document.getElementById('btnCancelarAprobacion').addEventListener('click', () => {
    pagoPendiente = null;
    modalConfirmar.classList.add('hidden');
  });

  document.getElementById('btnConfirmarAprobacion').addEventListener('click', async () => {
    if (!pagoPendiente) return;
    const btn = document.getElementById('btnConfirmarAprobacion');
    btn.textContent = 'Procesando...';
    btn.disabled = true;

    try {
      // 1. Calculamos el equivalente en Bs en este instante exacto
      const calculoBs = (pagoPendiente.usd * tasaActualDolar).toFixed(2);

      // 2. Guardamos estado, tasa histórica y monto bs en la base de datos
      const { error } = await supabase
        .from('pagos')
        .update({ 
          estado: 'aprobado',
          tasa_historica: tasaActualDolar,
          monto_bs: calculoBs
        })
        .eq('id', pagoPendiente.id);

      if (error) throw error;
      modalConfirmar.classList.add('hidden');

      await cargarDatosGlobales(); // Refresca UI
    } catch (err) {
      console.error(err);
      alert("Error al aprobar pago.");
    } finally {
      btn.textContent = 'Confirmar Aprobación';
      btn.disabled = false;
      pagoPendiente = null;
    }
  });

  // Revertir Pago
  let pagoRevertirId = null;
  const modalRevertir = document.getElementById('modalRevertirPago');
  
  window.revertirPago = function(pagoId) {
    pagoRevertirId = pagoId;
    modalRevertir.classList.remove('hidden');
  };

  document.getElementById('btnCancelarReversion').addEventListener('click', () => {
    pagoRevertirId = null;
    modalRevertir.classList.add('hidden');
  });

  document.getElementById('btnConfirmarReversion').addEventListener('click', async () => {
    if (!pagoRevertirId) return;
    const btn = document.getElementById('btnConfirmarReversion');
    btn.textContent = 'Revirtiendo...';
    btn.disabled = true;

    try {
      // Al revertir, borramos la tasa histórica para evitar cruces
      const { error } = await supabase
        .from('pagos')
        .update({ estado: 'revision', tasa_historica: null, monto_bs: null })
        .eq('id', pagoRevertirId);

      if (error) throw error;
      modalRevertir.classList.add('hidden');
      await cargarDatosGlobales();
    } catch (err) {
      console.error(err);
      alert("Error al revertir pago.");
