---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panel Administrativo | Pupi Bike Kids">
  <!-- Navegación del Panel Admin -->
  <nav class="bg-black text-white p-4 border-b-4 border-lime-400 sticky top-0 z-50">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/admin" class="text-2xl md:text-3xl font-black italic tracking-wider text-white transform -skew-x-6">
        PUPI BIKE <span class="text-lime-400">ADMIN</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/dashboard" class="text-cyan-400 font-bold hover:underline italic text-sm">Mi Panel de Atleta</a>
        <button id="btnAdminLogout" class="text-pink-500 font-bold hover:text-white transition italic uppercase text-sm border border-pink-500 px-3 py-1">
          Salir
        </button>
      </div>
    </div>
  </nav>

  <!-- Pantalla de Carga -->
  <div id="pantallaCargaAdmin" class="min-h-[80vh] flex flex-col items-center justify-center">
    <div class="w-16 h-16 border-4 border-lime-400 border-t-transparent rounded-full animate-spin mb-4"></div>
    <p class="text-lime-400 font-black italic uppercase tracking-widest animate-pulse">Cargando centro de control...</p>
  </div>

  <!-- Contenido Admin -->
  <main id="adminContenido" class="container mx-auto px-4 py-10 max-w-7xl hidden">
    
    <!-- Encabezado y Respaldo -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10 bg-zinc-900 p-6 border-2 border-lime-400 shadow-[6px_6px_0px_#a3e635]">
      <div>
        <h1 class="text-3xl font-black text-white uppercase italic tracking-wider">Centro de Control y <span class="text-lime-400">Academia</span></h1>
        <p class="text-zinc-400 text-sm mt-1">Aprobación de pagos, gestión por niveles y notificaciones directas.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <button id="btnCorreoMasivo" class="bg-lime-400 text-black font-black italic uppercase px-4 py-2 text-sm hover:bg-lime-300 shadow-[3px_3px_0px_rgba(0,0,0,0.5)]">
          ✉️ Correo Masivo (BCC)
        </button>
        <button id="btnExportarAlumnos" class="bg-cyan-400 text-black font-black italic uppercase px-4 py-2 text-sm hover:bg-cyan-300 shadow-[3px_3px_0px_rgba(0,0,0,0.5)]">
          📥 Descargar Alumnos (CSV)
        </button>
        <button id="btnExportarPagos" class="bg-pink-600 text-white font-black italic uppercase px-4 py-2 text-sm hover:bg-pink-500 shadow-[3px_3px_0px_rgba(0,0,0,0.5)]">
          📥 Descargar Pagos (CSV)
        </button>
      </div>
    </div>

    <!-- SECCIÓN: Tasa del Dólar y Seguridad -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <div class="bg-zinc-900 p-6 border-2 border-cyan-400 shadow-[6px_6px_0px_#00d2ff]">
        <h2 class="text-xl font-black italic uppercase text-cyan-400 mb-3">Tasa de Cambio del Día</h2>
        <form id="formTasa" class="flex flex-col gap-4">
          <div>
            <label class="block text-xs font-black uppercase text-zinc-400 mb-1">Valor Actual ($ a Bs)</label>
            <input type="text" id="inputTasa" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold text-lg" placeholder="36.50">
          </div>
          <button type="submit" id="btnGuardarTasa" class="bg-cyan-400 text-black font-black italic uppercase py-2 hover:bg-cyan-300">Actualizar Tasa</button>
        </form>
        <p id="mensajeTasa" class="text-xs font-bold mt-2 text-center hidden"></p>
      </div>

      <div class="md:col-span-2 bg-zinc-900 p-6 border-2 border-zinc-700 flex flex-col justify-center">
        <h3 class="text-lg font-black italic uppercase text-white mb-2">💡 Control Operativo</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">
          Desde esta sección puedes aprobar los recibos reportados. Al hacer clic en "Aprobar", el estado cambiará de inmediato para que el representante lo refleje como solvente en su panel personal. Además, puedes contactar a los atletas por WhatsApp con un solo clic.
        </p>
      </div>
    </div>

    <!-- SECCIÓN: Pagos Pendientes con Botón de Aprobar -->
    <div class="mb-12">
      <div class="bg-black inline-block px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_#db2777] mb-6">
        <h2 class="text-2xl font-black uppercase italic text-pink-500 tracking-wider">Últimos Pagos Reportados</h2>
      </div>
      
      <div class="overflow-x-auto bg-zinc-900 border-2 border-pink-500 shadow-[6px_6px_0px_#db2777]">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-zinc-950 text-pink-500 text-xs font-black uppercase tracking-wider border-b border-zinc-800">
              <th class="p-4">Fecha</th>
              <th class="p-4">Método</th>
              <th class="p-4">Referencia</th>
              <th class="p-4">Monto</th>
              <th class="p-4">Mes</th>
              <th class="p-4 text-center">Acción</th>
            </tr>
          </thead>
          <tbody id="tablaPagosPendientes" class="divide-y divide-zinc-800 text-sm font-medium">
            <!-- Inyectado por JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- SECCIÓN: Listado de Alumnos Agrupado por Niveles -->
    <div class="mb-12">
      <div class="bg-black inline-block px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_#a3e635] mb-6">
        <h2 class="text-2xl font-black uppercase italic text-lime-400 tracking-wider">Atletas Inscritos por Niveles</h2>
      </div>

      <div id="contenedorNiveles" class="flex flex-col gap-8">
        <!-- Las tablas por niveles se inyectarán dinámicamente aquí -->
      </div>
    </div>

  
<!-- MODAL CONFIRMAR PAGO -->
    <div id="modalConfirmarPago" class="fixed inset-0 bg-black/90 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-zinc-900 border-2 border-lime-400 shadow-[8px_8px_0px_#a3e635] p-6 md:p-8 w-full max-w-md mx-auto relative transform -skew-x-2 text-center">
        <h2 class="text-2xl font-black uppercase italic text-lime-400 mb-4 tracking-wider">Aprobar Pago</h2>
        <p class="text-zinc-300 font-medium mb-8">¿Estás seguro de aprobar este recibo? El atleta reflejará su solvencia de inmediato en su panel.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <button id="btnCancelarAprobacion" class="bg-zinc-800 text-white font-black italic uppercase px-6 py-3 hover:bg-zinc-700 transition shadow-[4px_4px_0px_rgba(0,0,0,0.5)] transform skew-x-2">
            Cancelar
          </button>
          <button id="btnConfirmarAprobacion" class="bg-lime-400 text-black font-black italic uppercase px-6 py-3 hover:bg-lime-300 transition shadow-[4px_4px_0px_#db2777] transform skew-x-2">
            Sí, Aprobar
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL DESHACER PAGO -->
    <div id="modalRevertirPago" class="fixed inset-0 bg-black/90 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
      <div class="bg-zinc-900 border-2 border-pink-500 shadow-[8px_8px_0px_#db2777] p-6 md:p-8 w-full max-w-md mx-auto relative transform -skew-x-2 text-center">
        <h2 class="text-2xl font-black uppercase italic text-pink-500 mb-4 tracking-wider">Deshacer Aprobación</h2>
        <p class="text-zinc-300 font-medium mb-8">¿Seguro que deseas devolver este pago a "Revisión"? El atleta volverá a ver su deuda pendiente.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <button id="btnCancelarReversion" class="bg-zinc-800 text-white font-black italic uppercase px-6 py-3 hover:bg-zinc-700 transition shadow-[4px_4px_0px_rgba(0,0,0,0.5)] transform skew-x-2">
            Cancelar
          </button>
          <button id="btnConfirmarReversion" class="bg-pink-600 text-white font-black italic uppercase px-6 py-3 hover:bg-pink-500 transition shadow-[4px_4px_0px_#db2777] transform skew-x-2">
            Sí, Deshacer
          </button>
        </div>
      </div>
    </div>

    </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', async () => {
    const pantallaCarga = document.getElementById('pantallaCargaAdmin');
    const adminContenido = document.getElementById('adminContenido');

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { window.location.href = '/login'; return; }

      // Restricción de Administrador (Coloca tu correo aquí)
      const correosAutorizados = ["pathdawann@gmail.com", "cesar@gmail.com"];
      if (!correosAutorizados.includes(session.user.email)) {
        alert("Acceso denegado.");
        window.location.href = '/dashboard';
        return;
      }

      // Cargar Tasa del Día
      const { data: tasaData } = await supabase.from('configuracion').select('valor').eq('clave', 'tasa_dolar').single();
      if (tasaData) document.getElementById('inputTasa').value = tasaData.valor;

      await cargarPagosPendientes();
      await cargarAlumnosPorNiveles();

      pantallaCarga.classList.add('hidden');
      adminContenido.classList.remove('hidden');

    } catch (err) {
      console.error(err);
      alert("Error al cargar el panel.");
      window.location.href = '/dashboard';
    }
  });

  // 1. Cargar Últimos Pagos (Pendientes y Aprobados)
  async function cargarPagosPendientes() {
    const tbody = document.getElementById('tablaPagosPendientes');
    tbody.innerHTML = '';

    const { data: pagos, error } = await supabase
      .from('pagos')
      .select('*')
      // Quitamos el filtro .eq('estado', 'revision') para poder ver también los aprobados
      .order('created_at', { ascending: false })
      .limit(30); // Mostramos los últimos 30 recibos para no saturar la pantalla

    if (error) { console.error(error); return; }

    if (!pagos || pagos.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-zinc-500 italic">No hay pagos registrados aún.</td></tr>`;
      return;
    }

    pagos.forEach(pago => {
      const fecha = new Date(pago.created_at).toLocaleDateString('es-ES');
      let accionHtml = '';

      // Si el pago está en revisión, mostramos el botón de APROBAR
      if (pago.estado === 'revision' || !pago.estado) {
        accionHtml = `
          <button onclick="aprobarPago('${pago.id}')" class="bg-lime-400 text-black font-black italic uppercase px-4 py-2 text-xs hover:bg-lime-300 shadow transform skew-x-2 transition">
            ✓ Aprobar
          </button>
        `;
      } 
      // Si ya está aprobado, mostramos la etiqueta de APROBADO
      else if (pago.estado === 'aprobado') {
        accionHtml = `
          <button onclick="revertirPago('${pago.id}')" class="bg-zinc-950 text-lime-400 font-black italic uppercase px-4 py-2 text-xs border border-lime-400 shadow transform skew-x-2 hover:bg-pink-600 hover:text-white hover:border-pink-500 transition group relative w-32" title="Clic para deshacer">
            <span class="group-hover:hidden">✓ Aprobado</span>
            <span class="hidden group-hover:inline">⟲ Deshacer</span>
          </button>
        `;
      }

      tbody.innerHTML += `
        <tr class="hover:bg-zinc-800/50">
          <td class="p-4 text-zinc-300">${fecha}</td>
          <td class="p-4 font-bold text-white">${pago.metodo_pago}</td>
          <td class="p-4 font-mono text-cyan-400">${pago.referencia}</td>
          <td class="p-4 font-black text-pink-500">${pago.monto}$</td>
          <td class="p-4 text-zinc-300">${pago.mes_correspondiente}</td>
          <td class="p-4 text-center">
            ${accionHtml}
          </td>
        </tr>
      `;
    });
  }

  // --- LÓGICA DEL MODAL DE APROBACIÓN DE PAGOS ---
  let pagoPendienteId = null;
  const modalConfirmar = document.getElementById('modalConfirmarPago');
  const btnConfirmar = document.getElementById('btnConfirmarAprobacion');
  const btnCancelar = document.getElementById('btnCancelarAprobacion');

  // Abre el modal en lugar de la alerta fea
  window.aprobarPago = function(pagoId) {
    pagoPendienteId = pagoId;
    modalConfirmar.classList.remove('hidden');
  };

  // --- LÓGICA DEL MODAL: DESHACER PAGO ---
  let pagoRevertirId = null;
  const modalRevertir = document.getElementById('modalRevertirPago');
  const btnConfReversion = document.getElementById('btnConfirmarReversion');
  const btnCancReversion = document.getElementById('btnCancelarReversion');

  window.revertirPago = function(pagoId) {
    pagoRevertirId = pagoId;
    modalRevertir.classList.remove('hidden');
  };

  btnCancReversion.addEventListener('click', () => {
    pagoRevertirId = null;
    modalRevertir.classList.add('hidden');
  });

  btnConfReversion.addEventListener('click', async () => {
    if (!pagoRevertirId) return;
    btnConfReversion.textContent = 'PROCESANDO...';
    btnConfReversion.disabled = true;

    try {
      const { error } = await supabase
        .from('pagos')
        .update({ estado: 'revision' })
        .eq('id', pagoRevertirId);

      if (error) throw error;
      
      modalRevertir.classList.add('hidden');
      await cargarPagosPendientes(); // Recarga la tabla de pagos
      await cargarAlumnosPorNiveles(); // Recarga la tabla de alumnos para actualizar los semáforos
      
    } catch (err) {
      console.error(err);
      alert("Error al revertir el pago.");
    } finally {
      btnConfReversion.textContent = 'SÍ, DESHACER';
      btnConfReversion.disabled = false;
      pagoRevertirId = null;
    }
  });

  // Botón Cancelar
  btnCancelar.addEventListener('click', () => {
    pagoPendienteId = null;
    modalConfirmar.classList.add('hidden');
  });

  // Botón Sí, Aprobar
  btnConfirmar.addEventListener('click', async () => {
    if (!pagoPendienteId) return;
    
    btnConfirmar.textContent = 'PROCESANDO...';
    btnConfirmar.disabled = true;

    try {
      const { error } = await supabase
        .from('pagos')
        .update({ estado: 'aprobado' })
        .eq('id', pagoPendienteId);

      if (error) throw error;
      
      modalConfirmar.classList.add('hidden');
      await cargarPagosPendientes(); // Recarga la tabla de inmediato
      
    } catch (err) {
      console.error(err);
      alert("Error al aprobar el pago. Revisa tu conexión.");
    } finally {
      btnConfirmar.textContent = 'SÍ, APROBAR';
      btnConfirmar.disabled = false;
      pagoPendienteId = null;
    }
  });

  // 2. Cargar Alumnos Agrupados por Niveles con Estatus Inteligente
  async function cargarAlumnosPorNiveles() {
    const contenedor = document.getElementById('contenedorNiveles');
    contenedor.innerHTML = '';

    // Obtener mes actual y día actual
    const fechaActual = new Date();
    const diaActual = fechaActual.getDate();
    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const mesActualStr = `${mesesNombres[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;

    // 1. Traer todos los alumnos
    const { data: alumnos, error: errorAlumnos } = await supabase
      .from('alumnos')
      .select('*')
      .order('nombre', { ascending: true });

    // 2. Traer todos los pagos del mes en curso
    const { data: pagosMes, error: errorPagos } = await supabase
      .from('pagos')
      .select('alumno_id, estado')
      .eq('mes_correspondiente', mesActualStr);

    if (errorAlumnos || errorPagos) { console.error("Error cargando data"); return; }

    if (!alumnos || alumnos.length === 0) {
      contenedor.innerHTML = `<p class="text-zinc-500 italic">No hay alumnos inscritos.</p>`;
      return;
    }

    // Crear mapa de pagos para búsqueda rápida (ej: pagosMap['id_alumno'] = 'aprobado')
    const pagosMap = {};
    if (pagosMes) {
      pagosMes.forEach(p => {
        if (p.estado === 'aprobado') pagosMap[p.alumno_id] = 'aprobado';
        else if (p.estado === 'revision' && pagosMap[p.alumno_id] !== 'aprobado') pagosMap[p.alumno_id] = 'revision';
      });
    }

    // Agrupar por nivel
    const nivelesMap = {};
    alumnos.forEach(alumno => {
      const niv = (alumno.nivel || 'SIN NIVEL').toUpperCase();
      if (!nivelesMap[niv]) nivelesMap[niv] = [];
      nivelesMap[niv].push(alumno);
    });

    // Renderizar una tabla por cada nivel
    for (const [nivel, lista] of Object.entries(nivelesMap)) {
      let filasHtml = '';
      lista.forEach(alumno => {
        const telefonoLim = (alumno.telefono || '').replace(/\s+/g, '');
        const estadoPago = pagosMap[alumno.id];
        
        let badgeHtml = '';
        let mensajeWp = '';

        // Lógica del semáforo de estatus
        if (estadoPago === 'aprobado') {
          badgeHtml = `<span class="bg-lime-400 text-black px-3 py-1 text-xs font-black uppercase">✓ AL DÍA</span>`;
          mensajeWp = encodeURIComponent(`¡Hola ${alumno.nombre}! Te escribimos de Pupi Bike Kids. ¡Gracias por estar al día! Te recordamos nuestros próximos eventos de la academia.`);
        } else if (estadoPago === 'revision') {
          badgeHtml = `<span class="bg-cyan-400 text-black px-3 py-1 text-xs font-black uppercase">⏳ REVISIÓN</span>`;
          mensajeWp = encodeURIComponent(`¡Hola ${alumno.nombre}! Recibimos tu comprobante de pago. Pronto lo validaremos en el sistema. ¡Gracias!`);
        } else {
          // No ha pagado: verificamos si ya pasó el día 5 de gracia
          if (diaActual > 5) {
            badgeHtml = `<span class="bg-pink-600 text-white px-3 py-1 text-xs font-black uppercase animate-pulse">⚠️ MOROSO</span>`;
            mensajeWp = encodeURIComponent(`¡Hola ${alumno.nombre}! Recordatorio amistoso de Pupi Bike Kids: El plazo de pago (del 1 al 5) para la mensualidad de ${mesActualStr} ha vencido. Por favor, reporta tu pago lo antes posible en tu panel para evitar recargos.`);
          } else {
            badgeHtml = `<span class="bg-yellow-400 text-black px-3 py-1 text-xs font-black uppercase">PENDIENTE</span>`;
            mensajeWp = encodeURIComponent(`¡Hola ${alumno.nombre}! Recuerda que estamos en los días de pago (del 1 al 5) para la mensualidad de ${mesActualStr}. ¡Evita recargos!`);
          }
        }

        filasHtml += `
          <tr class="hover:bg-zinc-800/50">
            <td class="p-4 font-bold text-white uppercase">${alumno.nombre}</td>
            <td class="p-4">${badgeHtml}</td>
            <td class="p-4 text-zinc-300 font-mono">${alumno.telefono}</td>
            <td class="p-4 text-zinc-400 text-xs">${alumno.email}</td>
            <td class="p-4 text-center">
              <a href="https://wa.me/${telefonoLim}?text=${mensajeWp}" target="_blank" class="inline-block bg-emerald-600 text-white font-black px-3 py-1.5 text-xs uppercase hover:bg-emerald-500 transition shadow">
                💬 WhatsApp
              </a>
            </td>
          </tr>
        `;
      });

      contenedor.innerHTML += `
        <div class="bg-zinc-900 border-2 border-cyan-400 shadow-[6px_6px_0px_#00d2ff] overflow-hidden">
          <div class="bg-black px-6 py-3 border-b border-zinc-800 flex justify-between items-center">
            <h3 class="text-xl font-black italic uppercase text-cyan-400">Nivel: ${nivel}</h3>
            <span class="bg-cyan-400 text-black font-black text-xs px-3 py-1 uppercase">${lista.length} Atletas</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-zinc-950 text-zinc-400 text-xs font-black uppercase tracking-wider border-b border-zinc-800">
                  <th class="p-4">Atleta</th>
                  <th class="p-4">Estatus del Mes</th>
                  <th class="p-4">Teléfono</th>
                  <th class="p-4">Correo</th>
                  <th class="p-4 text-center">Gestión</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800 text-sm font-medium">
                ${filasHtml}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }
  }

  // Actualizar Tasa del Dólar
  document.getElementById('formTasa').addEventListener('submit', async (e) => {
    e.preventDefault();
    const nuevoValor = document.getElementById('inputTasa').value;
    const msg = document.getElementById('mensajeTasa');

    try {
      const { error } = await supabase.from('configuracion').update({ valor: nuevoValor, updated_at: new Date() }).eq('clave', 'tasa_dolar');
      if (error) throw error;
      msg.textContent = "¡Tasa actualizada con éxito!";
      msg.className = "text-xs font-bold mt-2 text-center text-lime-400 block";
    } catch (err) {
      console.error(err);
      msg.textContent = "Error al actualizar la tasa.";
      msg.className = "text-xs font-bold mt-2 text-center text-pink-500 block";
    }
  });

// --- Función de Correo Masivo (BCC) ---
  const btnCorreoMasivo = document.getElementById('btnCorreoMasivo');
  if (btnCorreoMasivo) {
    btnCorreoMasivo.addEventListener('click', async () => {
      btnCorreoMasivo.textContent = 'Generando...';
      try {
        // Obtenemos solo los correos de la base de datos
        const { data, error } = await supabase.from('alumnos').select('email');
        if (error) throw error;
        
        // Filtramos para quitar espacios vacíos y los unimos con una coma
        const listaCorreos = data
          .map(alumno => alumno.email)
          .filter(email => email && email.trim() !== '')
          .join(',');

        if (listaCorreos.length === 0) {
          alert("Aún no hay correos registrados en la base de datos.");
          return;
        }

        const asunto = encodeURIComponent("Novedades y Eventos - Pupi Bike Kids");
        
        // Enlace directo y exclusivo a la interfaz web de Gmail
        const gmailLink = `https://mail.google.com/mail/?view=cm&fs=1&bcc=${listaCorreos}&su=${asunto}`;
        
        // Abrimos Gmail en una nueva pestaña
        window.open(gmailLink, '_blank');

      } catch (err) {
        console.error(err);
        alert("Error al intentar generar la lista de correos.");
      } finally {
        btnCorreoMasivo.textContent = '✉️ Correo Masivo (BCC)';
      }
    });
  }


  // Exportar CSV
  document.getElementById('btnExportarAlumnos').addEventListener('click', async () => {
    const { data } = await supabase.from('alumnos').select('*');
    exportarACSV(data, 'respaldo_alumnos_pupibike.csv');
  });

  document.getElementById('btnExportarPagos').addEventListener('click', async () => {
    const { data } = await supabase.from('pagos').select('*');
    exportarACSV(data, 'respaldo_pagos_pupibike.csv');
  });

  function exportarACSV(arr, filename) {
    if (!arr || !arr.length) { alert("No hay datos."); return; }
    const keys = Object.keys(arr[0]);
    const csvContent = "data:text/csv;charset=utf-8," + [keys.join(","), ...arr.map(row => keys.map(k => JSON.stringify(row[k] || "")).join(","))].join("\n");
    const link = document.createElement("a");
    link.setAttribute("href", encodeURI(csvContent));
    link.setAttribute("download", filename);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  document.getElementById('btnAdminLogout').addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });
</script>