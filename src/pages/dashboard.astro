---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Panel | Pupi Bike Kids" noindex={true}>
  <!-- Navegación Privada -->
  <nav class="bg-black text-white p-4 border-b-4 border-cyan-400 sticky top-0 z-50">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPIBIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <button id="btnLogout" class="text-pink-400 font-bold hover:text-white transition italic uppercase text-sm md:text-base border border-pink-500 px-4 py-1 hover:bg-pink-600 focus:outline-none focus:ring-2 focus:ring-pink-400">
        Cerrar Sesión
      </button>
    </div>
  </nav>

  <!-- Pantalla de Carga -->
  <div id="pantallaCarga" class="min-h-[80vh] flex flex-col items-center justify-center">
    <div class="w-16 h-16 border-4 border-cyan-400 border-t-transparent rounded-full animate-spin mb-4"></div>
    <p class="text-cyan-400 font-black italic uppercase tracking-widest animate-pulse">Cargando perfil...</p>
  </div>

  <!-- Contenido del Dashboard -->
  <main id="dashboardContenido" class="container mx-auto px-4 py-12 max-w-7xl relative hidden min-h-[80vh]">
    <div class="absolute top-0 right-0 w-80 h-80 bg-pink-600 rounded-full mix-blend-screen filter blur-[120px] opacity-10 pointer-events-none"></div>

    <!-- Encabezado de Bienvenida -->
    <div class="mb-10">
      <div class="bg-black inline-block px-8 py-2 transform -skew-x-6 shadow-[6px_6px_0px_#00d2ff] mb-4">
        <h1 class="text-3xl md:text-4xl font-black text-white uppercase italic tracking-wider">
          HOLA, <span id="uiNombre" class="text-cyan-400">ATLETA</span>
        </h1>
      </div>
      <p class="text-zinc-300 italic font-medium text-lg">Este es tu panel de control y autogestión de la academia.</p>
    </div>

    <!-- BLOQUE 1: Ficha Técnica (Izq) + Estado de Pagos y Pago Móvil (Der) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
      
      <!-- COLUMNA IZQUIERDA: Ficha del Atleta (7 de 12 columnas) -->
      <div class="lg:col-span-7">
        <section class="bg-zinc-900 p-8 shadow-[8px_8px_0px_#a3e635] border-2 border-lime-400 h-full flex flex-col justify-between">
          <div>
            <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-8 border-b border-zinc-700 pb-6">
              <div class="flex items-center gap-5">
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-cyan-400 overflow-hidden bg-zinc-950 flex-shrink-0 shadow-lg">
                  <img id="uiFoto" src="https://images.unsplash.com/photo-1544717305-2782549b5136?w=300&auto=format&fit=crop&q=80" alt="Foto Atleta" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?w=300&auto=format&fit=crop&q=80'" />
                </div>
                <div class="text-center sm:text-left">
                  <h2 class="text-2xl font-black italic uppercase text-lime-400">Ficha Técnica</h2>
                  <p id="uiNombreCompleto" class="text-white font-bold text-xl mt-1">...</p>
                  <p id="uiNivel" class="text-cyan-400 font-bold uppercase italic text-sm mt-1">...</p>
                </div>
              </div>

              <!-- Botones de Acción de Ficha y Contraseña -->
              <div class="flex flex-wrap sm:flex-col gap-2.5 flex-shrink-0 justify-center">
                <button type="button" id="btnAbrirModalEditar" class="bg-cyan-400 text-black font-black italic uppercase px-4 py-2.5 hover:bg-cyan-300 transition-all transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] text-xs tracking-wider focus:outline-none focus:ring-2 focus:ring-white">
                  ✏️ Editar Ficha
                </button>
                <button type="button" id="btnAbrirModalPassword" class="bg-zinc-950 text-pink-400 border border-pink-500 font-black italic uppercase px-4 py-2 hover:bg-pink-600 hover:text-white transition-all transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] text-xs tracking-wider focus:outline-none focus:ring-2 focus:ring-pink-400">
                  🔑 Cambiar Clave
                </button>
              </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div>
                <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-1">Cédula</p>
                <p id="uiCedula" class="text-white text-sm font-bold bg-zinc-950 px-4 py-2.5 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div>
                <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-1">Correo Electrónico</p>
                <p id="uiEmail" class="text-white text-sm font-bold bg-zinc-950 px-4 py-2.5 border border-zinc-800 transform -skew-x-2 lowercase truncate">...</p>
              </div>
              <div>
                <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-1">Fecha de Nacimiento</p>
                <p id="uiNacimiento" class="text-white text-sm font-bold bg-zinc-950 px-4 py-2.5 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div>
                <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-1">Teléfono / WhatsApp</p>
                <p id="uiTelefono" class="text-white text-sm font-bold bg-zinc-950 px-4 py-2.5 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div>
                <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-1">Tipo de Sangre</p>
                <p id="uiTipoSangre" class="text-pink-400 text-sm font-black bg-zinc-950 px-4 py-2.5 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div>
                <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-1">Condición / Observación en Pista</p>
                <p id="uiCondicionEspecial" class="text-cyan-400 text-sm font-bold bg-zinc-950 px-4 py-2.5 border border-zinc-800 transform -skew-x-2 truncate" title="">...</p>
              </div>
              <div class="md:col-span-2">
                <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-1">Dirección / Residencia</p>
                <p id="uiDireccion" class="text-white text-sm font-bold bg-zinc-950 px-4 py-2.5 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
            </div>
          </div>

          <div class="border-t border-zinc-700 pt-6">
            <h3 class="text-lime-400 font-black italic uppercase text-lg mb-4">Inventario de Bicicletas</h3>
            <div id="contenedorBicicletasVisual" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Se inyectarán dinámicamente -->
            </div>
          </div>
        </section>
      </div>

      <!-- COLUMNA DERECHA: Estado de Pagos y Pago Móvil Dinámico (5 de 12 columnas) -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        
        <!-- Estado de Pagos -->
        <section class="bg-zinc-900 p-6 shadow-[8px_8px_0px_#db2777] border-2 border-pink-500">
          <h2 class="text-xl font-black italic uppercase text-pink-500 mb-4 border-b border-zinc-700 pb-2 tracking-wide">Estado de Pagos</h2>
          
          <div class="bg-zinc-950 p-4 border border-zinc-800 mb-4 flex items-center justify-between">
            <div>
              <p class="text-zinc-300 text-xs font-black uppercase tracking-wider mb-0.5">Estatus del Mes</p>
              <p id="uiEstatus" class="text-xl font-black italic uppercase text-zinc-400">CARGANDO...</p>
            </div>
            <div id="uiIconoEstatus" class="w-11 h-11 bg-zinc-800 rounded-full flex items-center justify-center text-zinc-400 text-xl animate-pulse flex-shrink-0">?</div>
          </div>

          <button id="btnAbrirModalPago" class="w-full bg-pink-600 text-white font-black italic uppercase text-base py-3 hover:bg-pink-500 transition-all transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] hover:translate-y-0.5 mb-3 border-2 border-transparent focus:outline-none focus:ring-2 focus:ring-white tracking-wider">
            Reportar Pago
          </button>
          
          <a href="/historial" class="block text-center text-cyan-400 text-xs font-bold hover:text-white transition italic underline focus:outline-none focus:text-white">Ver historial completo</a>
        </section>

        <!-- TARJETA DINÁMICA: DATOS DE PAGO MÓVIL Y ARANCELES -->
        <section class="bg-zinc-900 p-6 shadow-[8px_8px_0px_#00d2ff] border-2 border-cyan-400 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4 border-b border-zinc-700 pb-3">
              <h2 class="text-xl font-black italic uppercase text-cyan-400 tracking-wide whitespace-nowrap">Datos Pago Móvil</h2>
              <div class="bg-zinc-950 text-lime-400 border border-lime-400 px-3 py-1 font-mono font-black text-xs whitespace-nowrap shadow">
                TASA BCV: <span id="uiTasaValor" class="text-white text-sm">--</span> Bs/$
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
              <!-- Inscripción -->
              <div class="bg-zinc-950 px-3 py-3 border border-zinc-800 text-center">
                <span class="text-[11px] text-zinc-300 font-black uppercase tracking-wider block mb-1">
                  Inscripción (30$)
                </span>
                <span id="uiTotalInscripcionBs" class="text-base xl:text-lg font-black italic text-cyan-400 tracking-tight block whitespace-nowrap">
                  Calculando...
                </span>
              </div>

              <!-- Mensualidad -->
              <div class="bg-zinc-950 px-3 py-3 border border-zinc-800 text-center">
                <span class="text-[11px] text-zinc-300 font-black uppercase tracking-wider block mb-1">
                  Mensualidad (70$)
                </span>
                <span id="uiTotalMensualidadBs" class="text-base xl:text-lg font-black italic text-lime-400 tracking-tight block whitespace-nowrap">
                  Calculando...
                </span>
              </div>
            </div>

            <!-- Datos bancarios con tamaño de fuente uniforme -->
            <div class="space-y-2.5 bg-zinc-950 p-4 border border-zinc-800 text-sm">
              <div class="flex justify-between items-center border-b border-zinc-800/80 pb-2">
                <span class="text-xs font-black uppercase text-zinc-400 tracking-wider">Banco:</span>
                <span class="text-white font-bold text-sm">Bco. de Venezuela (0102)</span>
              </div>
              <div class="flex justify-between items-center border-b border-zinc-800/80 pb-2">
                <span class="text-xs font-black uppercase text-zinc-400 tracking-wider">Teléfono:</span>
                <span class="text-cyan-400 font-mono font-bold text-sm tracking-wide">0424-8781128</span>
              </div>
              <div class="flex justify-between items-center border-b border-zinc-800/80 pb-2">
                <span class="text-xs font-black uppercase text-zinc-400 tracking-wider">Cédula:</span>
                <span class="text-white font-mono font-bold text-sm tracking-wide">V-24.469.073</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-xs font-black uppercase text-zinc-400 tracking-wider">Titular:</span>
                <span class="text-lime-400 font-bold uppercase text-sm">Cesar Barrios</span>
              </div>
            </div>
          </div>

          <p class="text-xs text-zinc-300 font-medium italic mt-4 text-center leading-relaxed">
            Luego de transferir, haz clic en <strong class="text-pink-400 uppercase">"Reportar Pago"</strong> arriba para registrar el comprobante.
          </p>
        </section>

      </div>
    </div>

   <!-- BLOQUE HORARIO SEMANAL DE CLASES (Planificación Detallada 7 Días) -->
    <section class="bg-zinc-900 p-6 md:p-8 shadow-[8px_8px_0px_#db2777] border-2 border-pink-500 mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 border-b border-zinc-800 pb-4">
        <div>
          <h2 class="text-2xl font-black italic uppercase text-pink-500 tracking-wide">Planificación de la Semana</h2>
          <p class="text-zinc-300 text-xs italic mt-0.5">Cronograma de rutas, enfoques técnicos y locaciones.</p>
        </div>
        <span class="bg-zinc-950 border border-pink-500 text-pink-400 text-xs font-black uppercase italic px-3 py-1.5 self-start sm:self-auto transform -skew-x-6 shadow-[3px_3px_0px_#db2777]">
          ⚡ Puntualidad en Pista
        </span>
      </div>

      <!-- Contenedor inyectado desde JavaScript -->
      <div id="contenedorCalendarioSemanal" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <p class="text-zinc-500 italic text-sm">Cargando planificación...</p>
      </div>
    </section> 

    <!-- BLOQUE 2: MAILLOT OFICIAL (Izq) + CALENDARIO DE ACTIVIDADES EN VERTICAL (Der) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      
      <!-- 1. Card de Merch / Maillot Oficial -->
      <section class="bg-zinc-900 p-8 shadow-[8px_8px_0px_#a3e635] border-2 border-lime-400 flex flex-col justify-between group">
        <div>
          <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
            <div>
              <h3 class="text-2xl font-black italic uppercase text-lime-400">Maillot Oficial</h3>
              <p class="text-zinc-300 text-xs">Viste los colores extremos de Pupi Bike Kids.</p>
            </div>
            <span class="bg-lime-400 text-black font-black italic px-3 py-1 text-sm uppercase transform -skew-x-6">Edición Pro 2026</span>
          </div>
          
          <div class="bg-zinc-950 p-4 border border-zinc-800 mb-6 rounded-xl overflow-hidden flex justify-center items-center h-80 shadow-inner">
            <img src="/maillot.png" alt="Maillot Oficial" loading="lazy" decoding="async" class="w-full h-full object-contain transform group-hover:scale-105 transition-transform duration-300" />
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-zinc-950 p-4 border border-zinc-800">
          <div>
            <span class="text-zinc-300 text-xs uppercase font-bold block">Precio de lanzamiento:</span>
            <span class="text-2xl font-black italic text-lime-400">35$ <span class="text-xs text-white font-normal">(Todas las tallas)</span></span>
          </div>
          <a href="https://wa.me/584248781128?text=Hola%20Cesar,%20quiero%20comprar%20el%20maillot%20oficial%20de%20la%20academia." target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto text-center bg-lime-400 text-black font-black italic uppercase px-8 py-3 hover:bg-lime-300 transition-all shadow-[4px_4px_0px_#db2777] transform -skew-x-4 focus:outline-none focus:ring-2 focus:ring-white">
            Comprar Ahora
          </a>
        </div>
      </section>

      <!-- 2. Calendario de Actividades en Lista Vertical -->
      <section class="bg-zinc-900 p-8 shadow-[8px_8px_0px_#00d2ff] border-2 border-cyan-400 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6 border-b border-zinc-800 pb-3">
            <h3 class="text-2xl font-black italic uppercase text-cyan-400 tracking-wide">Calendario del Mes</h3>
            <span class="text-zinc-300 text-xs font-bold uppercase italic">Próximos Eventos</span>
          </div>

          <div class="flex flex-col gap-4">
            <div class="bg-zinc-950 p-4 border-l-4 border-green-500 shadow flex items-center gap-4 hover:translate-x-1 transition-transform">
              <div class="bg-green-500 text-black font-black text-center px-3 py-2 flex flex-col justify-center min-w-[65px] transform -skew-x-3">
                <span class="text-xs leading-none">OCT</span>
                <span class="text-xl leading-none">17</span>
              </div>
              <div class="flex-1">
                <h4 class="text-base font-bold text-white uppercase italic">Cambibara Race</h4>
                <p class="text-zinc-300 text-xs">Campeonato Bike Balance y Eliminator con obstáculos. Sector Óvalo.</p>
              </div>
            </div>

            <div class="bg-zinc-950 p-4 border-l-4 border-pink-500 shadow flex items-center gap-4 hover:translate-x-1 transition-transform">
              <div class="bg-pink-500 text-white font-black text-center px-3 py-2 flex flex-col justify-center min-w-[65px] transform -skew-x-3">
                <span class="text-xs leading-none">OCT</span>
                <span class="text-xl leading-none">22</span>
              </div>
              <div class="flex-1">
                <h4 class="text-base font-bold text-white uppercase italic">Clínica de Saltos</h4>
                <p class="text-zinc-300 text-xs">Técnicas de despegue y aterrizaje en pista para intermedio y avanzado.</p>
              </div>
            </div>

            <div class="bg-zinc-950 p-4 border-l-4 border-lime-400 shadow flex items-center gap-4 hover:translate-x-1 transition-transform">
              <div class="bg-lime-400 text-black font-black text-center px-3 py-2 flex flex-col justify-center min-w-[65px] transform -skew-x-3">
                <span class="text-xs leading-none">OCT</span>
                <span class="text-xl leading-none">30</span>
              </div>
              <div class="flex-1">
                <h4 class="text-base font-bold text-white uppercase italic">Competencia Halloween</h4>
                <p class="text-zinc-300 text-xs">Ven con tu mejor disfraz a rodar. Premios sorpresa para los atletas.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-zinc-800 text-center">
          <p class="text-xs text-zinc-400 italic">¿Tienes dudas sobre los eventos? Consulta a los entrenadores en pista.</p>
        </div>
      </section>

    </div>
  </main>

  <!-- MODAL RECORDATORIO DE PAGO (SOLO AL HACER CLIC EN REPORTAR PAGO) -->
  <div id="modalRecordatorioDeuda" class="fixed inset-0 bg-black/90 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
    <div class="bg-zinc-900 border-2 border-pink-500 shadow-[8px_8px_0px_#db2777] p-8 w-full max-w-md mx-auto relative transform -skew-x-2 text-center">
      <button type="button" id="btnCerrarRecordatorio" aria-label="Cerrar recordatorio" class="absolute top-3 right-4 text-zinc-400 hover:text-pink-500 transform skew-x-2 text-2xl font-black z-10 focus:outline-none focus:text-white">X</button>
      <div class="transform skew-x-2">
        <div class="text-pink-500 text-5xl mb-3">📅</div>
        <h2 class="text-2xl font-black uppercase italic text-pink-500 mb-3 tracking-wider">Recordatorio de Pago</h2>
        <p class="text-zinc-200 font-medium mb-6 text-sm leading-relaxed">
          ¡Hola! Te recordamos que los días regulares de pago son del <span class="text-white font-black">1 al 5 de cada mes</span>.
        </p>
        <button type="button" id="btnIrAPagarDeuda" class="w-full bg-pink-600 text-white font-black italic uppercase text-base py-3.5 hover:bg-pink-500 transition-all shadow-[4px_4px_0px_rgba(0,0,0,0.5)] border-2 border-transparent focus:outline-none focus:ring-2 focus:ring-white">
          Continuar al Reporte →
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL REPORTAR PAGO (CON COMPROBANTE / CAPTURE) -->
  <div id="modalPago" class="fixed inset-0 bg-black/90 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-2 md:p-4">
    <div class="modal-scroll bg-zinc-900 border-2 border-pink-500 shadow-[8px_8px_0px_#db2777] p-5 md:p-8 w-full max-w-md mx-auto relative transform md:-skew-x-2 max-h-[95vh] overflow-y-auto">
      <button type="button" id="btnCerrarModal" aria-label="Cerrar modal" class="absolute top-3 right-4 text-zinc-400 hover:text-pink-500 transform md:skew-x-2 text-2xl font-black z-10 focus:outline-none focus:text-white">X</button>
      
      <div class="transform md:skew-x-2">
        <h2 class="text-2xl font-black uppercase italic text-pink-500 mb-5 border-b border-zinc-800 pb-2">Reportar Transferencia</h2>
        <form id="formPago" class="flex flex-col gap-4">
          <div>
            <label for="inputConcepto" class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Concepto del Pago</label>
            <select id="inputConcepto" required class="w-full px-4 py-2.5 bg-zinc-950 border border-zinc-700 text-lime-400 font-bold text-sm focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
              <option value="Mensualidad">Mensualidad (70$)</option>
              <option value="Inscripcion">Inscripción (30$)</option>
              <option value="Inscripcion + Mensualidad">Inscripción + Mensualidad (100$)</option>
              <option value="Abono">Abono / Otro Monto</option>
            </select>
          </div>

          <div>
            <label for="inputMetodo" class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Método de Pago</label>
            <select id="inputMetodo" required class="w-full px-4 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold text-sm focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
              <option value="Pago Movil">Pago Móvil</option>
              <option value="Transferencia Banesco">Transferencia Banesco</option>
              <option value="Zelle">Zelle</option>
              <option value="Efectivo">Efectivo en Pista</option>
            </select>
          </div>

          <div>
            <label for="inputReferencia" class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Número de Referencia</label>
            <input type="text" id="inputReferencia" required placeholder="Ej: 12345678" class="w-full px-4 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold text-sm placeholder-zinc-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="inputMonto" class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Monto ($)</label>
              <input type="number" id="inputMonto" required value="70" min="1" step="0.01" class="w-full px-4 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold text-sm placeholder-zinc-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
            </div>
            <div>
              <label for="inputMes" class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Mes que Cancela</label>
