---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navegación Privada -->
  <nav class="bg-black text-white p-4 border-b-4 border-cyan-400 sticky top-0 z-50">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPI BIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <button id="btnLogout" class="text-pink-500 font-bold hover:text-white transition italic uppercase text-sm md:text-base border border-pink-500 px-4 py-1 hover:bg-pink-600">
        Cerrar Sesión
      </button>
    </div>
  </nav>

  <!-- Pantalla de Carga -->
  <div id="pantallaCarga" class="min-h-[80vh] flex flex-col items-center justify-center">
    <div class="w-16 h-16 border-4 border-cyan-400 border-t-transparent rounded-full animate-spin mb-4"></div>
    <p class="text-cyan-400 font-black italic uppercase tracking-widest animate-pulse">Cargando perfil...</p>
  </div>

  <!-- Contenido del Dashboard -->
  <main id="dashboardContenido" class="container mx-auto px-4 py-12 max-w-6xl relative hidden min-h-[80vh]">
    <div class="absolute top-0 right-0 w-80 h-80 bg-pink-600 rounded-full mix-blend-screen filter blur-[120px] opacity-10 pointer-events-none"></div>

    <!-- Encabezado de Bienvenida -->
    <div class="mb-10">
      <div class="bg-black inline-block px-8 py-2 transform -skew-x-6 shadow-[6px_6px_0px_#00d2ff] mb-4">
        <h1 class="text-3xl md:text-4xl font-black text-white uppercase italic tracking-wider">
          HOLA, <span id="uiNombre" class="text-cyan-400">ATLETA</span>
        </h1>
      </div>
      <p class="text-zinc-400 italic font-medium text-lg">Este es tu panel de control y autogestión de la academia.</p>
    </div>

    <!-- SECCIÓN SUPERIOR: Ficha Técnica + Estado de Pagos / Merch -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mb-16">
      
      <!-- COLUMNA 1: Ficha del Atleta -->
      <div class="lg:col-span-2 flex flex-col gap-8">
        <section class="bg-zinc-900 p-8 shadow-[8px_8px_0px_#a3e635] border-2 border-lime-400 relative">
          
          <!-- Foto, Título y Botón de Editar Atractivo Arriba -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-8 border-b border-zinc-700 pb-6">
            <div class="flex items-center gap-6">
              <div class="w-28 h-28 rounded-full border-4 border-cyan-400 overflow-hidden bg-zinc-950 flex-shrink-0 shadow-lg">
                <img id="uiFoto" src="" alt="Foto Atleta" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?w=300&auto=format&fit=crop&q=80'" />
              </div>
              <div class="text-center sm:text-left">
                <h2 class="text-2xl font-black italic uppercase text-lime-400">Ficha Técnica</h2>
                <p id="uiNombreCompleto" class="text-white font-bold text-xl mt-1">...</p>
                <p id="uiNivel" class="text-cyan-400 font-bold uppercase italic text-sm mt-1">...</p>
              </div>
            </div>

            <!-- BOTÓN EDITAR FICHA -->
            <button type="button" id="btnAbrirModalEditar" class="bg-cyan-400 text-black font-black italic uppercase px-5 py-3 hover:bg-cyan-300 transition-all transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] border-2 border-transparent text-sm flex-shrink-0">
              ✏️ Editar Ficha
            </button>
          </div>
          
          <!-- Datos Personales -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div>
              <p class="text-zinc-500 text-xs font-black uppercase tracking-wider mb-1">Cédula (Atleta / Representante)</p>
              <p id="uiCedula" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
            </div>
            <div>
              <p class="text-zinc-500 text-xs font-black uppercase tracking-wider mb-1">Correo Electrónico</p>
              <p id="uiEmail" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2 lowercase">...</p>
            </div>
            <div>
              <p class="text-zinc-500 text-xs font-black uppercase tracking-wider mb-1">Fecha de Nacimiento</p>
              <p id="uiNacimiento" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
            </div>
            <div>
              <p class="text-zinc-500 text-xs font-black uppercase tracking-wider mb-1">Teléfono / WhatsApp</p>
              <p id="uiTelefono" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
            </div>
            <div class="md:col-span-2">
              <p class="text-zinc-500 text-xs font-black uppercase tracking-wider mb-1">Dirección / Residencia</p>
              <p id="uiDireccion" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
            </div>
          </div>

          <!-- Inventario de Bicicletas -->
          <div class="border-t border-zinc-700 pt-6">
            <h3 class="text-lime-400 font-black italic uppercase text-lg mb-4">Inventario de Bicicletas</h3>
            <div id="contenedorBicicletasVisual" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Se inyectarán dinámicamente -->
            </div>
          </div>
        </section>
      </div>

      <!-- COLUMNA 2: Finanzas + Merch Oficial -->
      <div class="flex flex-col gap-8">
        
        <!-- Estado de Pagos -->
        <section class="bg-zinc-900 p-6 shadow-[8px_8px_0px_#db2777] border-2 border-pink-500">
          <h2 class="text-xl font-black italic uppercase text-pink-500 mb-4 border-b border-zinc-700 pb-2">Estado de Pagos</h2>
          
          <div class="bg-zinc-950 p-4 border border-zinc-800 mb-4 flex items-center justify-between">
            <div>
              <p class="text-zinc-400 text-xs font-bold uppercase tracking-wider">Estatus del Mes</p>
              <p id="uiEstatus" class="text-xl font-black italic uppercase text-zinc-500">CARGANDO...</p>
            </div>
            <div id="uiIconoEstatus" class="w-12 h-12 bg-zinc-800 rounded-full flex items-center justify-center text-zinc-500 text-2xl animate-pulse">?</div>
          </div>

          <button id="btnAbrirModalPago" class="w-full bg-pink-600 text-white font-black italic uppercase text-lg py-3 hover:bg-pink-500 transition-all transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] hover:translate-y-1 mb-3 border-2 border-transparent">
            Reportar Pago
          </button>
          
          <a href="/historial" class="block text-center text-cyan-400 text-sm font-bold hover:text-white transition italic underline">Ver historial completo</a>
        </section>

        <!-- Card de Merch / Maillot Oficial -->
        <section class="bg-zinc-900 p-6 shadow-[8px_8px_0px_#00d2ff] border-2 border-cyan-400 relative overflow-hidden group">
          <h3 class="text-xl font-black italic uppercase text-cyan-400 mb-2">Maillot Oficial</h3>
          <p class="text-zinc-400 text-xs mb-4">Viste los colores extremos de Pupi Bike Kids.</p>
          
          <!-- Imagen del Maillot Local -->
          <div class="bg-zinc-950 p-2 border border-zinc-800 mb-4 rounded overflow-hidden flex justify-center items-center h-40">
            <img src="/maillot.webp" alt="Maillot Oficial" class="h-full object-cover transform group-hover:scale-105 transition-transform duration-300" />
          </div>

          <div class="bg-zinc-950 p-3 border border-zinc-800 mb-4 text-center">
            <span class="text-white font-black italic text-lg">Edición Pro 2026</span>
            <p class="text-lime-400 font-bold text-sm">35$ (Todas las tallas)</p>
          </div>

          <a href="https://wa.me/584248781128?text=Hola,%20quiero%20comprar%20el%20maillot%20oficial%20de%20la%20academia" target="_blank" class="block text-center bg-cyan-400 text-black font-black italic uppercase py-3 hover:bg-cyan-300 transition-all shadow-[4px_4px_0px_rgba(0,0,0,0.5)] transform -skew-x-4">
            Comprar Ahora
          </a>
        </section>

      </div>
    </div>

    <!-- SECCIÓN INFERIOR: Calendario de Actividades -->
    <section class="bg-zinc-900 p-8 border-t-4 border-lime-400 shadow-xl relative">
      <div class="text-center mb-10">
        <div class="bg-black inline-block px-8 py-2 transform -skew-x-6 shadow-[6px_6px_0px_#a3e635] border border-zinc-800">
          <h2 class="text-2xl md:text-3xl font-black uppercase italic text-white tracking-wider">Calendario de <span class="text-lime-400">Actividades</span></h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-zinc-950 p-5 border-l-4 border-cyan-400 shadow-lg">
          <div class="text-cyan-400 font-black text-xl mb-1">15 OCT</div>
          <h3 class="text-base font-bold text-white mb-2 uppercase italic">Ruta Nocturna Familiar</h3>
        </div>
        <div class="bg-zinc-950 p-5 border-l-4 border-pink-500 shadow-lg">
          <div class="text-pink-500 font-black text-xl mb-1">22 OCT</div>
          <h3 class="text-base font-bold text-white mb-2 uppercase italic">Clínica de Saltos</h3>
        </div>
        <div class="bg-zinc-950 p-5 border-l-4 border-lime-400 shadow-lg">
          <div class="text-lime-400 font-black text-xl mb-1">30 OCT</div>
          <h3 class="text-base font-bold text-white mb-2 uppercase italic">Competencia Halloween</h3>
        </div>
      </div>
    </section>
  </main>

  <!-- MODAL REPORTAR PAGO -->
  <div id="modalPago" class="fixed inset-0 bg-black/80 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
    <div class="bg-zinc-900 border-2 border-pink-500 shadow-[8px_8px_0px_#db2777] p-6 md:p-8 w-full max-w-md mx-auto relative transform -skew-x-2">
      <button type="button" id="btnCerrarModal" class="absolute top-3 right-4 text-zinc-500 hover:text-pink-500 transform skew-x-2 text-2xl font-black">X</button>
      
      <div class="transform skew-x-2">
        <h2 class="text-2xl font-black uppercase italic text-pink-500 mb-6 border-b border-zinc-800 pb-2">Reportar Transferencia</h2>
        <form id="formPago" class="flex flex-col gap-4">
          <div>
            <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Método de Pago</label>
            <select id="inputMetodo" required class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold">
              <option value="Pago Movil">Pago Móvil</option>
              <option value="Transferencia Banesco">Transferencia Banesco</option>
              <option value="Zelle">Zelle</option>
              <option value="Efectivo">Efectivo en Pista</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Número de Referencia</label>
            <input type="text" id="inputReferencia" required placeholder="Ej: 12345678" class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold">
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Monto ($)</label>
              <input type="number" id="inputMonto" required placeholder="30" min="1" class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold">
            </div>
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Mes que Cancela</label>
              <select id="inputMes" required class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold">
                <option value="Octubre 2026">Octubre 2026</option>
                <option value="Noviembre 2026">Noviembre 2026</option>
                <option value="Diciembre 2026">Diciembre 2026</option>
              </select>
            </div>
          </div>
          <input type="hidden" id="inputAlumnoId" value="">
          <div id="mensajePago" class="hidden text-sm font-bold uppercase italic text-center p-2 border mt-2"></div>
          <button type="submit" id="btnEnviarPago" class="w-full bg-pink-600 text-white font-black italic uppercase text-lg py-3 hover:bg-pink-500 transition-all mt-2">Enviar Reporte</button>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL EDITAR FICHA -->
  <div id="modalEditar" class="fixed inset-0 bg-black/80 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
    <div class="bg-zinc-900 border-2 border-lime-400 shadow-[8px_8px_0px_#a3e635] p-6 md:p-8 w-full max-w-3xl mx-auto relative transform -skew-x-2 max-h-[90vh] overflow-y-auto">
      <button type="button" id="btnCerrarModalEditar" class="absolute top-3 right-4 text-zinc-500 hover:text-lime-400 transform skew-x-2 text-2xl font-black">X</button>
      
      <div class="transform skew-x-2">
        <h2 class="text-2xl font-black uppercase italic text-lime-400 mb-6 border-b border-zinc-800 pb-2">Actualizar Ficha del Atleta</h2>
        
        <form id="formEditar" class="flex flex-col gap-6">
          
          <!-- Datos Personales -->
          <div>
            <h3 class="text-cyan-400 font-black italic uppercase text-sm mb-3">1. Datos Personales</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Nombre y Apellido</label>
                <input type="text" id="editNombre" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Cédula (Atleta / Representante)</label>
                <input type="text" id="editCedula" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Fecha de Nacimiento</label>
                <input type="date" id="editNacimiento" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Correo Electrónico</label>
                <input type="email" id="editEmail" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold lowercase">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Teléfono / WhatsApp</label>
                <input type="text" id="editTelefono" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Nivel Actual</label>
                <select id="editNivel" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase">
                  <option value="PRINCIPIANTE">PRINCIPIANTE</option>
                  <option value="INTERMEDIO">INTERMEDIO</option>
                  <option value="AVANZADO">AVANZADO</option>
                </select>
              </div>
              <div class="md:col-span-2">
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Dirección / Residencia</label>
                <input type="text" id="editDireccion" placeholder="Ciudad, Urbanización, Calle..." required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase">
              </div>
              <div class="md:col-span-2">
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">URL de la Foto</label>
                <input type="url" id="editFoto" class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold">
              </div>
            </div>
          </div>

          <!-- Inventario de Bicicletas -->
          <div class="border-t border-zinc-800 pt-4">
            <h3 class="text-cyan-400 font-black italic uppercase text-sm mb-3">2. Inventario de Bicicletas</h3>
            
            <div class="space-y-4">
              <!-- Bici 1 -->
              <div class="bg-zinc-950 p-4 border border-zinc-800">
                <span class="text-lime-400 font-black text-xs uppercase italic mb-2 block">Bicicleta 1 (Principal)</span>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Tipo</label>
                    <select id="editBici1Tipo" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold">
                      <option value="MTB">MTB</option>
                      <option value="RUTA">RUTA</option>
                      <option value="GRAVEL">GRAVEL</option>
                      <option value="BALANCE">BALANCE</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Rin</label>
                    <input type="text" id="editBici1Rin" placeholder="Ej: 29" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase">
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Marca</label>
                    <input type="text" id="editBici1Marca" placeholder="Ej: Giant" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase">
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Color</label>
                    <input type="text" id="editBici1Color" placeholder="Ej: Verde" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase">
                  </div>
                </div>
              </div>

              <!-- Bici 2 -->
              <div class="bg-zinc-950 p-4 border border-zinc-800">
                <span class="text-cyan-400 font-black text-xs uppercase italic mb-2 block">Bicicleta 2 (Opcional)</span>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Tipo</label>
                    <select id="editBici2Tipo" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold">
                      <option value="">-- Ninguna --</option>
                      <option value="MTB">MTB</option>
                      <option value="RUTA">RUTA</option>
                      <option value="GRAVEL">GRAVEL</option>
                      <option value="BALANCE">BALANCE</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Rin</label>
                    <input type="text" id="editBici2Rin" placeholder="Ej: 20" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase">
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Marca</label>
                    <input type="text" id="editBici2Marca" placeholder="Ej: Trek" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase">
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-400 mb-1">Color</label>
                    <input type="text" id="editBici2Color" placeholder="Ej: Negro" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div id="mensajeEditar" class="hidden text-sm font-bold uppercase italic text-center p-2 border mt-2"></div>
          <button type="submit" id="btnGuardarEdicion" class="w-full bg-lime-400 text-black font-black italic uppercase text-lg py-3 hover:bg-lime-300 transition-all mt-2 shadow-[4px_4px_0px_rgba(0,0,0,0.5)]">Guardar Cambios</button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', async () => {
    const pantallaCarga = document.getElementById('pantallaCarga');
    const dashboardContenido = document.getElementById('dashboardContenido');

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { window.location.href = '/login'; return; }

      const user = session.user;
      const { data: alumno, error } = await supabase
        .from('alumnos')
        .select('*')
        .eq('user_id', user.id)
        .single();

      if (error) throw error;
      if (!alumno) throw new Error("No se encontró la ficha del alumno.");

      // Variables globales para el modal
      window.currentCedula = alumno.cedula || '';
      window.currentEmail = alumno.email || user.email;
      window.currentDireccion = alumno.direccion || '';
      window.currentNacimientoRaw = alumno.fecha_nacimiento || '';
      window.currentBicicletas = alumno.tipos_bici || [];

      // Pintar datos personales
      document.getElementById('uiNombre').textContent = alumno.nombre.split(' ')[0];
      document.getElementById('uiNombreCompleto').textContent = alumno.nombre;
      document.getElementById('uiNivel').textContent = alumno.nivel;
      document.getElementById('uiCedula').textContent = alumno.cedula || 'NO REGISTRADA';
      document.getElementById('uiEmail').textContent = alumno.email || user.email;
      
      const [anio, mes, dia] = alumno.fecha_nacimiento ? alumno.fecha_nacimiento.split('-') : ['--', '--', '--'];
      document.getElementById('uiNacimiento').textContent = `${dia}/${mes}/${anio}`;
      
      document.getElementById('uiTelefono').textContent = alumno.telefono;
      document.getElementById('uiDireccion').textContent = alumno.direccion || 'NO REGISTRADA';
      document.getElementById('inputAlumnoId').value = alumno.id;

      if (alumno.foto_url) document.getElementById('uiFoto').src = alumno.foto_url;

      // Renderizar el inventario de bicicletas en la tarjeta principal
      const contenedorBicis = document.getElementById('contenedorBicicletasVisual');
      contenedorBicis.innerHTML = '';
      const bicisList = alumno.tipos_bici || []; 
      const bicisValidas = bicisList.filter(b => b && (b.rin || b.marca || b.color || b.tipo));

      if (bicisValidas.length > 0) {
        bicisValidas.forEach((bici, index) => {
          contenedorBicis.innerHTML += `
            <div class="bg-zinc-950 p-4 border border-zinc-800 transform -skew-x-2">
              <span class="text-lime-400 font-black text-xs uppercase italic block mb-1">Bicicleta ${index + 1} (${bici.tipo || 'BICICLETA'})</span>
              <p class="text-white text-sm font-bold">Rin: <span class="text-cyan-400">${bici.rin || 'N/A'}</span></p>
              <p class="text-white text-sm font-bold">Marca: <span class="text-cyan-400">${bici.marca || 'N/A'}</span></p>
              <p class="text-white text-sm font-bold">Color: <span class="text-cyan-400">${bici.color || 'N/A'}</span></p>
            </div>
          `;
        });
      } else {
        contenedorBicis.innerHTML = `<p class="text-zinc-500 text-sm italic">No hay bicicletas registradas.</p>`;
      }

      // Verificación de Solvencia
      const fechaActual = new Date();
      const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
      const mesActualStr = `${mesesNombres[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;

      const { data: pagosMes } = await supabase
        .from('pagos')
        .select('id')
        .eq('alumno_id', alumno.id)
        .eq('mes_correspondiente', mesActualStr);

      const uiEstatus = document.getElementById('uiEstatus');
      const uiIcono = document.getElementById('uiIconoEstatus');

      if (pagosMes && pagosMes.length > 0) {
        uiEstatus.textContent = "AL DÍA (REVISIÓN)";
        uiEstatus.className = "text-xl font-black italic uppercase text-cyan-400";
        uiIcono.className = "w-12 h-12 bg-cyan-400 rounded-full flex items-center justify-center text-black text-2xl shadow-[0_0_15px_#00d2ff]";
        uiIcono.textContent = "✓";
      } else {
        uiEstatus.textContent = "CON DEUDA";
        uiEstatus.className = "text-2xl font-black italic uppercase text-pink-500";
        uiIcono.className = "w-12 h-12 bg-pink-600 rounded-full flex items-center justify-center text-white text-2xl shadow-[0_0_15px_#db2777] animate-pulse";
        uiIcono.textContent = "!";
      }

      pantallaCarga.classList.add('hidden');
      dashboardContenido.classList.remove('hidden');

    } catch (error) {
      console.error(error);
      alert("Hubo un error cargando tu información.");
      window.location.href = '/';
    }
  });

  // Cerrar Sesión
  document.getElementById('btnLogout').addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });

  // Modal Pagos
  const modalPago = document.getElementById('modalPago');
  document.getElementById('btnAbrirModalPago').addEventListener('click', () => modalPago.classList.remove('hidden'));
  document.getElementById('btnCerrarModal').addEventListener('click', () => { modalPago.classList.add('hidden'); document.getElementById('formPago').reset(); });

  document.getElementById('formPago').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnEnviarPago');
    btn.textContent = "ENVIANDO..."; btn.disabled = true;

    try {
      const { error } = await supabase.from('pagos').insert([{ 
        alumno_id: document.getElementById('inputAlumnoId').value,
        metodo_pago: document.getElementById('inputMetodo').value,
        referencia: document.getElementById('inputReferencia').value,
        monto: parseFloat(document.getElementById('inputMonto').value),
        mes_correspondiente: document.getElementById('inputMes').value
      }]);
      if (error) throw error;

      const msg = document.getElementById('mensajePago');
      msg.textContent = "¡Pago reportado con éxito!";
      msg.className = "text-sm font-bold uppercase italic text-center p-2 border border-lime-400 bg-lime-400/20 text-lime-400 block mt-2";
      setTimeout(() => { modalPago.classList.add('hidden'); document.getElementById('formPago').reset(); msg.classList.add('hidden'); btn.textContent = "Enviar Reporte"; btn.disabled = false; }, 2000);
    } catch (err) {
      console.error(err);
      alert("Error al reportar el pago.");
      btn.textContent = "Enviar Reporte"; btn.disabled = false;
    }
  });

  // Modal Edición
  const modalEditar = document.getElementById('modalEditar');
  document.getElementById('btnAbrirModalEditar').addEventListener('click', () => {
    document.getElementById('editNombre').value = (document.getElementById('uiNombreCompleto')?.textContent || '').toUpperCase();
    document.getElementById('editCedula').value = (window.currentCedula || '').toUpperCase();
    document.getElementById('editNacimiento').value = window.currentNacimientoRaw || '';
    document.getElementById('editEmail').value = (window.currentEmail || '').toLowerCase();
    document.getElementById('editTelefono').value = (document.getElementById('uiTelefono')?.textContent || '').toUpperCase();
    document.getElementById('editDireccion').value = (window.currentDireccion || '').toUpperCase();
    document.getElementById('editNivel').value = (document.getElementById('uiNivel')?.textContent || 'INTERMEDIO').toUpperCase();
    document.getElementById('editFoto').value = document.getElementById('uiFoto')?.src || '';

    const bicis = window.currentBicicletas || [];
    
    // Cargar Bicicleta 1
    if (bicis[0]) {
      document.getElementById('editBici1Tipo').value = bicis[0].tipo || 'MTB';
      document.getElementById('editBici1Rin').value = bicis[0].rin || '';
      document.getElementById('editBici1Marca').value = bicis[0].marca || '';
      document.getElementById('editBici1Color').value = bicis[0].color || '';
    }
    
    // Cargar Bicicleta 2
    if (bicis[1]) {
      document.getElementById('editBici2Tipo').value = bicis[1].tipo || '';
      document.getElementById('editBici2Rin').value = bicis[1].rin || '';
      document.getElementById('editBici2Marca').value = bicis[1].marca || '';
      document.getElementById('editBici2Color').value = bicis[1].color || '';
    } else {
      document.getElementById('editBici2Tipo').value = '';
      document.getElementById('editBici2Rin').value = '';
      document.getElementById('editBici2Marca').value = '';
      document.getElementById('editBici2Color').value = '';
    }
    
    modalEditar.classList.remove('hidden');
  });

  document.getElementById('btnCerrarModalEditar').addEventListener('click', () => modalEditar.classList.add('hidden'));

  document.getElementById('formEditar').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnGuardarEdicion');
    btn.textContent = "GUARDANDO..."; 
    btn.disabled = true;

    const listaBicicletas = [];
    
    // Recoger Bicicleta 1
    const b1Tipo = document.getElementById('editBici1Tipo').value;
    if (b1Tipo) {
      listaBicicletas.push({
        tipo: b1Tipo,
        rin: document.getElementById('editBici1Rin').value.toUpperCase(),
        marca: document.getElementById('editBici1Marca').value.toUpperCase(),
        color: document.getElementById('editBici1Color').value.toUpperCase()
      });
    }

    // Recoger Bicicleta 2
    const b2Tipo = document.getElementById('editBici2Tipo').value;
    if (b2Tipo && b2Tipo !== "") {
      listaBicicletas.push({
        tipo: b2Tipo,
        rin: document.getElementById('editBici2Rin').value.toUpperCase(),
        marca: document.getElementById('editBici2Marca').value.toUpperCase(),
        color: document.getElementById('editBici2Color').value.toUpperCase()
      });
    }

    try {
      const { data: { session } } = await supabase.auth.getSession();
      const { error } = await supabase
        .from('alumnos')
        .update({
          nombre: document.getElementById('editNombre').value.toUpperCase(),
          cedula: document.getElementById('editCedula').value.toUpperCase(),
          fecha_nacimiento: document.getElementById('editNacimiento').value,
          email: document.getElementById('editEmail').value.toLowerCase(),
          direccion: document.getElementById('editDireccion').value.toUpperCase(),
          telefono: document.getElementById('editTelefono').value.toUpperCase(),
          nivel: document.getElementById('editNivel').value.toUpperCase(),
          foto_url: document.getElementById('editFoto').value,
          tipos_bici: listaBicicletas
        })
        .eq('user_id', session.user.id);

      if (error) throw error;

      const msg = document.getElementById('mensajeEditar');
      msg.textContent = "¡Ficha actualizada con éxito! Recargando...";
      msg.className = "text-sm font-bold uppercase italic text-center p-2 border border-lime-400 bg-lime-400/20 text-lime-400 block mt-2";
      
      setTimeout(() => { window.location.reload(); }, 1500);
    } catch (err) {
      console.error(err);
      alert("Error al actualizar la ficha.");
      btn.textContent = "Guardar Cambios"; 
      btn.disabled = false;
    }
  });
</script>