<script type="module">
  import { supabase } from '../lib/supabase.js';

  let currentUser = null;
  let currentAlumno = null;

  const MESES_NOMBRES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

  function escaparHTML(texto) {
    if (texto === null || texto === undefined) return '';
    return String(texto)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function inicializarSelectorMeses() {
    const selectMes = document.getElementById('inputMes');
    if (!selectMes) return;

    const hoy = new Date();
    selectMes.innerHTML = '';

    for (let offset = -1; offset <= 2; offset++) {
      const fechaOpcion = new Date(hoy.getFullYear(), hoy.getMonth() + offset, 1);
      const textoMes = `${MESES_NOMBRES[fechaOpcion.getMonth()]} ${fechaOpcion.getFullYear()}`;
      const option = document.createElement('option');
      option.value = textoMes;
      option.textContent = textoMes;
      if (offset === 0) option.selected = true;
      selectMes.appendChild(option);
    }
  }

  function abrirModalCambiarClave(mostrarAvisoRecuperacion = false) {
    const modalPassword = document.getElementById('modalPassword');
    const msgPass = document.getElementById('mensajePassword');
    const inputPass = document.getElementById('inputNuevaPassword');
    if (!modalPassword) return;

    if (inputPass) inputPass.value = '';

    if (mostrarAvisoRecuperacion && msgPass) {
      msgPass.textContent = "🔑 Enlace verificado. Escribe tu nueva contraseña abajo para actualizarla.";
      msgPass.className = "text-xs font-bold uppercase italic text-center p-2.5 border border-cyan-400 bg-cyan-400/20 text-cyan-400 block";
      msgPass.classList.remove('hidden');
    } else {
      msgPass?.classList.add('hidden');
    }

    modalPassword.classList.remove('hidden');
    setTimeout(() => inputPass?.focus(), 100);
  }

  const vieneDeRecuperacion = window.location.hash.includes('type=recovery');
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') {
      abrirModalCambiarClave(true);
    }
  });

  document.addEventListener('DOMContentLoaded', async () => {
    const pantallaCarga = document.getElementById('pantallaCarga');
    const dashboardContenido = document.getElementById('dashboardContenido');

    inicializarSelectorMeses();

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { 
        window.location.href = '/login'; 
        return; 
      }

      currentUser = session.user;

      const [{ data: alumno, error }, { data: tasaConfig }, { data: agendaConfig }] = await Promise.all([
        supabase.from('alumnos').select('*').eq('user_id', currentUser.id).single(),
        supabase.from('configuracion').select('valor').eq('clave', 'tasa_dolar').single(),
        supabase.from('configuracion').select('valor').eq('clave', 'planificacion_semanal').single()
      ]);

      if (error || !alumno) throw new Error("No se encontró la ficha del alumno.");

      currentAlumno = alumno;

      const tasaValor = parseFloat(tasaConfig?.valor || 0);
      const uiTasa = document.getElementById('uiTasaValor');
      const uiInscripcionBs = document.getElementById('uiTotalInscripcionBs');
      const uiMensualidadBs = document.getElementById('uiTotalMensualidadBs');

      if (tasaValor > 0) {
        uiTasa.textContent = tasaValor.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        
        const inscripcionBs = (30 * tasaValor).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const mensualidadBs = (70 * tasaValor).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        if (uiInscripcionBs) uiInscripcionBs.textContent = `${inscripcionBs} Bs.`;
        if (uiMensualidadBs) uiMensualidadBs.textContent = `${mensualidadBs} Bs.`;
      } else {
        uiTasa.textContent = "Pendiente";
        if (uiInscripcionBs) uiInscripcionBs.textContent = "Consultar";
        if (uiMensualidadBs) uiMensualidadBs.textContent = "Consultar";
      }

      document.getElementById('inputConcepto')?.addEventListener('change', (e) => {
        const inputMonto = document.getElementById('inputMonto');
        const valor = e.target.value;
        if (valor === 'Inscripcion') inputMonto.value = 30;
        else if (valor === 'Mensualidad') inputMonto.value = 70;
        else if (valor === 'Inscripcion + Mensualidad') inputMonto.value = 100;
        else inputMonto.value = '';
      });

      window.currentCedula = alumno.cedula || '';
      window.currentEmail = alumno.email || currentUser.email;
      window.currentDireccion = alumno.direccion || '';
      window.currentNacimientoRaw = alumno.fecha_nacimiento || '';
      window.currentTipoSangre = alumno.tipo_sangre || '';
      window.currentCondicion = alumno.condicion_especial || 'NINGUNA';
      window.currentBicicletas = alumno.tipos_bici || [];

      document.getElementById('uiNombre').textContent = (alumno.nombre || 'ATLETA').split(' ')[0];
      document.getElementById('uiNombreCompleto').textContent = alumno.nombre || 'Atleta';
      document.getElementById('uiNivel').textContent = alumno.nivel || 'NIVEL GENERAL';
      document.getElementById('uiCedula').textContent = alumno.cedula || 'NO REGISTRADA';
      document.getElementById('uiEmail').textContent = alumno.email || currentUser.email;
      document.getElementById('uiTipoSangre').textContent = alumno.tipo_sangre || 'NO REGISTRADO';
      
      const elCondicion = document.getElementById('uiCondicionEspecial');
      if (elCondicion) {
        const textoCond = alumno.condicion_especial || 'NINGUNA';
        elCondicion.textContent = textoCond;
        elCondicion.title = textoCond;
      }
      
      const [anio, mes, dia] = alumno.fecha_nacimiento ? alumno.fecha_nacimiento.split('-') : ['--', '--', '--'];
      document.getElementById('uiNacimiento').textContent = `${dia}/${mes}/${anio}`;
      document.getElementById('uiTelefono').textContent = alumno.telefono || 'NO REGISTRADO';
      document.getElementById('uiDireccion').textContent = alumno.direccion || 'NO REGISTRADA';

      if (alumno.foto_url) {
        document.getElementById('uiFoto').src = alumno.foto_url;
      }

      const contenedorBicis = document.getElementById('contenedorBicicletasVisual');
      contenedorBicis.innerHTML = '';
      const bicisList = alumno.tipos_bici || []; 
      const bicisValidas = bicisList.filter(b => b && (b.rin || b.marca || b.color || b.tipo));

      if (bicisValidas.length > 0) {
        bicisValidas.forEach((bici, index) => {
          contenedorBicis.innerHTML += `
            <div class="bg-zinc-950 p-4 border border-zinc-800 transform -skew-x-2">
              <span class="text-lime-400 font-black text-xs uppercase italic block mb-1">Bicicleta ${index + 1} (${escaparHTML(bici.tipo || 'BICICLETA')})</span>
              <p class="text-white text-sm font-bold">Rin: <span class="text-cyan-400">${escaparHTML(bici.rin || 'N/A')}</span></p>
              <p class="text-white text-sm font-bold">Marca: <span class="text-cyan-400">${escaparHTML(bici.marca || 'N/A')}</span></p>
              <p class="text-white text-sm font-bold">Color: <span class="text-cyan-400">${escaparHTML(bici.color || 'N/A')}</span></p>
            </div>
          `;
        });
      } else {
        contenedorBicis.innerHTML = `<p class="text-zinc-400 text-sm italic">No hay bicicletas registradas.</p>`;
      }

      const fechaActual = new Date();
      const mesActualStr = `${MESES_NOMBRES[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;

      const { data: ultimosPagos } = await supabase
        .from('pagos')
        .select('*')
        .eq('alumno_id', alumno.id)
        .order('created_at', { ascending: false });

      const uiEstatus = document.getElementById('uiEstatus');
      const uiIcono = document.getElementById('uiIconoEstatus');

      const pagoMesActual = ultimosPagos?.find(p => p.mes_correspondiente === mesActualStr);
      const ultimoPago = ultimosPagos?.[0];

      let estatusFinal = 'deuda';

      if (pagoMesActual) {
        estatusFinal = pagoMesActual.estado;
      } else if (ultimoPago?.estado === 'revision') {
        estatusFinal = 'revision';
      }

      if (estatusFinal === 'aprobado') {
        uiEstatus.textContent = "AL DÍA (APROBADO)";
        uiEstatus.className = "text-xl font-black italic uppercase text-lime-400";
        uiIcono.className = "w-11 h-11 bg-lime-400 rounded-full flex items-center justify-center text-black text-xl shadow-[0_0_15px_#a3e635] flex-shrink-0";
        uiIcono.textContent = "✓";
      } else if (estatusFinal === 'revision') {
        uiEstatus.textContent = "EN REVISIÓN";
        uiEstatus.className = "text-xl font-black italic uppercase text-cyan-400";
        uiIcono.className = "w-11 h-11 bg-cyan-400 rounded-full flex items-center justify-center text-black text-xl shadow-[0_0_15px_#00d2ff] animate-pulse flex-shrink-0";
        uiIcono.textContent = "⏳";
      } else {
        uiEstatus.textContent = "CON DEUDA";
        uiEstatus.className = "text-2xl font-black italic uppercase text-pink-500";
        uiIcono.className = "w-11 h-11 bg-pink-600 rounded-full flex items-center justify-center text-white text-xl shadow-[0_0_15px_#db2777] animate-pulse flex-shrink-0";
        uiIcono.textContent = "!";
      }

      // Renderizar el Calendario Semanal (7 Días)
      let agendaText = {};
      if (agendaConfig && agendaConfig.valor) {
        agendaText = JSON.parse(agendaConfig.valor);
      }

      // Colores fieles al diseño original
      const diasUI = [
        { id: 'lunes', nombre: 'Lunes', cBorder: 'border-cyan-400', cTag: 'bg-cyan-400 text-black', cTime: 'text-cyan-300 bg-cyan-950/40 border-cyan-800' },
        { id: 'martes', nombre: 'Martes', cBorder: 'border-lime-400', cTag: 'bg-lime-400 text-black', cTime: 'text-lime-300 bg-lime-950/40 border-lime-800' },
        { id: 'miercoles', nombre: 'Miércoles', cBorder: 'border-pink-500', cTag: 'bg-pink-500 text-white', cTime: 'text-pink-300 bg-pink-950/40 border-pink-800' },
        { id: 'jueves', nombre: 'Jueves', cBorder: 'border-lime-400', cTag: 'bg-lime-400 text-black', cTime: 'text-lime-300 bg-lime-950/40 border-lime-800' },
        { id: 'viernes', nombre: 'Viernes', cBorder: 'border-lime-400', cTag: 'bg-lime-400 text-black', cTime: 'text-lime-300 bg-lime-950/40 border-lime-800' },
        { id: 'sabado', nombre: 'Sábado', cBorder: 'border-purple-500', cTag: 'bg-purple-500 text-white', cTime: 'text-purple-300 bg-purple-950/40 border-purple-800' },
        { id: 'domingo', nombre: 'Domingo', cBorder: 'border-orange-500', cTag: 'bg-orange-500 text-black', cTime: 'text-orange-300 bg-orange-950/40 border-orange-800' },
      ];

      let htmlCalendario = '';
      diasUI.forEach(dia => {
        const dataDia = agendaText[dia.id] || { activo: false };

        if (!dataDia.activo) {
          // Tarjeta de Día Libre
          htmlCalendario += `
            <div class="bg-zinc-950 p-4 border-l-4 ${dia.cBorder} border-y border-r border-zinc-800 flex flex-col justify-between opacity-60 hover:opacity-100 transition">
              <div>
                <span class="text-xs font-black uppercase ${dia.cBorder.replace('border-', 'text-')} tracking-wider block mb-3">${dia.nombre}</span>
                <p class="text-[14px] text-zinc-500 font-medium italic mt-2">Día libre de actividades.</p>
              </div>
            </div>
          `;
        } else {
          // Tarjeta Activa (Misma estructura HTML que el diseño original)
          let actividadesHtml = '';
          
          if (dataDia.a1_lugar || dataDia.a1_desc) {
             actividadesHtml += `
                <div>
                  ${dataDia.a1_tag ? `<span class="text-[10px] font-black ${dia.cTag} px-1.5 py-0.5 uppercase shadow-sm">${escaparHTML(dataDia.a1_tag)}</span>` : ''}
                  <p class="text-[14px] text-zinc-300 mt-1.5 leading-snug">
                    ${dataDia.a1_lugar ? `<strong class="text-white drop-shadow-sm">📍 ${escaparHTML(dataDia.a1_lugar)}</strong><br>` : ''}
                    ${escaparHTML(dataDia.a1_desc)}
                  </p>
                </div>
             `;
          }
          
          if (dataDia.a2_lugar || dataDia.a2_desc) {
             actividadesHtml += `
                <div class="mt-4 pt-4 border-t border-zinc-800/60">
                  ${dataDia.a2_tag ? `<span class="text-[10px] font-black ${dia.cTag} px-1.5 py-0.5 uppercase shadow-sm">${escaparHTML(dataDia.a2_tag)}</span>` : ''}
                  <p class="text-[14px] text-zinc-300 mt-1.5 leading-snug">
                    ${dataDia.a2_lugar ? `<strong class="text-white drop-shadow-sm">📍 ${escaparHTML(dataDia.a2_lugar)}</strong><br>` : ''}
                    ${escaparHTML(dataDia.a2_desc)}
                  </p>
                </div>
             `;
          }

          htmlCalendario += `
            <div class="bg-zinc-950 p-4 border-l-4 ${dia.cBorder} border-y border-r border-zinc-800 flex flex-col justify-between shadow-[2px_2px_0px_rgba(0,0,0,0.5)]">
              <div>
                <span class="text-xs font-black uppercase ${dia.cBorder.replace('border-', 'text-')} tracking-wider block mb-3">${dia.nombre}</span>
                <div class="space-y-1">
                  ${actividadesHtml}
                </div>
              </div>
              ${dataDia.horario ? `<span class="inline-block mt-4 text-xs font-mono font-black ${dia.cTime} border px-2.5 py-1 w-fit shadow-inner">🕔 ${escaparHTML(dataDia.horario)}</span>` : ''}
            </div>
          `;
        }
      });
      document.getElementById('contenedorCalendarioSemanal').innerHTML = htmlCalendario;

      pantallaCarga.classList.add('hidden');
      dashboardContenido.classList.remove('hidden');

      if (vieneDeRecuperacion) {
        abrirModalCambiarClave(true);
      }

    } catch (error) {
      console.error("Error al cargar perfil:", error);
      alert("Hubo un error cargando tu información.");
      window.location.href = '/';
    }
  });

  document.getElementById('btnLogout')?.addEventListener('click', async () => {
    sessionStorage.clear();
    await supabase.auth.signOut();
    window.location.href = '/login';
  });

  // --- FLUJO DE REPORTAR PAGO CON SUBIDA DE CAPTURE ---
  const modalDeuda = document.getElementById('modalRecordatorioDeuda');
  const modalPago = document.getElementById('modalPago');

  document.getElementById('btnAbrirModalPago')?.addEventListener('click', () => {
    const yaVisto = sessionStorage.getItem('recordatorio_pago_visto');
    if (!yaVisto && modalDeuda) {
      modalDeuda.classList.remove('hidden');
    } else {
      modalPago?.classList.remove('hidden');
    }
  });

  document.getElementById('btnCerrarRecordatorio')?.addEventListener('click', () => {
    modalDeuda?.classList.add('hidden');
    sessionStorage.setItem('recordatorio_pago_visto', 'true');
  });

  document.getElementById('btnIrAPagarDeuda')?.addEventListener('click', () => {
    modalDeuda?.classList.add('hidden');
    sessionStorage.setItem('recordatorio_pago_visto', 'true');
    modalPago?.classList.remove('hidden');
  });

  document.getElementById('btnCerrarModal')?.addEventListener('click', () => { 
    modalPago?.classList.add('hidden'); 
    document.getElementById('formPago').reset(); 
    inicializarSelectorMeses();
  });

  document.getElementById('formPago')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnEnviarPago');
    const msg = document.getElementById('mensajePago');
    
    btn.textContent = "ENVIANDO..."; 
    btn.disabled = true;
    msg.classList.add('hidden');

    try {
      if (!currentUser || !currentAlumno?.id) throw new Error("Sesión no válida.");

      const concepto = document.getElementById('inputConcepto').value;
      const metodo = document.getElementById('inputMetodo').value;
      const referencia = document.getElementById('inputReferencia').value.trim();
      const monto = parseFloat(document.getElementById('inputMonto').value);
      const mes = document.getElementById('inputMes').value;
      const captureFile = document.getElementById('inputCapture')?.files?.[0];

      if (!referencia || isNaN(monto) || monto <= 0) {
        throw new Error("Ingresa monto y referencia válidos.");
      }

      let comprobanteUrlFinal = null;

      // Subida del capture a Supabase Storage si se adjuntó
      if (captureFile) {
        if (captureFile.size > 8 * 1024 * 1024) {
          throw new Error("El capture no debe superar los 8 MB.");
        }
        btn.textContent = "SUBIENDO CAPTURE...";
        const fileExt = captureFile.name.split('.').pop()?.toLowerCase() || 'jpg';
        const fileName = `${currentAlumno.id}-${Date.now()}.${fileExt}`;

        const { error: uploadError } = await supabase.storage
          .from('comprobantes-pagos')
          .upload(fileName, captureFile, { upsert: true });

        if (uploadError) throw uploadError;

        const { data: publicUrlData } = supabase.storage
          .from('comprobantes-pagos')
          .getPublicUrl(fileName);

        comprobanteUrlFinal = publicUrlData.publicUrl;
      }

      btn.textContent = "REGISTRANDO PAGO...";
      const { error } = await supabase.from('pagos').insert([{ 
        user_id: currentUser.id,
        alumno_id: currentAlumno.id,
        metodo_pago: `${metodo} (${concepto})`,
        referencia: referencia,
        monto: monto,
        mes_correspondiente: mes,
        estado: 'revision',
        comprobante_url: comprobanteUrlFinal
      }]);

      if (error) throw error;

      msg.textContent = "¡Pago reportado con éxito!";
      msg.className = "text-sm font-bold uppercase italic text-center p-2 border border-lime-400 bg-lime-400/20 text-lime-400 block mt-2";
      
      setTimeout(() => { window.location.reload(); }, 1200);

    } catch (err) {
      console.error(err);
      msg.textContent = err.message || "Error al reportar pago.";
      msg.className = "text-sm font-bold uppercase italic text-center p-2 border border-pink-500 bg-pink-500/20 text-pink-500 block mt-2";
      msg.classList.remove('hidden');
      btn.textContent = "Enviar Reporte"; 
      btn.disabled = false;
    }
  });

  // --- MODAL CAMBIAR CONTRASEÑA INDEPENDIENTE ---
  const modalPassword = document.getElementById('modalPassword');
  document.getElementById('btnAbrirModalPassword')?.addEventListener('click', () => abrirModalCambiarClave(false));
  document.getElementById('btnCerrarModalPassword')?.addEventListener('click', () => modalPassword?.classList.add('hidden'));

  const btnToggleNuevaPass = document.getElementById('btnToggleNuevaPass');
  const inputNuevaPass = document.getElementById('inputNuevaPassword');
  const iconoOjoAbiertoPass = document.getElementById('iconoOjoAbiertoPass');
  const iconoOjoCerradoPass = document.getElementById('iconoOjoCerradoPass');

  if (btnToggleNuevaPass && inputNuevaPass) {
    btnToggleNuevaPass.addEventListener('click', () => {
      const esPassword = inputNuevaPass.type === 'password';
      inputNuevaPass.type = esPassword ? 'text' : 'password';
      iconoOjoAbiertoPass.classList.toggle('hidden', esPassword);
      iconoOjoCerradoPass.classList.toggle('hidden', !esPassword);
    });
  }

  document.getElementById('formPassword')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnGuardarPassword');
    const msgPass = document.getElementById('mensajePassword');
    const nuevaPassword = inputNuevaPass.value;

    msgPass.classList.add('hidden');

    if (!nuevaPassword || nuevaPassword.length < 6) {
      msgPass.textContent = "La contraseña debe tener al menos 6 caracteres.";
      msgPass.className = "text-xs font-bold uppercase italic text-center p-2.5 border border-pink-500 bg-pink-500/20 text-pink-400 block";
      msgPass.classList.remove('hidden');
      return;
    }

    btn.textContent = "ACTUALIZANDO...";
    btn.disabled = true;

    try {
      const { error } = await supabase.auth.updateUser({ password: nuevaPassword });
      if (error) throw error;

      msgPass.textContent = "✓ ¡Contraseña actualizada exitosamente!";
      msgPass.className = "text-xs font-bold uppercase italic text-center p-2.5 border border-lime-400 bg-lime-400/20 text-lime-400 block";
      msgPass.classList.remove('hidden');

      setTimeout(() => {
        modalPassword.classList.add('hidden');
        if (window.location.hash.includes('type=recovery')) {
          history.replaceState(null, '', window.location.pathname);
        }
      }, 1400);
    } catch (err) {
      console.error(err);
      msgPass.textContent = err.message || "Error al actualizar la contraseña.";
      msgPass.className = "text-xs font-bold uppercase italic text-center p-2.5 border border-pink-500 bg-pink-500/20 text-pink-400 block";
      msgPass.classList.remove('hidden');
    } finally {
      btn.textContent = "Actualizar Contraseña";
      btn.disabled = false;
    }
  });

  // --- MODAL EDITAR FICHA ---
  const modalEditar = document.getElementById('modalEditar');
  document.getElementById('btnAbrirModalEditar')?.addEventListener('click', () => {
    document.getElementById('editNombre').value = (document.getElementById('uiNombreCompleto')?.textContent || '').toUpperCase();
    document.getElementById('editCedula').value = (window.currentCedula || '').toUpperCase();
    document.getElementById('editNacimiento').value = window.currentNacimientoRaw || '';
    document.getElementById('editEmail').value = (window.currentEmail || '').toLowerCase();
    document.getElementById('editTelefono').value = (document.getElementById('uiTelefono')?.textContent || '').toUpperCase();
    document.getElementById('editDireccion').value = (window.currentDireccion || '').toUpperCase();
    document.getElementById('editNivel').value = (currentAlumno?.nivel || 'PRINCIPIANTE').toUpperCase();
    document.getElementById('editTipoSangre').value = window.currentTipoSangre || '';
    document.getElementById('editCondicion').value = (window.currentCondicion || 'NINGUNA').toUpperCase();
    document.getElementById('editFotoFile').value = '';
    document.getElementById('mensajeEditar')?.classList.add('hidden');

    const bicis = window.currentBicicletas || [];
    if (bicis[0]) {
      document.getElementById('editBici1Tipo').value = bicis[0].tipo || 'MTB';
      document.getElementById('editBici1Rin').value = bicis[0].rin || '';
      document.getElementById('editBici1Marca').value = bicis[0].marca || '';
      document.getElementById('editBici1Color').value = bicis[0].color || '';
    }
    modalEditar.classList.remove('hidden');
  });

  document.getElementById('btnCerrarModalEditar')?.addEventListener('click', () => modalEditar.classList.add('hidden'));

  document.getElementById('formEditar')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnGuardarEdicion');
    const msgEditar = document.getElementById('mensajeEditar');
    btn.textContent = "GUARDANDO..."; 
    btn.disabled = true;
    msgEditar?.classList.add('hidden');

    try {
      const userId = currentUser.id;
      let fotoUrlFinal = currentAlumno?.foto_url || '';
      const fotoFile = document.getElementById('editFotoFile').files[0];

      if (fotoFile) {
        if (fotoFile.size > 5 * 1024 * 1024) {
          throw new Error("La fotografía no debe superar los 5 MB.");
        }
        const fileExt = fotoFile.name.split('.').pop()?.toLowerCase() || 'jpg';
        const fileName = `${userId}-perfil.${fileExt}`;
        const { error: uploadError } = await supabase.storage.from('fotos-atletas').upload(fileName, fotoFile, { upsert: true });
        if (uploadError) throw uploadError;
        const { data: publicUrlData } = supabase.storage.from('fotos-atletas').getPublicUrl(fileName);
        fotoUrlFinal = `${publicUrlData.publicUrl}?t=${Date.now()}`;
      }

      const listaBicicletas = [];
      const b1Tipo = document.getElementById('editBici1Tipo').value;
      const b1Rin = document.getElementById('editBici1Rin').value.trim().toUpperCase();
      const b1Marca = document.getElementById('editBici1Marca').value.trim().toUpperCase();
      const b1Color = document.getElementById('editBici1Color').value.trim().toUpperCase();

      if (b1Tipo || b1Rin || b1Marca || b1Color) {
        listaBicicletas.push({
          tipo: b1Tipo,
          rin: b1Rin,
          marca: b1Marca,
          color: b1Color
        });
      }

      const bicisPrevias = window.currentBicicletas || [];
      if (bicisPrevias.length > 1) {
        listaBicicletas.push(...bicisPrevias.slice(1));
      }

      const valorCondicion = document.getElementById('editCondicion').value.trim().toUpperCase() || 'NINGUNA';

      const { error } = await supabase.from('alumnos').update({
        nombre: document.getElementById('editNombre').value.trim().toUpperCase(),
        cedula: document.getElementById('editCedula').value.trim().toUpperCase(),
        fecha_nacimiento: document.getElementById('editNacimiento').value,
        email: document.getElementById('editEmail').value.trim().toLowerCase(),
        direccion: document.getElementById('editDireccion').value.trim().toUpperCase(),
        telefono: document.getElementById('editTelefono').value.trim().toUpperCase(),
        tipo_sangre: document.getElementById('editTipoSangre').value,
        condicion_especial: valorCondicion,
        foto_url: fotoUrlFinal,
        tipos_bici: listaBicicletas
      }).eq('user_id', userId);

      if (error) throw error;

      if (msgEditar) {
        msgEditar.textContent = "✓ ¡Ficha actualizada con éxito!";
        msgEditar.className = "text-sm font-bold uppercase italic text-center p-2 border border-lime-400 bg-lime-400/20 text-lime-400 block";
        msgEditar.classList.remove('hidden');
      }

      setTimeout(() => { window.location.reload(); }, 1000);
    } catch (err) {
      console.error(err);
      if (msgEditar) {
        msgEditar.textContent = err.message || "Error al actualizar la ficha.";
        msgEditar.className = "text-sm font-bold uppercase italic text-center p-2 border border-pink-500 bg-pink-500/20 text-pink-500 block";
        msgEditar.classList.remove('hidden');
      } else {
        alert(err.message || "Error al actualizar la ficha.");
      }
      btn.textContent = "Guardar Cambios"; 
      btn.disabled = false;
    }
  });
</script>