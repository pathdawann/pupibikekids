---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Panel | Pupi Bike Kids" noindex={true}>
  <!-- Navegación Privada -->
  <nav class="bg-black text-white p-4 border-b-4 border-cyan-400 sticky top-0 z-50">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPIBIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <button id="btnLogout" class="text-pink-400 font-bold hover:text-white transition italic uppercase text-sm md:text-base border border-pink-500 px-4 py-1 hover:bg-pink-600 focus:outline-none focus:ring-2 focus:ring-pink-400">
        Cerrar Sesión
      </button>
    </div>
  </nav>

  <!-- Pantalla de Carga -->
  <div id="pantallaCarga" class="min-h-[80vh] flex flex-col items-center justify-center">
    <div class="w-16 h-16 border-4 border-cyan-400 border-t-transparent rounded-full animate-spin mb-4"></div>
    <p class="text-cyan-400 font-black italic uppercase tracking-widest animate-pulse">Cargando perfil...</p>
  </div>

  <!-- Contenido del Dashboard -->
  <main id="dashboardContenido" class="container mx-auto px-4 py-12 max-w-6xl relative hidden min-h-[80vh]">
    <div class="absolute top-0 right-0 w-80 h-80 bg-pink-600 rounded-full mix-blend-screen filter blur-[120px] opacity-10 pointer-events-none"></div>

    <!-- Encabezado de Bienvenida -->
    <div class="mb-10">
      <div class="bg-black inline-block px-8 py-2 transform -skew-x-6 shadow-[6px_6px_0px_#00d2ff] mb-4">
        <h1 class="text-3xl md:text-4xl font-black text-white uppercase italic tracking-wider">
          HOLA, <span id="uiNombre" class="text-cyan-400">ATLETA</span>
        </h1>
      </div>
      <p class="text-zinc-300 italic font-medium text-lg">Este es tu panel de control y autogestión de la academia.</p>
    </div>

    <!-- BLOQUE 1: Ficha Técnica (Izq) + Estado de Pagos y Pago Móvil (Der) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      
      <!-- COLUMNA IZQUIERDA: Ficha del Atleta (2/3) -->
      <div class="lg:col-span-2">
        <section class="bg-zinc-900 p-8 shadow-[8px_8px_0px_#a3e635] border-2 border-lime-400 h-full flex flex-col justify-between">
          <div>
            <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-8 border-b border-zinc-700 pb-6">
              <div class="flex items-center gap-6">
                <div class="w-28 h-28 rounded-full border-4 border-cyan-400 overflow-hidden bg-zinc-950 flex-shrink-0 shadow-lg">
                  <img id="uiFoto" src="" alt="Foto Atleta" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?w=300&auto=format&fit=crop&q=80'" />
                </div>
                <div class="text-center sm:text-left">
                  <h2 class="text-2xl font-black italic uppercase text-lime-400">Ficha Técnica</h2>
                  <p id="uiNombreCompleto" class="text-white font-bold text-xl mt-1">...</p>
                  <p id="uiNivel" class="text-cyan-400 font-bold uppercase italic text-sm mt-1">...</p>
                </div>
              </div>

              <button type="button" id="btnAbrirModalEditar" class="bg-cyan-400 text-black font-black italic uppercase px-5 py-3 hover:bg-cyan-300 transition-all transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] border-2 border-transparent text-sm flex-shrink-0 focus:outline-none focus:ring-2 focus:ring-white">
                ✏️ Editar Ficha
              </button>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div>
                <p class="text-zinc-200 text-xs font-black uppercase tracking-wider mb-1">Cédula</p>
                <p id="uiCedula" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div>
                <p class="text-zinc-200 text-xs font-black uppercase tracking-wider mb-1">Correo Electrónico</p>
                <p id="uiEmail" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2 lowercase">...</p>
              </div>
              <div>
                <p class="text-zinc-200 text-xs font-black uppercase tracking-wider mb-1">Fecha de Nacimiento</p>
                <p id="uiNacimiento" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div>
                <p class="text-zinc-200 text-xs font-black uppercase tracking-wider mb-1">Teléfono / WhatsApp</p>
                <p id="uiTelefono" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div>
                <p class="text-zinc-200 text-xs font-black uppercase tracking-wider mb-1">Tipo de Sangre</p>
                <p id="uiTipoSangre" class="text-pink-400 font-black bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
              <div class="md:col-span-2">
                <p class="text-zinc-200 text-xs font-black uppercase tracking-wider mb-1">Dirección / Residencia</p>
                <p id="uiDireccion" class="text-white font-bold bg-zinc-950 px-4 py-2 border border-zinc-800 transform -skew-x-2">...</p>
              </div>
            </div>
          </div>

          <div class="border-t border-zinc-700 pt-6">
            <h3 class="text-lime-400 font-black italic uppercase text-lg mb-4">Inventario de Bicicletas</h3>
            <div id="contenedorBicicletasVisual" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Se inyectarán dinámicamente -->
            </div>
          </div>
        </section>
      </div>

      <!-- COLUMNA DERECHA: Estado de Pagos y Pago Móvil Dinámico (1/3) -->
      <div class="flex flex-col gap-8">
        
        <!-- Estado de Pagos -->
        <section class="bg-zinc-900 p-6 shadow-[8px_8px_0px_#db2777] border-2 border-pink-500">
          <h2 class="text-xl font-black italic uppercase text-pink-500 mb-4 border-b border-zinc-700 pb-2">Estado de Pagos</h2>
          
          <div class="bg-zinc-950 p-4 border border-zinc-800 mb-4 flex items-center justify-between">
            <div>
              <p class="text-zinc-300 text-xs font-black uppercase tracking-wider">Estatus del Mes</p>
              <p id="uiEstatus" class="text-xl font-black italic uppercase text-zinc-400">CARGANDO...</p>
            </div>
            <div id="uiIconoEstatus" class="w-12 h-12 bg-zinc-800 rounded-full flex items-center justify-center text-zinc-400 text-2xl animate-pulse">?</div>
          </div>

          <button id="btnAbrirModalPago" class="w-full bg-pink-600 text-white font-black italic uppercase text-lg py-3 hover:bg-pink-500 transition-all transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] hover:translate-y-1 mb-3 border-2 border-transparent focus:outline-none focus:ring-2 focus:ring-white">
            Reportar Pago
          </button>
          
          <a href="/historial" class="block text-center text-cyan-400 text-sm font-bold hover:text-white transition italic underline focus:outline-none focus:text-white">Ver historial completo</a>
        </section>

        <!-- TARJETA DINÁMICA: DATOS DE PAGO MÓVIL Y ARANCELES -->
        <section class="bg-zinc-900 p-6 shadow-[8px_8px_0px_#00d2ff] border-2 border-cyan-400">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 border-b-2 border-zinc-800 pb-3">
            <h3 class="text-2xl font-black italic uppercase text-cyan-400 tracking-wide">Datos Pago Móvil</h3>
            <div class="bg-zinc-950 text-lime-400 border-2 border-lime-400 px-3 py-1 font-mono font-black text-sm text-center shadow">
              TASA DEL DÍA: <span id="uiTasaValor" class="text-white text-base">--</span> Bs/$
            </div>
          </div>

          <!-- Montos convertidos a Bs (Inscripción y Mensualidad) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
            <!-- Inscripción -->
            <div class="bg-zinc-950 p-3 border-2 border-zinc-800 text-center shadow-inner">
              <span class="text-[11px] text-zinc-300 font-black uppercase tracking-wider block mb-1">
                Inscripción (30$):
              </span>
              <span id="uiTotalInscripcionBs" class="text-xl font-black italic text-cyan-400 tracking-tight block">
                Calculando...
              </span>
            </div>

            <!-- Mensualidad -->
            <div class="bg-zinc-950 p-3 border-2 border-zinc-800 text-center shadow-inner">
              <span class="text-[11px] text-zinc-300 font-black uppercase tracking-wider block mb-1">
                Mensualidad (70$):
              </span>
              <span id="uiTotalMensualidadBs" class="text-xl font-black italic text-lime-400 tracking-tight block">
                Calculando...
              </span>
            </div>
          </div>

          <!-- Datos bancarios de Pago Móvil -->
          <div class="space-y-3 bg-zinc-950 p-4 border border-zinc-800">
            <div class="flex justify-between items-center border-b border-zinc-800/80 pb-2">
              <span class="text-xs font-black uppercase text-zinc-300">Banco:</span>
              <span class="text-white text-base font-black">Bco. de Venezuela (0102)</span>
            </div>
            <div class="flex justify-between items-center border-b border-zinc-800/80 pb-2">
              <span class="text-xs font-black uppercase text-zinc-300">Teléfono:</span>
              <span class="text-cyan-400 text-lg font-mono font-black tracking-wider">0424-8781128</span>
            </div>
            <div class="flex justify-between items-center border-b border-zinc-800/80 pb-2">
              <span class="text-xs font-black uppercase text-zinc-300">Cédula:</span>
              <span class="text-white text-base font-mono font-black">V-24.469.073</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-xs font-black uppercase text-zinc-300">Titular:</span>
              <span class="text-lime-400 text-base font-black uppercase">Cesar Barrios</span>
            </div>
          </div>

          <p class="text-xs text-zinc-300 font-medium italic mt-3 text-center leading-relaxed">
            Luego de transferir, haz clic en <strong class="text-pink-400 uppercase">"Reportar Pago"</strong> arriba para registrar el comprobante.
          </p>
        </section>

      </div>
    </div>

    <!-- BLOQUE 2: MAILLOT OFICIAL (Izq) + CALENDARIO DE ACTIVIDADES EN VERTICAL (Der) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      
      <!-- 1. Card de Merch / Maillot Oficial -->
      <section class="bg-zinc-900 p-8 shadow-[8px_8px_0px_#a3e635] border-2 border-lime-400 flex flex-col justify-between group">
        <div>
          <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
            <div>
              <h3 class="text-2xl font-black italic uppercase text-lime-400">Maillot Oficial</h3>
              <p class="text-zinc-300 text-xs">Viste los colores extremos de Pupi Bike Kids.</p>
            </div>
            <span class="bg-lime-400 text-black font-black italic px-3 py-1 text-sm uppercase transform -skew-x-6">Edición Pro 2026</span>
          </div>
          
          <div class="bg-zinc-950 p-4 border border-zinc-800 mb-6 rounded-xl overflow-hidden flex justify-center items-center h-80 shadow-inner">
            <img src="/maillot.png" alt="Maillot Oficial" class="w-full h-full object-contain transform group-hover:scale-105 transition-transform duration-300" />
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-zinc-950 p-4 border border-zinc-800">
          <div>
            <span class="text-zinc-300 text-xs uppercase font-bold block">Precio de lanzamiento:</span>
            <span class="text-2xl font-black italic text-lime-400">35$ <span class="text-xs text-white font-normal">(Todas las tallas)</span></span>
          </div>
          <a href="https://wa.me/584248781128?text=Hola%20Cesar,%20quiero%20comprar%20el%20maillot%20oficial%20de%20la%20academia." target="_blank" class="w-full sm:w-auto text-center bg-lime-400 text-black font-black italic uppercase px-8 py-3 hover:bg-lime-300 transition-all shadow-[4px_4px_0px_#db2777] transform -skew-x-4 focus:outline-none focus:ring-2 focus:ring-white">
            Comprar Ahora
          </a>
        </div>
      </section>

      <!-- 2. Calendario de Actividades en Lista Vertical -->
      <section class="bg-zinc-900 p-8 shadow-[8px_8px_0px_#00d2ff] border-2 border-cyan-400 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6 border-b border-zinc-800 pb-3">
            <h3 class="text-2xl font-black italic uppercase text-cyan-400 tracking-wide">Calendario del Mes</h3>
            <span class="text-zinc-300 text-xs font-bold uppercase italic">Próximos Eventos</span>
          </div>

          <div class="flex flex-col gap-4">
            <!-- Evento 1 -->
            <div class="bg-zinc-950 p-4 border-l-4 border-cyan-400 shadow flex items-center gap-4 hover:translate-x-1 transition-transform">
              <div class="bg-cyan-400 text-black font-black text-center px-3 py-2 flex flex-col justify-center min-w-[65px] transform -skew-x-3">
                <span class="text-xs leading-none">OCT</span>
                <span class="text-xl leading-none">15</span>
              </div>
              <div class="flex-1">
                <h4 class="text-base font-bold text-white uppercase italic">Ruta Nocturna Familiar</h4>
                <p class="text-zinc-300 text-xs">Recorrido por la ciudad para todas las edades. Trae tus luces.</p>
              </div>
            </div>

            <!-- Evento 2 -->
            <div class="bg-zinc-950 p-4 border-l-4 border-pink-500 shadow flex items-center gap-4 hover:translate-x-1 transition-transform">
              <div class="bg-pink-500 text-white font-black text-center px-3 py-2 flex flex-col justify-center min-w-[65px] transform -skew-x-3">
                <span class="text-xs leading-none">OCT</span>
                <span class="text-xl leading-none">22</span>
              </div>
              <div class="flex-1">
                <h4 class="text-base font-bold text-white uppercase italic">Clínica de Saltos</h4>
                <p class="text-zinc-300 text-xs">Técnicas de despegue y aterrizaje en pista para intermedio y avanzado.</p>
              </div>
            </div>

            <!-- Evento 3 -->
            <div class="bg-zinc-950 p-4 border-l-4 border-lime-400 shadow flex items-center gap-4 hover:translate-x-1 transition-transform">
              <div class="bg-lime-400 text-black font-black text-center px-3 py-2 flex flex-col justify-center min-w-[65px] transform -skew-x-3">
                <span class="text-xs leading-none">OCT</span>
                <span class="text-xl leading-none">30</span>
              </div>
              <div class="flex-1">
                <h4 class="text-base font-bold text-white uppercase italic">Competencia Halloween</h4>
                <p class="text-zinc-300 text-xs">Ven con tu mejor disfraz a rodar. Premios sorpresa para los atletas.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-zinc-800 text-center">
          <p class="text-xs text-zinc-400 italic">¿Tienes dudas sobre los eventos? Consulta a los entrenadores en pista.</p>
        </div>
      </section>

    </div>
  </main>

  <!-- MODAL REPORTAR PAGO -->
  <div id="modalPago" class="fixed inset-0 bg-black/90 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-2 md:p-4">
    <div class="bg-zinc-900 border-2 border-pink-500 shadow-[8px_8px_0px_#db2777] p-4 md:p-8 w-full max-w-md mx-auto relative transform md:-skew-x-2 max-h-[95vh] overflow-y-auto">
      <button type="button" id="btnCerrarModal" aria-label="Cerrar modal" class="absolute top-3 right-4 text-zinc-400 hover:text-pink-500 transform md:skew-x-2 text-2xl font-black z-10 focus:outline-none focus:text-white">X</button>
      
      <div class="transform skew-x-2">
        <h2 class="text-2xl font-black uppercase italic text-pink-500 mb-6 border-b border-zinc-800 pb-2">Reportar Transferencia</h2>
        <form id="formPago" class="flex flex-col gap-4">
          <!-- Concepto del Pago -->
          <div>
            <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Concepto del Pago</label>
            <select id="inputConcepto" required class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-lime-400 font-bold focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
              <option value="Mensualidad">Mensualidad (70$)</option>
              <option value="Inscripcion">Inscripción (30$)</option>
              <option value="Inscripcion + Mensualidad">Inscripción + Mensualidad (100$)</option>
              <option value="Abono">Abono / Otro Monto</option>
            </select>
          </div>

          <!-- Método de Pago -->
          <div>
            <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Método de Pago</label>
            <select id="inputMetodo" required class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
              <option value="Pago Movil">Pago Móvil</option>
              <option value="Transferencia Banesco">Transferencia Banesco</option>
              <option value="Zelle">Zelle</option>
              <option value="Efectivo">Efectivo en Pista</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Número de Referencia</label>
            <input type="text" id="inputReferencia" required placeholder="Ej: 12345678" class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold placeholder-zinc-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Monto ($)</label>
              <input type="number" id="inputMonto" required value="70" min="1" class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold placeholder-zinc-500 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
            </div>
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Mes que Cancela</label>
              <select id="inputMes" required class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 text-white font-bold focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400">
                <option value="Octubre 2026">Octubre 2026</option>
                <option value="Noviembre 2026">Noviembre 2026</option>
                <option value="Diciembre 2026">Diciembre 2026</option>
              </select>
            </div>
          </div>

          <div id="mensajePago" class="hidden text-sm font-bold uppercase italic text-center p-2 border mt-2"></div>
          <button type="submit" id="btnEnviarPago" class="w-full bg-pink-600 text-white font-black italic uppercase text-lg py-3 hover:bg-pink-500 transition-all mt-2 focus:outline-none focus:ring-2 focus:ring-white">Enviar Reporte</button>
        </form>
      </div>
    </div>
  </div>

  <!-- MODAL EDITAR FICHA -->
  <div id="modalEditar" class="fixed inset-0 bg-black/90 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-2 md:p-4">
    <div class="bg-zinc-900 border-2 border-lime-400 shadow-[8px_8px_0px_#a3e635] p-4 md:p-8 w-full max-w-3xl mx-auto relative transform md:-skew-x-2 h-[95vh] md:h-auto md:max-h-[90vh] overflow-y-auto">
      <button type="button" id="btnCerrarModalEditar" aria-label="Cerrar modal de edición" class="absolute top-3 right-4 text-zinc-400 hover:text-lime-400 transform md:skew-x-2 text-2xl font-black z-10 focus:outline-none focus:text-white">X</button>
      
      <div class="transform skew-x-2">
        <h2 class="text-2xl font-black uppercase italic text-lime-400 mb-6 border-b border-zinc-800 pb-2">Actualizar Ficha del Atleta</h2>
        
        <form id="formEditar" class="flex flex-col gap-6">
          <div>
            <h3 class="text-cyan-400 font-black italic uppercase text-sm mb-3">1. Datos Personales</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Nombre y Apellido</label>
                <input type="text" id="editNombre" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Cédula</label>
                <input type="text" id="editCedula" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Fecha de Nacimiento</label>
                <input type="date" id="editNacimiento" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Correo Electrónico</label>
                <input type="email" id="editEmail" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold lowercase focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Teléfono / WhatsApp</label>
                <input type="text" id="editTelefono" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Nivel Actual</label>
                <select id="editNivel" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
                  <option value="PRINCIPIANTE">PRINCIPIANTE</option>
                  <option value="INTERMEDIO">INTERMEDIO</option>
                  <option value="AVANZADO">AVANZADO</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Tipo de Sangre</label>
                <select id="editTipoSangre" class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
                  <option value="">-- NO ESPECIFICADO --</option>
                  <option value="O+">O+</option>
                  <option value="O-">O-</option>
                  <option value="A+">A+</option>
                  <option value="A-">A-</option>
                  <option value="B+">B+</option>
                  <option value="B-">B-</option>
                  <option value="AB+">AB+</option>
                  <option value="AB-">AB-</option>
                </select>
              </div>
              <div class="md:col-span-2">
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Dirección / Residencia</label>
                <input type="text" id="editDireccion" required class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400">
              </div>
              <div class="md:col-span-2">
                <label class="block text-xs font-black uppercase tracking-wider text-zinc-300 mb-1">Actualizar Fotografía (Opcional)</label>
                <input type="file" id="editFotoFile" accept="image/*" class="w-full px-4 py-2 bg-zinc-950 border border-zinc-700 text-white font-bold file:mr-4 file:py-1 file:px-3 file:border-0 file:text-xs file:font-black file:bg-lime-400 file:text-black hover:file:bg-lime-300 cursor-pointer">
              </div>
            </div>
          </div>

          <div class="border-t border-zinc-800 pt-4">
            <h3 class="text-cyan-400 font-black italic uppercase text-sm mb-3">2. Inventario de Bicicletas</h3>
            <div class="space-y-4">
              <div class="bg-zinc-950 p-4 border border-zinc-800">
                <span class="text-lime-400 font-black text-xs uppercase italic mb-2 block">Bicicleta 1 (Principal)</span>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-300 mb-1">Tipo</label>
                    <select id="editBici1Tipo" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold focus:outline-none focus:border-lime-400">
                      <option value="MTB">MTB</option>
                      <option value="RUTA">RUTA</option>
                      <option value="GRAVEL">GRAVEL</option>
                      <option value="BALANCE">BALANCE</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-300 mb-1">Rin</label>
                    <input type="text" id="editBici1Rin" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase focus:outline-none focus:border-lime-400">
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-300 mb-1">Marca</label>
                    <input type="text" id="editBici1Marca" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase focus:outline-none focus:border-lime-400">
                  </div>
                  <div>
                    <label class="block text-[10px] font-black uppercase text-zinc-300 mb-1">Color</label>
                    <input type="text" id="editBici1Color" class="w-full px-3 py-2 bg-zinc-900 border border-zinc-700 text-white text-sm font-bold uppercase focus:outline-none focus:border-lime-400">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div id="mensajeEditar" class="hidden text-sm font-bold uppercase italic text-center p-2 border mt-2"></div>
          <button type="submit" id="btnGuardarEdicion" class="w-full bg-lime-400 text-black font-black italic uppercase text-lg py-3 hover:bg-lime-300 transition-all mt-2 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] focus:outline-none focus:ring-2 focus:ring-white">Guardar Cambios</button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<!-- MODAL RECORDATORIO DE PAGO (NO INVASIVO) -->
<div id="modalRecordatorioDeuda" class="fixed inset-0 bg-black/90 z-[100] hidden flex items-center justify-center backdrop-blur-sm p-4">
  <div class="bg-zinc-900 border-2 border-pink-500 shadow-[8px_8px_0px_#db2777] p-8 w-full max-w-md mx-auto relative transform -skew-x-2 text-center">
    <button type="button" id="btnCerrarRecordatorio" aria-label="Cerrar recordatorio" class="absolute top-3 right-4 text-zinc-400 hover:text-pink-500 transform skew-x-2 text-2xl font-black z-10 focus:outline-none focus:text-white">X</button>
    <div class="transform skew-x-2">
      <div class="text-pink-500 text-6xl mb-4 animate-bounce">⚠️</div>
      <h2 class="text-2xl font-black uppercase italic text-pink-500 mb-4 tracking-wider">Recordatorio Amistoso</h2>
      <p class="text-zinc-200 font-medium mb-4 text-sm leading-relaxed">
        ¡Hola! Recuerda que los días regulares de pago son del <span class="text-white font-black">1 al 5 de cada mes</span>.
      </p>
      <button type="button" id="btnIrAPagarDeuda" class="w-full bg-pink-600 text-white font-black italic uppercase text-lg py-4 hover:bg-pink-500 transition-all shadow-[4px_4px_0px_rgba(0,0,0,0.5)] border-2 border-transparent focus:outline-none focus:ring-2 focus:ring-white">
        Reportar Pago Ahora
      </button>
    </div>
  </div>
</div>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  let currentUser = null;
  let currentAlumno = null;

  document.addEventListener('DOMContentLoaded', async () => {
    const pantallaCarga = document.getElementById('pantallaCarga');
    const dashboardContenido = document.getElementById('dashboardContenido');

    try {
      // 1. Sesión activa
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { 
        window.location.href = '/login'; 
        return; 
      }

      currentUser = session.user;

      // 2. Cargar perfil del atleta y Tasa del Día en paralelo
      const [{ data: alumno, error }, { data: tasaConfig }] = await Promise.all([
        supabase.from('alumnos').select('*').eq('user_id', currentUser.id).single(),
        supabase.from('configuracion').select('valor').eq('clave', 'tasa_dolar').single()
      ]);

      if (error || !alumno) throw new Error("No se encontró la ficha del alumno.");

      currentAlumno = alumno;

      // 3. Renderizar Tasa y Conversiones en Bolívares (30$ Inscripción y 70$ Mensualidad)
      const tasaValor = parseFloat(tasaConfig?.valor || 0);
      const uiTasa = document.getElementById('uiTasaValor');
      const uiInscripcionBs = document.getElementById('uiTotalInscripcionBs');
      const uiMensualidadBs = document.getElementById('uiTotalMensualidadBs');

      if (tasaValor > 0) {
        uiTasa.textContent = tasaValor.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        
        const inscripcionBs = (30 * tasaValor).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const mensualidadBs = (70 * tasaValor).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        if (uiInscripcionBs) uiInscripcionBs.textContent = `${inscripcionBs} Bs.`;
        if (uiMensualidadBs) uiMensualidadBs.textContent = `${mensualidadBs} Bs.`;
      } else {
        uiTasa.textContent = "Pendiente";
        if (uiInscripcionBs) uiInscripcionBs.textContent = "Consultar";
        if (uiMensualidadBs) uiMensualidadBs.textContent = "Consultar";
      }

      // Actualizar monto sugerido automáticamente cuando el usuario elige el concepto en el modal
      document.getElementById('inputConcepto')?.addEventListener('change', (e) => {
        const inputMonto = document.getElementById('inputMonto');
        const valor = e.target.value;
        if (valor === 'Inscripcion') inputMonto.value = 30;
        else if (valor === 'Mensualidad') inputMonto.value = 70;
        else if (valor === 'Inscripcion + Mensualidad') inputMonto.value = 100;
        else inputMonto.value = '';
      });

      // Variables auxiliares para modal de edición
      window.currentCedula = alumno.cedula || '';
      window.currentEmail = alumno.email || currentUser.email;
      window.currentDireccion = alumno.direccion || '';
      window.currentNacimientoRaw = alumno.fecha_nacimiento || '';
      window.currentTipoSangre = alumno.tipo_sangre || '';
      window.currentBicicletas = alumno.tipos_bici || [];

      // Renderizar datos en pantalla
      document.getElementById('uiNombre').textContent = (alumno.nombre || 'ATLETA').split(' ')[0];
      document.getElementById('uiNombreCompleto').textContent = alumno.nombre || 'Atleta';
      document.getElementById('uiNivel').textContent = alumno.nivel || 'NIVEL GENERAL';
      document.getElementById('uiCedula').textContent = alumno.cedula || 'NO REGISTRADA';
      document.getElementById('uiEmail').textContent = alumno.email || currentUser.email;
      document.getElementById('uiTipoSangre').textContent = alumno.tipo_sangre || 'NO REGISTRADO';
      
      const [anio, mes, dia] = alumno.fecha_nacimiento ? alumno.fecha_nacimiento.split('-') : ['--', '--', '--'];
      document.getElementById('uiNacimiento').textContent = `${dia}/${mes}/${anio}`;
      document.getElementById('uiTelefono').textContent = alumno.telefono || 'NO REGISTRADO';
      document.getElementById('uiDireccion').textContent = alumno.direccion || 'NO REGISTRADA';

      if (alumno.foto_url) {
        document.getElementById('uiFoto').src = alumno.foto_url;
      }

      // Renderizar bicicletas
      const contenedorBicis = document.getElementById('contenedorBicicletasVisual');
      contenedorBicis.innerHTML = '';
      const bicisList = alumno.tipos_bici || []; 
      const bicisValidas = bicisList.filter(b => b && (b.rin || b.marca || b.color || b.tipo));

      if (bicisValidas.length > 0) {
        bicisValidas.forEach((bici, index) => {
          contenedorBicis.innerHTML += `
            <div class="bg-zinc-950 p-4 border border-zinc-800 transform -skew-x-2">
              <span class="text-lime-400 font-black text-xs uppercase italic block mb-1">Bicicleta ${index + 1} (${bici.tipo || 'BICICLETA'})</span>
              <p class="text-white text-sm font-bold">Rin: <span class="text-cyan-400">${bici.rin || 'N/A'}</span></p>
              <p class="text-white text-sm font-bold">Marca: <span class="text-cyan-400">${bici.marca || 'N/A'}</span></p>
              <p class="text-white text-sm font-bold">Color: <span class="text-cyan-400">${bici.color || 'N/A'}</span></p>
            </div>
          `;
        });
      } else {
        contenedorBicis.innerHTML = `<p class="text-zinc-400 text-sm italic">No hay bicicletas registradas.</p>`;
      }

      // 4. Verificación de Solvencia Inteligente
      const fechaActual = new Date();
      const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
      const mesActualStr = `${mesesNombres[fechaActual.getMonth()]} ${fechaActual.getFullYear()}`;

      const { data: ultimosPagos } = await supabase
        .from('pagos')
        .select('*')
        .eq('alumno_id', alumno.id)
        .order('created_at', { ascending: false });

      const uiEstatus = document.getElementById('uiEstatus');
      const uiIcono = document.getElementById('uiIconoEstatus');

      const pagoMesActual = ultimosPagos?.find(p => p.mes_correspondiente === mesActualStr);
      const ultimoPago = ultimosPagos?.[0];

      let estatusFinal = 'deuda';

      if (pagoMesActual) {
        estatusFinal = pagoMesActual.estado;
      } else if (ultimoPago) {
        estatusFinal = ultimoPago.estado;
      }

      if (estatusFinal === 'aprobado') {
        uiEstatus.textContent = "AL DÍA (APROBADO)";
        uiEstatus.className = "text-xl font-black italic uppercase text-lime-400";
        uiIcono.className = "w-12 h-12 bg-lime-400 rounded-full flex items-center justify-center text-black text-2xl shadow-[0_0_15px_#a3e635]";
        uiIcono.textContent = "✓";
      } else if (estatusFinal === 'revision') {
        uiEstatus.textContent = "EN REVISIÓN";
        uiEstatus.className = "text-xl font-black italic uppercase text-cyan-400";
        uiIcono.className = "w-12 h-12 bg-cyan-400 rounded-full flex items-center justify-center text-black text-2xl shadow-[0_0_15px_#00d2ff] animate-pulse";
        uiIcono.textContent = "⏳";
      } else {
        uiEstatus.textContent = "CON DEUDA";
        uiEstatus.className = "text-2xl font-black italic uppercase text-pink-500";
        uiIcono.className = "w-12 h-12 bg-pink-600 rounded-full flex items-center justify-center text-white text-2xl shadow-[0_0_15px_#db2777] animate-pulse";
        uiIcono.textContent = "!";
        
        const yaVistoEnSesion = sessionStorage.getItem('recordatorio_visto');
        if (fechaActual.getDate() > 5 && estatusFinal !== 'revision' && !yaVistoEnSesion) {
          document.getElementById('modalRecordatorioDeuda')?.classList.remove('hidden');
        }
      }

      pantallaCarga.classList.add('hidden');
      dashboardContenido.classList.remove('hidden');

    } catch (error) {
      console.error("Error al cargar perfil:", error);
      alert("Hubo un error cargando tu información.");
      window.location.href = '/';
    }
  });

  // Modal Recordatorio
  const modalDeuda = document.getElementById('modalRecordatorioDeuda');
  if (modalDeuda) {
    const cerrarModal = () => {
      modalDeuda.classList.add('hidden');
      sessionStorage.setItem('recordatorio_visto', 'true');
    };
    document.getElementById('btnCerrarRecordatorio')?.addEventListener('click', cerrarModal);
    document.getElementById('btnIrAPagarDeuda')?.addEventListener('click', () => {
      cerrarModal();
      document.getElementById('modalPago')?.classList.remove('hidden');
    });
  }

  // Logout
  document.getElementById('btnLogout')?.addEventListener('click', async () => {
    sessionStorage.clear();
    await supabase.auth.signOut();
    window.location.href = '/login';
  });

  // Modal Pagos
  const modalPago = document.getElementById('modalPago');
  document.getElementById('btnAbrirModalPago')?.addEventListener('click', () => modalPago.classList.remove('hidden'));
  document.getElementById('btnCerrarModal')?.addEventListener('click', () => { 
    modalPago.classList.add('hidden'); 
    document.getElementById('formPago').reset(); 
  });

  // Envío del Formulario de Pagos con Concepto
  document.getElementById('formPago')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnEnviarPago');
    const msg = document.getElementById('mensajePago');
    
    btn.textContent = "ENVIANDO..."; 
    btn.disabled = true;
    msg.classList.add('hidden');

    try {
      if (!currentUser || !currentAlumno?.id) throw new Error("Sesión no válida.");

      const concepto = document.getElementById('inputConcepto').value;
      const metodo = document.getElementById('inputMetodo').value;
      const referencia = document.getElementById('inputReferencia').value.trim();
      const monto = parseFloat(document.getElementById('inputMonto').value);
      const mes = document.getElementById('inputMes').value;

      if (!referencia || isNaN(monto) || monto <= 0) {
        throw new Error("Ingresa monto y referencia válidos.");
      }

      // Guardamos método junto con el concepto para identificarlo claramente
      const { error } = await supabase.from('pagos').insert([{ 
        alumno_id: currentAlumno.id,
        metodo_pago: `${metodo} (${concepto})`,
        referencia: referencia,
        monto: monto,
        mes_correspondiente: mes,
        estado: 'revision'
      }]);

      if (error) throw error;

      sessionStorage.setItem('recordatorio_visto', 'true');
      msg.textContent = "¡Pago reportado con éxito!";
      msg.className = "text-sm font-bold uppercase italic text-center p-2 border border-lime-400 bg-lime-400/20 text-lime-400 block mt-2";
      
      setTimeout(() => { window.location.reload(); }, 1200);

    } catch (err) {
      console.error(err);
      msg.textContent = err.message || "Error al reportar pago.";
      msg.className = "text-sm font-bold uppercase italic text-center p-2 border border-pink-500 bg-pink-500/20 text-pink-500 block mt-2";
      msg.classList.remove('hidden');
      btn.textContent = "Enviar Reporte"; 
      btn.disabled = false;
    }
  });

  // Modal Edición
  const modalEditar = document.getElementById('modalEditar');
  document.getElementById('btnAbrirModalEditar')?.addEventListener('click', () => {
    document.getElementById('editNombre').value = (document.getElementById('uiNombreCompleto')?.textContent || '').toUpperCase();
    document.getElementById('editCedula').value = (window.currentCedula || '').toUpperCase();
    document.getElementById('editNacimiento').value = window.currentNacimientoRaw || '';
    document.getElementById('editEmail').value = (window.currentEmail || '').toLowerCase();
    document.getElementById('editTelefono').value = (document.getElementById('uiTelefono')?.textContent || '').toUpperCase();
    document.getElementById('editDireccion').value = (window.currentDireccion || '').toUpperCase();
    document.getElementById('editNivel').value = (document.getElementById('uiNivel')?.textContent || 'INTERMEDIO').toUpperCase();
    document.getElementById('editTipoSangre').value = window.currentTipoSangre || '';
    document.getElementById('editFotoFile').value = '';

    const bicis = window.currentBicicletas || [];
    if (bicis[0]) {
      document.getElementById('editBici1Tipo').value = bicis[0].tipo || 'MTB';
      document.getElementById('editBici1Rin').value = bicis[0].rin || '';
      document.getElementById('editBici1Marca').value = bicis[0].marca || '';
      document.getElementById('editBici1Color').value = bicis[0].color || '';
    }
    modalEditar.classList.remove('hidden');
  });

  document.getElementById('btnCerrarModalEditar')?.addEventListener('click', () => modalEditar.classList.add('hidden'));

  document.getElementById('formEditar')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnGuardarEdicion');
    btn.textContent = "GUARDANDO..."; 
    btn.disabled = true;

    try {
      const userId = currentUser.id;
      const { data: alumnoActual } = await supabase.from('alumnos').select('foto_url').eq('user_id', userId).single();
      let fotoUrlFinal = alumnoActual?.foto_url || '';
      const fotoFile = document.getElementById('editFotoFile').files[0];

      if (fotoFile) {
        const fileExt = fotoFile.name.split('.').pop();
        const fileName = `${userId}-${Date.now()}.${fileExt}`;
        const { error: uploadError } = await supabase.storage.from('fotos-atletas').upload(fileName, fotoFile, { upsert: true });
        if (uploadError) throw uploadError;
        const { data: publicUrlData } = supabase.storage.from('fotos-atletas').getPublicUrl(fileName);
        fotoUrlFinal = publicUrlData.publicUrl;
      }

      const listaBicicletas = [];
      const b1Tipo = document.getElementById('editBici1Tipo').value;
      if (b1Tipo) {
        listaBicicletas.push({
          tipo: b1Tipo,
          rin: document.getElementById('editBici1Rin').value.trim().toUpperCase(),
          marca: document.getElementById('editBici1Marca').value.trim().toUpperCase(),
          color: document.getElementById('editBici1Color').value.trim().toUpperCase()
        });
      }

      const { error } = await supabase.from('alumnos').update({
        nombre: document.getElementById('editNombre').value.trim().toUpperCase(),
        cedula: document.getElementById('editCedula').value.trim().toUpperCase(),
        fecha_nacimiento: document.getElementById('editNacimiento').value,
        email: document.getElementById('editEmail').value.trim().toLowerCase(),
        direccion: document.getElementById('editDireccion').value.trim().toUpperCase(),
        telefono: document.getElementById('editTelefono').value.trim().toUpperCase(),
        tipo_sangre: document.getElementById('editTipoSangre').value,
        nivel: document.getElementById('editNivel').value.toUpperCase(),
        foto_url: fotoUrlFinal,
        tipos_bici: listaBicicletas
      }).eq('user_id', userId);

      if (error) throw error;
      setTimeout(() => { window.location.reload(); }, 1000);
    } catch (err) {
      console.error(err);
      alert("Error al actualizar la ficha.");
      btn.textContent = "Guardar Cambios"; 
      btn.disabled = false;
    }
  });
</script>