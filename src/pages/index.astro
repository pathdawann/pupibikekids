---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Menú de Navegación -->
  <nav class="bg-black text-white p-4 border-b-4 border-lime-400 fixed w-full z-50">
    <div class="container mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-black italic tracking-wider text-white transform -skew-x-6">PUPI <span class="text-cyan-400">BIKE</span></h1>
      </div>
      <ul class="hidden md:flex space-x-6 items-center">
        <li><a href="#niveles" class="font-bold hover:text-cyan-400 transition italic uppercase">Niveles</a></li>
        <li><a href="#equipo" class="font-bold hover:text-lime-400 transition italic uppercase">Nuestro Equipo</a></li>
        <li><a href="/registro" class="bg-lime-400 text-black px-6 py-2 font-black italic uppercase tracking-wide hover:bg-lime-300 transition transform hover:scale-105 shadow-[4px_4px_0px_#00d2ff] border-2 border-transparent">¡Inscríbete!</a></li>
      </ul>
    </div>
  </nav>

 <!-- Hero Section -->
<header class="bg-zinc-950 pt-32 pb-24 lg:min-h-[95vh] flex items-center justify-center text-center relative overflow-hidden">
  
  <!-- 1. LA IMAGEN DE FONDO -->
  <!-- CAMBIA 'fondo-hero.jpg' por el nombre real de tu imagen -->
  <div class="absolute inset-0 bg-[url('/fondo-hero.jpg')] bg-cover bg-center opacity-30"></div>

  <!-- 2. LAS LUCES / FILTROS (Se mantienen intactos sobre la imagen) -->
  <div class="absolute top-0 left-0 w-80 h-80 bg-blue-700 rounded-full mix-blend-screen filter blur-[120px] opacity-40 z-10"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-lime-500 rounded-full mix-blend-screen filter blur-[120px] opacity-20 z-10"></div>

  <!-- 3. EL CONTENIDO DE TEXTO Y BOTONES -->
