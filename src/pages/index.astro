      </div>
      <p class="mb-10 text-xl font-bold text-black bg-white/90 inline-block px-6 py-2 transform -skew-x-6 shadow-lg">Déjanos tu correo y sé el primero en recibir invitaciones a nuestras rodadas.</p>
      
      <form id="leadForm" class="max-w-2xl mx-auto flex flex-col sm:flex-row gap-4">
        <input type="email" id="leadEmail" placeholder="TU CORREO ELECTRÓNICO" class="w-full px-6 py-4 text-black font-black italic uppercase transform -skew-x-6 focus:outline-none focus:ring-4 focus:ring-black shadow-[4px_4px_0px_rgba(0,0,0,0.8)]" required>
        <button type="submit" id="btnLead" class="bg-black text-lime-400 px-10 py-4 font-black italic uppercase transform -skew-x-6 hover:bg-zinc-900 hover:text-white transition shadow-[4px_4px_0px_rgba(0,0,0,0.8)] border-2 border-transparent">Avisarme</button>
      </form>
      <div class="mt-8 h-10">
        <p id="leadMensaje" class="text-lg font-black italic uppercase hidden px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] inline-block"></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('leadForm');
  const mensaje = document.getElementById('leadMensaje');
  const btnLead = document.getElementById('btnLead');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btnLead.textContent = "...";
    btnLead.disabled = true;
    const email = document.getElementById('leadEmail').value;
    try {
      const { error } = await supabase.from('leads_eventos').insert([{ email }]);
      if (error) {
        if (error.code === '23505') throw new Error('Este correo ya está registrado.');
        throw error;
      }
      form.reset();
      mensaje.textContent = "¡Listo! Te avisaremos de los eventos.";
      mensaje.className = "text-lg font-black italic uppercase px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] inline-block bg-lime-400 text-black block";
    } catch (error) {
      mensaje.textContent = error.message || "Hubo un error. Intenta de nuevo.";
      mensaje.className = "text-lg font-black italic uppercase px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] inline-block bg-red-600 text-white block";
    } finally {
      btnLead.textContent = "Avisarme";
      btnLead.disabled = false;
    }
  });
</script>