      Inscribirse en Intermedio →
    </a>
  </div>

  <!-- Nivel 3: Avanzado -->
  <div class="bg-zinc-950 p-8 border-2 border-pink-500 transform -skew-x-2 shadow-[8px_8px_0px_#db2777] hover:-translate-y-2 transition-transform flex flex-col justify-between">
    <div>
      <h3 class="text-2xl font-black italic uppercase text-pink-500 mb-4 tracking-wider">Avanzado</h3>
      <ul class="text-zinc-200 font-medium space-y-3 mb-6">
