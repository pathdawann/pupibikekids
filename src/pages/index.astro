---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navegación Principal Responsiva y Adaptada -->
<nav class="bg-black text-white p-4 border-b-4 border-lime-400 sticky top-0 z-50">
  <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center gap-4">
    
    <!-- Logo con flex-shrink-0 para evitar aplastamiento -->
    <a href="/" class="text-2xl lg:text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition flex-shrink-0">
      PUPIBIKE 
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
    </a>

    <!-- Enlaces de Escritorio (Visibles solo a partir de 1024px / lg) -->
    <ul class="hidden lg:flex space-x-3 xl:space-x-4 items-center flex-shrink-0">
      <li>
        <a href="#niveles" class="bg-zinc-900 border border-zinc-700 hover:border-cyan-400 text-zinc-200 hover:text-cyan-400 px-3.5 py-2 font-black italic uppercase text-xs tracking-wider transition transform -skew-x-6 hover:-translate-y-0.5">
          Niveles
        </a>
      </li>
      <li>
        <a href="#equipo" class="bg-zinc-900 border border-zinc-700 hover:border-lime-400 text-zinc-200 hover:text-lime-400 px-3.5 py-2 font-black italic uppercase text-xs tracking-wider transition transform -skew-x-6 hover:-translate-y-0.5">
          Equipo
        </a>
      </li>
      <li>
        <a href="/login" class="text-cyan-400 border-2 border-cyan-400 px-5 py-2 font-black italic uppercase tracking-wide hover:bg-cyan-400 hover:text-black transition transform hover:scale-105 shadow-[4px_4px_0px_#00d2ff] text-xs">
          Ingresar
        </a>
      </li>
      <li>
        <a href="/registro" class="bg-lime-400 text-black px-5 py-2 font-black italic uppercase tracking-wide hover:bg-lime-300 transition transform hover:scale-105 shadow-[4px_4px_0px_#db2777] text-xs">
          ¡Inscríbete!
        </a>
      </li>
    </ul>

    <!-- Botón Hamburguesa (Visible en Móvil y Tablet: hasta 1023px) -->
    <button id="btnMenuMobile" aria-label="Abrir menú" class="lg:hidden text-lime-400 focus:outline-none p-2 border border-lime-400 flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable (Móvil y Tablet) -->
  <div id="menuMobile" class="hidden lg:hidden bg-zinc-950 border-t border-zinc-800 px-4 pt-4 pb-6 flex flex-col gap-3 mt-4 shadow-xl">
    <a href="#niveles" class="text-white font-black uppercase italic text-base hover:text-lime-400 transition py-1">Niveles</a>
    <a href="#equipo" class="text-white font-black uppercase italic text-base hover:text-cyan-400 transition py-1">Equipo</a>
    <a href="/login" class="text-center text-cyan-400 border-2 border-cyan-400 py-3 font-black italic uppercase tracking-wide hover:bg-cyan-400 hover:text-black transition shadow-[4px_4px_0px_#00d2ff]">Ingresar</a>
    <a href="/registro" class="text-center bg-lime-400 text-black py-3 font-black italic uppercase tracking-wide hover:bg-lime-300 transition shadow-[4px_4px_0px_#db2777]">¡Inscríbete!</a>
  </div>
</nav>

  <!-- Hero Section -->
  <header class="bg-zinc-950 pt-32 pb-24 lg:min-h-[85vh] flex items-center justify-center text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/fondo-hero.jpg')] bg-cover bg-center opacity-30"></div>
    <div class="absolute top-0 left-0 w-80 h-80 bg-blue-700 rounded-full mix-blend-screen filter blur-[120px] opacity-40 z-10"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-lime-500 rounded-full mix-blend-screen filter blur-[120px] opacity-20 z-10"></div>

    <div class="container mx-auto px-4 max-w-7xl relative z-20 w-full">
      <!-- 1. Texto pequeño superior ("REGRESO A CLASES") -->
