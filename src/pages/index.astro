---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navegación Principal Responsiva -->
<nav class="bg-black text-white p-4 border-b-4 border-lime-400 sticky top-0 z-50">
  <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
    <a href="/" class="text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
      PUPI BIKE 
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
    </a>

    <!-- Enlaces para Escritorio -->
    <ul class="hidden md:flex space-x-6 items-center">
      <li><a href="#niveles" class="font-bold hover:text-cyan-400 transition uppercase italic text-sm">Niveles</a></li>
      <li><a href="#equipo" class="font-bold hover:text-cyan-400 transition uppercase italic text-sm">Equipo</a></li>
      <li><a href="/login" class="text-cyan-400 border-2 border-cyan-400 px-6 py-2 font-black italic uppercase tracking-wide hover:bg-cyan-400 hover:text-black transition transform hover:scale-105 shadow-[4px_4px_0px_#00d2ff]">Ingresar</a></li>
      <li><a href="/registro" class="bg-lime-400 text-black px-6 py-2 font-black italic uppercase tracking-wide hover:bg-lime-300 transition transform hover:scale-105 shadow-[4px_4px_0px_#db2777]">¡Inscríbete!</a></li>
    </ul>

    <!-- Botón Hamburguesa para Móvil -->
    <button id="btnMenuMobile" class="md:hidden text-lime-400 focus:outline-none p-2 border border-lime-400">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Móvil (Oculto por defecto) -->
  <div id="menuMobile" class="hidden md:hidden bg-zinc-950 border-t border-zinc-800 px-4 pt-4 pb-6 flex flex-col gap-4 mt-4 shadow-xl">
    <a href="#niveles" class="text-white font-bold uppercase italic text-lg hover:text-cyan-400 transition">Niveles</a>
    <a href="#equipo" class="text-white font-bold uppercase italic text-lg hover:text-cyan-400 transition">Equipo</a>
    <a href="/login" class="text-center text-cyan-400 border-2 border-cyan-400 py-3 font-black italic uppercase tracking-wide hover:bg-cyan-400 hover:text-black transition shadow-[4px_4px_0px_#00d2ff]">Ingresar</a>
    <a href="/registro" class="text-center bg-lime-400 text-black py-3 font-black italic uppercase tracking-wide hover:bg-lime-300 transition shadow-[4px_4px_0px_#db2777]">¡Inscríbete!</a>
  </div>
</nav>

  <!-- Hero Section -->
  <header class="bg-zinc-950 pt-32 pb-24 lg:min-h-[85vh] flex items-center justify-center text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/fondo-hero.jpg')] bg-cover bg-center opacity-30"></div>
    <div class="absolute top-0 left-0 w-80 h-80 bg-blue-700 rounded-full mix-blend-screen filter blur-[120px] opacity-40 z-10"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-lime-500 rounded-full mix-blend-screen filter blur-[120px] opacity-20 z-10"></div>

    <div class="container mx-auto px-4 max-w-7xl relative z-20 w-full">
      <h3 class="text-lime-400 font-black text-2xl md:text-4xl italic uppercase tracking-widest mb-4 transform -skew-x-12 drop-shadow-md">Regreso a Clases</h3>
      <h2 class="text-5xl md:text-7xl lg:text-8xl font-black text-white mb-6 uppercase italic tracking-tighter leading-tight">Formando a los futuros <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-cyan-400 to-lime-400">campeones del MTB</span></h2>
      <p class="text-xl lg:text-2xl text-zinc-300 mb-8 max-w-3xl mx-auto font-medium bg-black/50 p-4 rounded-xl border border-zinc-800 backdrop-blur-sm">Temporada 2026-2027. Enseñamos técnica, disciplina y pasión por el ciclismo para niños y jóvenes en un ambiente seguro y extremo.</p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-8 mt-12">
        <a href="/registro" class="bg-blue-600 text-white text-2xl font-black italic uppercase px-10 py-5 shadow-[6px_6px_0px_#a3e635] hover:translate-y-1 hover:shadow-[2px_2px_0px_#a3e635] transition-all transform -skew-x-6 border-2 border-transparent">Únete a la Academia</a>
        <a href="https://wa.me/584248781128" target="_blank" class="text-white font-black italic text-3xl flex items-center gap-2 hover:text-lime-400 transition drop-shadow-lg">
          <span class="text-lime-400 text-5xl">✆</span> 58 424-8781128
        </a>
      </div>
    </div>
  </header>

  <!-- SECCIÓN: Niveles -->
  <section id="niveles" class="py-24 bg-zinc-900 border-t border-zinc-800 relative">
    <div class="container mx-auto px-4 max-w-7xl relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-black uppercase italic text-white transform -skew-x-6 drop-shadow-md">Nuestros <span class="text-pink-500">Niveles</span></h2>
        <p class="text-zinc-400 mt-4 font-bold italic text-lg">El plan perfecto para cada etapa de su desarrollo deportivo.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Nivel 1 -->
        <div class="bg-zinc-950 p-8 border-2 border-cyan-400 transform -skew-x-2 shadow-[8px_8px_0px_#00d2ff] hover:-translate-y-2 transition-transform">
          <h3 class="text-2xl font-black italic uppercase text-cyan-400 mb-4 tracking-wider">Principiante</h3>
          <ul class="text-zinc-300 font-medium space-y-3 mb-6">
            <li>✓ Dominio de rueditas y equilibrio.</li>
            <li>✓ Fundamentos de seguridad y frenado.</li>
            <li>✓ Juegos y adaptación a la bicicleta.</li>
          </ul>
          <div class="bg-zinc-900 p-3 text-sm font-bold italic text-center border border-zinc-800 text-white">Ideal para los más pequeños</div>
        </div>

        <!-- Nivel 2 -->
        <div class="bg-zinc-950 p-8 border-2 border-lime-400 transform -skew-x-2 shadow-[8px_8px_0px_#a3e635] hover:-translate-y-2 transition-transform md:-mt-4">
          <h3 class="text-2xl font-black italic uppercase text-lime-400 mb-4 tracking-wider">Intermedio</h3>
          <ul class="text-zinc-300 font-medium space-y-3 mb-6">
            <li>✓ Iniciación al Mountain Bike (MTB).</li>
            <li>✓ Postura y superación de obstáculos.</li>
            <li>✓ Rutas guiadas de resistencia media.</li>
          </ul>
          <div class="bg-zinc-900 p-3 text-sm font-bold italic text-center border border-zinc-800 text-white">Desarrollo de resistencia y técnica</div>
        </div>

        <!-- Nivel 3 -->
        <div class="bg-zinc-950 p-8 border-2 border-pink-500 transform -skew-x-2 shadow-[8px_8px_0px_#db2777] hover:-translate-y-2 transition-transform">
          <h3 class="text-2xl font-black italic uppercase text-pink-500 mb-4 tracking-wider">Avanzado</h3>
          <ul class="text-zinc-300 font-medium space-y-3 mb-6">
            <li>✓ Preparación física para competencia.</li>
            <li>✓ Técnicas avanzadas de ruta y descenso.</li>
            <li>✓ Turno académico: <span class="text-yellow-400">Lunes a Viernes</span>.</li>
          </ul>
          <div class="bg-pink-600 p-3 text-sm font-black uppercase italic text-center text-white">Horario: 4:00 pm a 6:00 pm</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN INTERMEDIA: Slider Fotográfico 95vh -->
  <section class="relative w-full h-[85vh] overflow-hidden border-t-8 border-b-8 border-black">
    <div class="absolute inset-0 bg-black/40 z-20 pointer-events-none"></div>
    <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-zinc-950 to-transparent z-20 pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-zinc-950 to-transparent z-20 pointer-events-none"></div>

    <div id="slide-0" class="absolute inset-0 bg-[url('/galeria/1.jpg')] bg-cover bg-center transition-opacity duration-1000 opacity-100 z-10"></div>
    <div id="slide-1" class="absolute inset-0 bg-[url('/galeria/2.jpg')] bg-cover bg-center transition-opacity duration-1000 opacity-0 z-0"></div>
    <div id="slide-2" class="absolute inset-0 bg-[url('/galeria/3.jpg')] bg-cover bg-center transition-opacity duration-1000 opacity-0 z-0"></div>
    <div id="slide-3" class="absolute inset-0 bg-[url('/galeria/4.jpg')] bg-cover bg-center transition-opacity duration-1000 opacity-0 z-0"></div>
    <div id="slide-4" class="absolute inset-0 bg-[url('/galeria/5.jpg')] bg-cover bg-center transition-opacity duration-1000 opacity-0 z-0"></div>
  </section>

  <!-- SECCIÓN: Nuestro Equipo -->
  <section id="equipo" class="py-24 bg-zinc-950 relative border-t-4 border-cyan-500 overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-pink-600 rounded-full mix-blend-screen filter blur-[100px] opacity-10 pointer-events-none"></div>
    
    <div class="container mx-auto px-4 max-w-7xl relative z-10 text-center mb-16">
      <div class="bg-black inline-block px-10 py-3 transform -skew-x-6 shadow-[6px_6px_0px_#00d2ff] border border-zinc-800">
        <h2 class="text-4xl font-black uppercase italic text-white tracking-wider">Nuestro <span class="text-cyan-400">Equipo</span></h2>
      </div>
    </div>

    <!-- 1. FUNDADORES -->
    <div class="container mx-auto px-4 max-w-7xl relative z-10 mb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <!-- Fundador 1 -->
        <div class="bg-zinc-900 p-8 border-2 border-lime-400 shadow-[8px_8px_0px_#a3e635] transform -skew-x-2 flex flex-col xl:flex-row items-center gap-8 group hover:-translate-y-2 transition-transform">
          <div class="w-48 h-48 flex-shrink-0 rounded-full overflow-hidden border-4 border-cyan-400 transform skew-x-2 shadow-lg">
            <img src="/instructores/cesarbarrios.png" alt="Cesar Barrios" class="w-full h-full object-cover bg-zinc-800" />          </div>
          <div class="text-center xl:text-left transform skew-x-2 flex-1">
            <h3 class="text-3xl font-black italic uppercase text-white mb-1">Cesar "Pupi" Barrios</h3>
            <p class="text-cyan-400 font-bold italic uppercase text-sm mb-4">Fundador</p>
            <p class="text-zinc-400 text-sm mb-6 leading-relaxed">Apasionado del MTB con años de experiencia formando atletas. Su visión es construir la academia de ciclismo más grande y extrema, priorizando siempre la técnica y la seguridad de los futuros campeones.</p>
            <div class="inline-block bg-black px-6 py-2 border border-zinc-800">
              <p class="text-lime-400 font-black text-xs tracking-wider">@pupibike_kids</p>
            </div>
          </div>
        </div>

        <!-- Fundadora 2 -->
        <div class="bg-zinc-900 p-8 border-2 border-pink-500 shadow-[8px_8px_0px_#db2777] transform -skew-x-2 flex flex-col xl:flex-row items-center gap-8 group hover:-translate-y-2 transition-transform">
          <div class="w-48 h-48 flex-shrink-0 rounded-full overflow-hidden border-4 border-cyan-400 transform skew-x-2 shadow-lg">
            <img src="/instructores/jesusdiaz.png" alt="Jesus Diaz" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <div class="text-center xl:text-left transform skew-x-2 flex-1">
            <h3 class="text-3xl font-black italic uppercase text-white mb-1">Jesus "Chumbo" Diaz</h3>
            <p class="text-pink-500 font-bold italic uppercase text-sm mb-4">Co-Fundador</p>
            <p class="text-zinc-400 text-sm mb-6 leading-relaxed">Especialista en pedagogía deportiva y desarrollo infantil. Se encarga de que cada entrenamiento sea una aventura inolvidable, combinando disciplina, diversión y compañerismo en cada rodada.</p>
            <div class="inline-block bg-black px-6 py-2 border border-zinc-800">
              <p class="text-cyan-400 font-black text-xs tracking-wider">@chumbobike4</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. INSTRUCTORES -->
    <div class="container mx-auto px-4 max-w-7xl relative z-10">
      <div class="flex overflow-x-auto lg:overflow-visible lg:grid lg:grid-cols-4 gap-8 pb-4 snap-x snap-mandatory [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
        
        <!-- FILA 1 -->
        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-lime-400 shadow-[6px_6px_0px_#a3e635] transform -skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-pink-500 mb-4 transform skew-x-2">
            <img src="/equipo/jorpierre.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform skew-x-2">Jorpierre</h3>
          <p class="text-lime-400 font-bold italic uppercase transform skew-x-2 text-sm mb-3">Nivel Básico</p>
          <div class="bg-black px-4 py-2 transform skew-x-2 w-full text-center border border-zinc-800"><p class="text-pink-500 font-black text-xs tracking-wider">@jorpierre_lopez</p></div>
        </div>

        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-cyan-400 shadow-[6px_6px_0px_#00d2ff] transform -skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-lime-400 mb-4 transform skew-x-2">
            <img src="/equipo/yuliandrys.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform skew-x-2">Yuliandrys</h3>
          <p class="text-cyan-400 font-bold italic uppercase transform skew-x-2 text-sm mb-3">Nivel Balance</p>
          <div class="bg-black px-4 py-2 transform skew-x-2 w-full text-center border border-zinc-800"><p class="text-lime-400 font-black text-xs tracking-wider">@yuli22012009</p></div>
        </div>

        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-pink-500 shadow-[6px_6px_0px_#db2777] transform -skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-cyan-400 mb-4 transform skew-x-2">
            <img src="/equipo/jesus.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform skew-x-2">Jesús</h3>
          <p class="text-pink-500 font-bold italic uppercase transform skew-x-2 text-xs mb-3 text-center">Básico/Inter/Avanzado</p>
          <div class="bg-black px-4 py-2 transform skew-x-2 w-full text-center border border-zinc-800"><p class="text-cyan-400 font-black text-xs tracking-wider">@chumbobike4</p></div>
        </div>

        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-lime-400 shadow-[6px_6px_0px_#a3e635] transform -skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-pink-500 mb-4 transform skew-x-2">
            <img src="/equipo/junior.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform skew-x-2">Junior</h3>
          <p class="text-lime-400 font-bold italic uppercase transform skew-x-2 text-sm mb-3">Nivel Balance</p>
          <div class="bg-black px-4 py-2 transform skew-x-2 w-full text-center border border-zinc-800"><p class="text-pink-500 font-black text-xs tracking-wider">@jr.juniortalentoficial</p></div>
        </div>
        
        <!-- FILA 2 -->
        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-cyan-400 shadow-[6px_6px_0px_#00d2ff] transform skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-lime-400 mb-4 transform -skew-x-2">
            <img src="/equipo/adrian.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform -skew-x-2">Adrián</h3>
          <p class="text-cyan-400 font-bold italic uppercase transform -skew-x-2 text-sm mb-3">Nivel Básico</p>
          <div class="bg-black px-4 py-2 transform -skew-x-2 w-full text-center border border-zinc-800"><p class="text-lime-400 font-black text-xs tracking-wider">@adr_ianlopez22</p></div>
        </div>

        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-pink-500 shadow-[6px_6px_0px_#db2777] transform skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-cyan-400 mb-4 transform -skew-x-2">
            <img src="/equipo/manzul.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform -skew-x-2">Manzul</h3>
          <p class="text-pink-500 font-bold italic uppercase transform -skew-x-2 text-sm mb-3">Básico / Avanzado</p>
          <div class="bg-black px-4 py-2 transform -skew-x-2 w-full text-center border border-zinc-800"><p class="text-cyan-400 font-black text-xs tracking-wider">@manzul_jos</p></div>
        </div>

        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-lime-400 shadow-[6px_6px_0px_#a3e635] transform skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-pink-500 mb-4 transform -skew-x-2">
            <img src="/equipo/david.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform -skew-x-2">David</h3>
          <p class="text-lime-400 font-bold italic uppercase transform -skew-x-2 text-sm mb-3">Nivel Avanzado</p>
          <div class="bg-black px-4 py-2 transform -skew-x-2 w-full text-center border border-zinc-800"><p class="text-pink-500 font-black text-xs tracking-wider">@matadavid_07</p></div>
        </div>

        <div class="w-[280px] lg:w-auto flex-shrink-0 snap-center flex flex-col items-center bg-zinc-900 p-6 border-2 border-cyan-400 shadow-[6px_6px_0px_#00d2ff] transform skew-x-2 group hover:-translate-y-2 transition-transform">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-lime-400 mb-4 transform -skew-x-2">
            <img src="/equipo/maximo.png" class="w-full h-full object-cover bg-zinc-800" />
          </div>
          <h3 class="text-2xl font-black italic uppercase text-white mb-1 transform -skew-x-2">Máximo</h3>
          <p class="text-cyan-400 font-bold italic uppercase transform -skew-x-2 text-xs mb-3 text-center">Balance / Estímulo</p>
          <div class="bg-black px-4 py-2 transform -skew-x-2 w-full text-center border border-zinc-800"><p class="text-lime-400 font-black text-xs tracking-wider">Instructor</p></div>
        </div>
      </div>
      <p class="text-zinc-500 mt-4 font-bold italic lg:hidden uppercase tracking-wider text-center">⟵ Desliza para conocerlos ⟶</p>
    </div>
  </section>

  <!-- NUEVA SECCIÓN: Actividades del Mes -->
  <section id="actividades" class="py-24 bg-zinc-900 relative border-t-4 border-lime-400">
    <div class="container mx-auto px-4 max-w-7xl relative z-10">
      <div class="text-center mb-16">
        <div class="bg-black inline-block px-10 py-3 transform -skew-x-6 shadow-[6px_6px_0px_#a3e635] border border-zinc-800">
          <h2 class="text-4xl font-black uppercase italic text-white tracking-wider">Actividades del <span class="text-lime-400">Mes</span></h2>
        </div>
        <p class="text-zinc-400 mt-6 font-bold italic text-lg">No te pierdas nuestros próximos eventos y rutas especiales.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-zinc-950 p-6 border-l-4 border-cyan-400 shadow-lg transform hover:-translate-y-2 transition-transform">
          <div class="text-cyan-400 font-black text-2xl mb-2">15 OCT</div>
          <h3 class="text-xl font-bold text-white mb-2 uppercase italic">Ruta Nocturna Familiar</h3>
          <p class="text-zinc-400 text-sm mb-4">Un recorrido seguro y divertido por la ciudad para todas las edades. ¡Trae tus luces!</p>
          <span class="inline-block bg-zinc-800 text-xs px-3 py-1 font-bold text-white rounded">Nivel: Todos</span>
        </div>
        <div class="bg-zinc-950 p-6 border-l-4 border-pink-500 shadow-lg transform hover:-translate-y-2 transition-transform">
          <div class="text-pink-500 font-black text-2xl mb-2">22 OCT</div>
          <h3 class="text-xl font-bold text-white mb-2 uppercase italic">Clínica de Saltos</h3>
          <p class="text-zinc-400 text-sm mb-4">Aprende la técnica correcta para despegar y aterrizar con seguridad en nuestra pista.</p>
          <span class="inline-block bg-zinc-800 text-xs px-3 py-1 font-bold text-white rounded">Nivel: Inter/Avanzado</span>
        </div>
        <div class="bg-zinc-950 p-6 border-l-4 border-lime-400 shadow-lg transform hover:-translate-y-2 transition-transform md:col-span-2 lg:col-span-1">
          <div class="text-lime-400 font-black text-2xl mb-2">30 OCT</div>
          <h3 class="text-xl font-bold text-white mb-2 uppercase italic">Competencia Halloween</h3>
          <p class="text-zinc-400 text-sm mb-4">Ven disfrazado y demuestra lo que has aprendido. Premios sorpresa para los mejores.</p>
          <span class="inline-block bg-zinc-800 text-xs px-3 py-1 font-bold text-white rounded">Nivel: Todos</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN: Toldo / Leads -->
