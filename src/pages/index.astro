<script>

// Script rápido para alternar el menú en celulares
  const btnMenuMobile = document.getElementById('btnMenuMobile');
  const menuMobile = document.getElementById('menuMobile');

  if (btnMenuMobile && menuMobile) {
    btnMenuMobile.addEventListener('click', () => {
      menuMobile.classList.toggle('hidden');
    });
  }

  import { supabase } from '../lib/supabase.js';

  // LÓGICA DEL FORMULARIO DE LEADS
  const form = document.getElementById('leadForm');
  const mensaje = document.getElementById('leadMensaje');
  const btnLead = document.getElementById('btnLead');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnLead.textContent = "...";
      btnLead.disabled = true;

      const email = document.getElementById('leadEmail').value;

      try {
        const { error } = await supabase.from('leads_eventos').insert([{ email }]);
        if (error) {
          if (error.code === '23505') throw new Error('Este correo ya está registrado.');
          throw error;
        }
        form.reset();
        mensaje.textContent = "¡Listo! Te avisaremos de los eventos.";
        mensaje.className = "text-lg font-black italic uppercase px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] inline-block bg-lime-400 text-black block mt-4";
      } catch (error) {
        mensaje.textContent = error.message || "Hubo un error. Intenta de nuevo.";
        mensaje.className = "text-lg font-black italic uppercase px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] inline-block bg-red-600 text-white block mt-4";
      } finally {
        btnLead.textContent = "Avisarme";
        btnLead.disabled = false;
      }
    });
  }

  // LÓGICA DEL SLIDER FOTOGRÁFICO
  let currentSlide = 0;
  const totalSlides = 5;

  setInterval(() => {
    const oldSlide = document.getElementById(`slide-${currentSlide}`);
    if(oldSlide) {
        oldSlide.classList.remove('opacity-100', 'z-10');
        oldSlide.classList.add('opacity-0', 'z-0');
    }

    currentSlide = (currentSlide + 1) % totalSlides;

    const newSlide = document.getElementById(`slide-${currentSlide}`);
    if(newSlide) {
        newSlide.classList.remove('opacity-0', 'z-0');
        newSlide.classList.add('opacity-100', 'z-10');
    }
  }, 8000);
</script>