---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin - Cambibara Race">
  <nav class="bg-black text-white p-4 border-b-2 border-green-500">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <div class="flex items-center gap-4">
        <a href="/" class="text-xl font-black italic tracking-wider text-white transform -skew-x-6">
          PUPIBIKE <span class="text-green-500">ADMIN</span>
        </a>
        <span class="text-zinc-600 font-black">|</span>
        <span class="text-zinc-400 font-bold text-sm tracking-widest uppercase">Cambibara Race</span>
      </div>
      <a href="/admin" class="text-zinc-400 hover:text-green-500 font-bold text-xs transition">
        VOLVER AL PANEL
      </a>
    </div>
  </nav>

  <main class="bg-[#0a0a0a] min-h-screen py-10">
    <div class="container mx-auto px-4 max-w-7xl">
      
      <!-- Cabecera y Botón de Exportación -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4 border-b border-zinc-800 pb-6">
        <div>
          <h1 class="text-3xl font-black text-white uppercase italic transform -skew-x-6 tracking-tight mb-2">
            Inscripciones <span class="text-green-500">Cambibara</span>
          </h1>
          <p class="text-zinc-400 text-sm font-medium">Total de atletas registrados: <span id="totalAtletas" class="text-green-500 font-black text-lg">0</span></p>
        </div>
        
        <button id="btnExportarCSV" class="bg-zinc-900 border border-green-500 text-green-500 hover:bg-green-500 hover:text-black font-black uppercase text-xs px-6 py-3 transition-colors flex items-center gap-2 focus:outline-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Exportar a CSV / Excel
        </button>
      </div>

      <!-- Tabla de Datos -->
      <div class="bg-[#0f0f0f] border border-zinc-800 overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-black border-b border-zinc-800">
              <th class="p-4 text-xs font-black text-zinc-500 uppercase tracking-wider">Fecha R.</th>
              <th class="p-4 text-xs font-black text-zinc-500 uppercase tracking-wider">Atleta</th>
              <th class="p-4 text-xs font-black text-zinc-500 uppercase tracking-wider">Categoría</th>
              <th class="p-4 text-xs font-black text-zinc-500 uppercase tracking-wider">Contacto</th>
              <th class="p-4 text-xs font-black text-zinc-500 uppercase tracking-wider">Pago</th>
              <th class="p-4 text-xs font-black text-zinc-500 uppercase tracking-wider text-center">Capture</th>
            </tr>
          </thead>
          <tbody id="tablaInscripciones" class="divide-y divide-zinc-800">
            <!-- Los datos se inyectarán aquí -->
            <tr>
              <td colspan="6" class="p-8 text-center text-zinc-500 font-bold text-sm">Cargando inscripciones...</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  let inscripcionesData = [];

  // 1. Cargar datos desde Supabase
  async function cargarInscripciones() {
    try {
      const { data, error } = await supabase
        .from('inscripciones_cambibara')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;
      
      inscripcionesData = data;
      document.getElementById('totalAtletas').textContent = data.length;
      renderizarTabla(data);

    } catch (error) {
      console.error("Error cargando inscripciones:", error);
      document.getElementById('tablaInscripciones').innerHTML = `
        <tr><td colspan="6" class="p-8 text-center text-red-500 font-bold text-sm">Error de conexión al cargar los datos. Verifique sus permisos.</td></tr>
      `;
    }
  }

  // 2. Dibujar la tabla en HTML
  function renderizarTabla(data) {
    const tbody = document.getElementById('tablaInscripciones');
    
    if (data.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-zinc-500 font-bold text-sm">No hay inscripciones registradas aún.</td></tr>`;
      return;
    }

    tbody.innerHTML = data.map(reg => {
      const fechaRegistro = new Date(reg.created_at).toLocaleDateString('es-VE');
      
      return `
        <tr class="hover:bg-zinc-900/50 transition-colors">
          <td class="p-4 text-sm text-zinc-400 font-medium whitespace-nowrap">${fechaRegistro}</td>
          <td class="p-4">
            <div class="text-white font-bold text-base uppercase">${reg.nombre} ${reg.apellido}</div>
            <div class="text-green-500 text-sm font-black mt-0.5">V-${reg.cedula}</div>
          </td>
          <td class="p-4">
            <span class="bg-green-500/10 text-white-500 border border-green-500/20 px-3 py-1.5 text-xs font-black uppercase tracking-wider rounded-sm inline-block">
              ${reg.categoria}
            </span>
            <div class="text-green-500 text-sm uppercase mt-2 font-bold">${reg.genero}</div>
          </td>
          <td class="p-4">
            <div class="text-zinc-300 text-sm font-bold">${reg.telefono}</div>
            <div class="text-green-500 text-sm truncate max-w-[200px] mt-0.5">${reg.email}</div>
          </td>
          <td class="p-4">
            <div class="text-white text-sm font-bold uppercase">${reg.metodo_pago}</div>
            <div class="text-green-500 text-sm font-mono mt-0.5">Ref: ${reg.referencia}</div>
          </td>
          <td class="p-4 text-center">
            ${reg.comprobante_url && reg.comprobante_url.trim() !== ""
              ? `<a href="${reg.comprobante_url}" target="_blank" class="inline-block bg-zinc-800 border border-green-500 text-green-500 hover:bg-green-500 hover:text-black font-black text-xs uppercase px-4 py-2 transition-colors rounded-sm">VER PAGO</a>` 
              : `<span class="bg-zinc-900 border border-zinc-800 text-zinc-600 px-3 py-1 text-xs font-bold uppercase rounded-sm">N/A</span>`
            }
          </td>
        </tr>
      `;
    }).join('');
  }

  // 3. Lógica para exportar a CSV
  document.getElementById('btnExportarCSV').addEventListener('click', () => {
    if (inscripcionesData.length === 0) {
      alert("No hay datos para exportar.");
      return;
    }

    // Cabeceras del CSV (Separadas por punto y coma para que Excel en español lo lea directo)
    const cabeceras = [
      "Fecha Registro", "Nombre", "Apellido", "Cedula", "Fecha Nacimiento", 
      "Genero", "Categoria", "Email", "Telefono", "Estado", "Ciudad", 
      "Metodo Pago", "Referencia", "Fecha Pago", "Enlace Comprobante"
    ];

    // Mapear los datos de Supabase a las columnas
    const filas = inscripcionesData.map(reg => [
      new Date(reg.created_at).toLocaleDateString('es-VE'),
      reg.nombre,
      reg.apellido,
      reg.cedula,
      reg.fecha_nacimiento,
      reg.genero,
      reg.categoria,
      reg.email,
      reg.telefono,
      reg.estado,
      reg.ciudad,
      reg.metodo_pago,
      reg.referencia,
      reg.fecha_pago,
      reg.comprobante_url
    ]);

    // Unir cabeceras y filas con punto y coma (;)
    const contenidoCSV = [
      cabeceras.join(';'),
      ...filas.map(fila => fila.map(campo => `"${campo || ''}"`).join(';'))
    ].join('\n');

    // Crear el archivo descargable
    const blob = new Blob(["\ufeff" + contenidoCSV], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    
    link.setAttribute("href", url);
    link.setAttribute("download", `Inscripciones_Cambibara_${new Date().toLocaleDateString('es-VE').replace(/\//g, '-')}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Inicializar
  document.addEventListener('DOMContentLoaded', cargarInscripciones);
</script>