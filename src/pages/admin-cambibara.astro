---
import Layout from '../layouts/Layout.astro';
import { supabaseServer } from '../lib/supabase-server.js';

// 1. Inicializamos cliente de servidor
const supabase = supabaseServer(Astro);

// 2. Verificamos que exista una sesión activa
const { data: { user }, error } = await supabase.auth.getUser();

if (!user || error) {
  return Astro.redirect('/login');
}

// 3. Verificamos autorización administrativa y roles
const correosAutorizados = ["pathdawann@gmail.com", "pupibikekids27@gmail.com"];
if (!user.email || !correosAutorizados.includes(user.email)) {
  return Astro.redirect('/dashboard');
}

// Solo Patricia Mago tiene permisos de borrado permanente
const esSuperAdmin = user.email === "pathdawann@gmail.com";
---

<Layout title="Admin - Cambibara Race | Pupi Bike Kids" noindex={true}>
  <main id="adminCambibaraContenido" data-superadmin={esSuperAdmin ? "true" : "false"} class="bg-zinc-950 text-white min-h-screen p-6 md:p-10">
    
    <!-- ENCABEZADO -->
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10 border-b border-zinc-800 pb-6">
      <div>
        <span class="text-green-500 font-black tracking-widest uppercase text-xs">PUPIBIKE ADMIN</span>
        <h1 class="text-3xl md:text-4xl font-black italic uppercase tracking-wider text-white">
          CAMBIBARA <span class="text-green-500">RACE</span>
        </h1>
      </div>
      <div class="flex items-center gap-4">
        <a href="/admin" class="text-green-400 font-black italic uppercase text-xs border border-green-500 px-4 py-2.5 hover:bg-green-500 hover:text-black transition">
          ← Volver al Panel
        </a>
      </div>
    </div>

    <div class="max-w-7xl mx-auto space-y-8">

      <!-- TARJETA DE DATOS BANCARIOS PARA COMPARTIR / COPIAR -->
      <div class="bg-zinc-900 border-2 border-green-500 p-6 shadow-[6px_6px_0px_#22c55e] flex flex-col md:flex-row justify-between items-center gap-6">
        <div>
          <h3 class="text-green-400 font-black italic uppercase text-lg mb-1">💳 Datos de Pago para Compartir</h3>
          <p class="text-zinc-400 text-xs md:text-sm">Haz clic en el botón para copiar la información completa y enviarla por WhatsApp.</p>
        </div>
        <button id="btnCopiarDatosPago" class="bg-black border border-green-500 text-green-400 px-6 py-3 font-black italic uppercase text-xs tracking-wider hover:bg-green-500 hover:text-black transition shadow-[3px_3px_0px_#22c55e]">
          📋 Copiar Datos Bancarios
        </button>
      </div>

      <!-- MÉTRICAS Y CONTADORES -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-zinc-900 p-6 border-l-4 border-green-500 border-y border-r border-zinc-800 shadow-md">
          <span class="text-zinc-400 text-xs font-black uppercase tracking-wider block mb-1">Total de Atletas Registrados</span>
          <p id="contadorAtletas" class="text-4xl font-black italic text-white">0</p>
        </div>
        <div class="bg-zinc-900 p-6 border-l-4 border-green-500 border-y border-r border-zinc-800 shadow-md">
          <span class="text-zinc-400 text-xs font-black uppercase tracking-wider block mb-1">Total Dinero Generado ($8.00 c/u)</span>
          <p id="contadorDinero" class="text-4xl font-black italic text-green-500">$0.00 USD</p>
        </div>
      </div>

      <!-- CONTROLES Y FILTROS -->
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 bg-zinc-900 p-4 border border-zinc-800">
        <div class="flex items-center gap-3 w-full md:w-auto">
          <label for="filtroCategoria" class="text-xs font-black uppercase text-zinc-400">Filtrar Categoría:</label>
          <select id="filtroCategoria" class="bg-zinc-950 text-white border border-zinc-700 px-4 py-2 font-bold uppercase text-xs focus:border-green-500 focus:outline-none">
            <option value="TODAS">Todas las Categorías</option>
            <option value="Balance">Balance</option>
            <option value="5 y 6 años">5 y 6 años</option>
            <option value="7 y 8 años">7 y 8 años</option>
            <option value="9 y 10 años">9 y 10 años</option>
            <option value="11 y 12 años">11 y 12 años</option>
            <option value="13 y 14 años">13 y 14 años</option>
            <option value="15 y 16 años">15 y 16 años</option>
            <option value="Open">Open</option>
          </select>
        </div>

        <button id="btnExportarExcel" class="bg-zinc-950 border border-green-500 text-green-400 font-black italic uppercase text-xs px-5 py-2.5 hover:bg-green-500 hover:text-black transition">
          📥 Exportar a CSV / Excel
        </button>
      </div>

      <!-- TABLA DE INSCRITOS -->
      <div class="bg-zinc-900 border border-zinc-800 overflow-x-auto shadow-xl">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-black border-b border-zinc-800 text-zinc-400 text-[11px] font-black uppercase tracking-wider">
              <th class="p-4">Fecha R.</th>
              <th class="p-4">Atleta</th>
              <th class="p-4">Categoría</th>
              <th class="p-4">Contacto</th>
              <th class="p-4">Pago</th>
              <th class="p-4 text-center">Capture</th>
              <th class="p-4 text-center">Acciones</th>
            </tr>
          </thead>
          <tbody id="tablaInscritosBody" class="divide-y divide-zinc-800 text-sm">
            <tr>
              <td colspan="7" class="p-8 text-center text-zinc-500 italic">Cargando registros...</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>

    <!-- MODAL PARA EDITAR INSCRITO -->
    <div id="modalInscrito" class="fixed inset-0 bg-black/90 z-[999] hidden flex items-center justify-center p-4">
      <div class="bg-zinc-900 border-2 border-green-500 max-w-2xl w-full p-6 md:p-8 max-h-[90vh] overflow-y-auto transform -skew-x-1 shadow-[8px_8px_0px_#22c55e]">
        <h2 class="text-2xl font-black uppercase italic text-green-500 mb-6 tracking-wider">Editar Inscripción</h2>
        
        <form id="formInscrito" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input type="hidden" id="editId">
          
          <div>
            <label for="editNombre" class="block text-xs font-black uppercase text-zinc-400 mb-1">Nombre</label>
            <input type="text" id="editNombre" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editApellido" class="block text-xs font-black uppercase text-zinc-400 mb-1">Apellido</label>
            <input type="text" id="editApellido" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editCedula" class="block text-xs font-black uppercase text-zinc-400 mb-1">Cédula</label>
            <input type="text" id="editCedula" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editFechaNac" class="block text-xs font-black uppercase text-zinc-400 mb-1">Fecha Nacimiento</label>
            <input type="date" id="editFechaNac" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editGenero" class="block text-xs font-black uppercase text-zinc-400 mb-1">Género</label>
            <select id="editGenero" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase text-sm focus:border-green-500 focus:outline-none">
              <option value="Masculino">Masculino</option>
              <option value="Femenino">Femenino</option>
            </select>
          </div>
          <div>
            <label for="editCategoria" class="block text-xs font-black uppercase text-zinc-400 mb-1">Categoría (Se calcula sola)</label>
            <input type="text" id="editCategoria" required readonly class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-green-400 font-bold uppercase text-sm cursor-not-allowed">
          </div>
          <div>
            <label for="editEmail" class="block text-xs font-black uppercase text-zinc-400 mb-1">Correo Electrónico</label>
            <input type="email" id="editEmail" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editTelefono" class="block text-xs font-black uppercase text-zinc-400 mb-1">Teléfono</label>
            <input type="text" id="editTelefono" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editEstado" class="block text-xs font-black uppercase text-zinc-400 mb-1">Estado</label>
            <input type="text" id="editEstado" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editCiudad" class="block text-xs font-black uppercase text-zinc-400 mb-1">Ciudad</label>
            <input type="text" id="editCiudad" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase text-sm focus:border-green-500 focus:outline-none">
          </div>
          <div>
            <label for="editMetodoPago" class="block text-xs font-black uppercase text-zinc-400 mb-1">Método de Pago</label>
            <select id="editMetodoPago" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold text-sm focus:border-green-500 focus:outline-none">
              <option value="Pago Movil">Pago Móvil</option>
              <option value="Transferencia">Transferencia Nacional</option>
              <option value="Efectivo Pista">Efectivo en Pista</option>
            </select>
          </div>
          <div>
            <label for="editReferencia" class="block text-xs font-black uppercase text-zinc-400 mb-1">Referencia</label>
            <input type="text" id="editReferencia" required class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-700 text-white font-bold uppercase text-sm focus:border-green-500 focus:outline-none">
          </div>

          <div class="md:col-span-2 flex justify-end gap-4 mt-6">
            <button type="button" id="btnCerrarModal" class="bg-zinc-800 text-zinc-300 px-5 py-2.5 font-bold uppercase text-xs hover:bg-zinc-700 transition">Cancelar</button>
            <button type="submit" class="bg-green-600 text-black px-6 py-2.5 font-black uppercase italic text-xs hover:bg-green-500 transition shadow-[3px_3px_0px_#fff]">Actualizar Registro</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
    <div id="modalEliminar" class="fixed inset-0 bg-black/90 z-[1000] hidden flex items-center justify-center p-4">
      <div class="bg-zinc-900 border-2 border-red-500 max-w-md w-full p-6 text-center transform -skew-x-1 shadow-[8px_8px_0px_#ef4444]">
        <div class="text-red-500 text-5xl mb-4">⚠️</div>
        <h3 class="text-2xl font-black uppercase italic text-white mb-2">¿Eliminar Inscripción?</h3>
        <p class="text-zinc-400 text-sm mb-6">Esta acción eliminará permanentemente al atleta seleccionado de la base de datos.</p>
        <div class="flex justify-center gap-4">
          <button id="btnCancelarEliminar" class="bg-zinc-800 text-zinc-300 px-5 py-2.5 font-bold uppercase text-xs hover:bg-zinc-700 transition">Cancelar</button>
          <button id="btnConfirmarEliminar" class="bg-red-600 text-white px-6 py-2.5 font-black uppercase italic text-xs hover:bg-red-500 transition shadow-[3px_3px_0px_#fff]">Sí, Eliminar</button>
        </div>
      </div>
    </div>

  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  let listaInscritos = [];
  let idParaEliminar = null;

  // Verificamos si la usuaria actual es la Super Administradora
  const esSuperAdmin = document.getElementById('adminCambibaraContenido')?.dataset.superadmin === 'true';

  function escaparHTML(texto) {
    if (!texto) return '';
    return String(texto)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function cargarInscritos() {
    const { data, error } = await supabase
      .from('inscripciones_cambibara')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
      console.error("Error al cargar inscritos:", error);
      return;
    }

    listaInscritos = data || [];
    aplicarFiltroActual();
    actualizarMetricas(listaInscritos);
  }

  function actualizarMetricas(datos) {
    const totalAtletas = datos.length;
    const totalDinero = totalAtletas * 8.00;

    document.getElementById('contadorAtletas').textContent = totalAtletas;
    document.getElementById('contadorDinero').textContent = `$${totalDinero.toFixed(2)} USD`;
  }

  function aplicarFiltroActual() {
    const cat = document.getElementById('filtroCategoria').value;
    if (cat === 'TODAS') {
      renderizarTabla(listaInscritos);
    } else {
      const catLower = cat.toLowerCase();
      const filtrados = listaInscritos.filter(
        item => item.categoria && item.categoria.toLowerCase().includes(catLower)
      );
      renderizarTabla(filtrados);
    }
  }

  function renderizarTabla(datos) {
    const tbody = document.getElementById('tablaInscritosBody');
    tbody.innerHTML = "";

    if (datos.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-zinc-500 italic">No hay atletas registrados en esta categoría.</td></tr>`;
      return;
    }

    datos.forEach(item => {
      const fecha = new Date(item.created_at).toLocaleDateString('es-VE');
      const tr = document.createElement('tr');
      tr.className = "hover:bg-zinc-950/50 transition-colors";
      
      const urlSegura = item.comprobante_url ? escaparHTML(item.comprobante_url) : '';

      // El botón Eliminar solo se genera para Patricia Mago (SuperAdmin)
      const botonEliminarHtml = esSuperAdmin 
        ? `<button data-id="${escaparHTML(item.id)}" class="btn-eliminar text-red-500 hover:text-red-400 font-bold text-xs uppercase underline">Eliminar</button>` 
        : '';

      tr.innerHTML = `
        <td class="p-4 font-mono text-xs text-zinc-400">${escaparHTML(fecha)}</td>
        <td class="p-4">
          <p class="font-black uppercase text-white">${escaparHTML(item.nombre)} ${escaparHTML(item.apellido)}</p>
          <span class="text-xs text-green-400 font-mono font-bold">${escaparHTML(item.cedula)}</span>
        </td>
        <td class="p-4">
          <span class="inline-block bg-black border border-green-500/50 text-green-400 font-black text-xs px-2.5 py-1 uppercase">${escaparHTML(item.categoria)}</span>
        </td>
        <td class="p-4">
          <p class="text-xs text-zinc-300 font-mono">${escaparHTML(item.telefono)}</p>
          <p class="text-xs text-zinc-500 font-mono">${escaparHTML(item.email)}</p>
        </td>
        <td class="p-4">
          <p class="font-bold text-xs uppercase text-zinc-200">${escaparHTML(item.metodo_pago)}</p>
          <p class="text-xs font-mono text-zinc-400">Ref: ${escaparHTML(item.referencia)}</p>
        </td>
        <td class="p-4 text-center">
          ${urlSegura ? `<a href="${urlSegura}" target="_blank" rel="noopener noreferrer" class="inline-block bg-zinc-800 text-green-400 border border-green-500/50 px-3 py-1 text-xs font-black uppercase hover:bg-green-500 hover:text-black transition">Ver Pago</a>` : '<span class="text-xs text-zinc-600">N/D</span>'}
        </td>
        <td class="p-4 text-center space-x-2">
          <button data-id="${escaparHTML(item.id)}" class="btn-editar text-cyan-400 hover:text-cyan-300 font-bold text-xs uppercase underline">Editar</button>
          ${botonEliminarHtml}
        </td>
      `;
      tbody.appendChild(tr);
    });

    document.querySelectorAll('.btn-editar').forEach(btn => {
      btn.addEventListener('click', (e) => abrirModalEditar(e.currentTarget.dataset.id));
    });

    if (esSuperAdmin) {
      document.querySelectorAll('.btn-eliminar').forEach(btn => {
        btn.addEventListener('click', (e) => abrirModalEliminar(e.currentTarget.dataset.id));
      });
    }
  }

  function calcularCategoriaModal() {
    const fecha = document.getElementById('editFechaNac').value;
    const genero = document.getElementById('editGenero').value;
    const inputCat = document.getElementById('editCategoria');

    if (!fecha || !genero) {
      inputCat.value = "";
      return;
    }

    const anoNacimiento = parseInt(fecha.substring(0, 4), 10);
    const anoEvento = 2026; 
    const edadCalendario = anoEvento - anoNacimiento;

    let catBase = "";

    if (edadCalendario <= 4) {
      catBase = "Balance";
    } else if (edadCalendario >= 5 && edadCalendario <= 6) {
      catBase = "5 y 6 años";
    } else if (edadCalendario >= 7 && edadCalendario <= 8) {
      catBase = "7 y 8 años";
    } else if (edadCalendario >= 9 && edadCalendario <= 10) {
      catBase = "9 y 10 años";
    } else if (edadCalendario >= 11 && edadCalendario <= 12) {
      catBase = "11 y 12 años";
    } else if (edadCalendario >= 13 && edadCalendario <= 14) {
      catBase = "13 y 14 años";
    } else if (edadCalendario >= 15 && edadCalendario <= 16) {
      catBase = "15 y 16 años";
    } else {
      catBase = "Open";
    }

    inputCat.value = `${catBase} - ${genero}`;
  }

  document.getElementById('editFechaNac').addEventListener('change', calcularCategoriaModal);
  document.getElementById('editGenero').addEventListener('change', calcularCategoriaModal);

  document.getElementById('filtroCategoria').addEventListener('change', aplicarFiltroActual);

  document.getElementById('btnCopiarDatosPago').addEventListener('click', () => {
    const textoPago = `💳 *DATOS DE PAGO - CAMBIBARA RACE*\n\nBanco: Venezuela (0102)\nTeléfono: 0424-8781128\nCédula: 24469073\nTitular: Cesar Barrios\nMonto: $8.00 USD (Pago Móvil a tasa BCV)\n\n¡Envía tu capture y reporte de pago para confirmar tu inscripción!`;
    navigator.clipboard.writeText(textoPago);
    alert("¡Datos de pago copiados al portapapeles listos para enviar por WhatsApp!");
  });

  const modal = document.getElementById('modalInscrito');
  const btnCerrarModal = document.getElementById('btnCerrarModal');
  const formInscrito = document.getElementById('formInscrito');

  btnCerrarModal.addEventListener('click', () => modal.classList.add('hidden'));

  function abrirModalEditar(id) {
    const atleta = listaInscritos.find(i => String(i.id) === String(id));
    if (!atleta) return;

    document.getElementById('editId').value = atleta.id;
    document.getElementById('editNombre').value = atleta.nombre || '';
    document.getElementById('editApellido').value = atleta.apellido || '';
    document.getElementById('editCedula').value = atleta.cedula || '';
    document.getElementById('editFechaNac').value = atleta.fecha_nacimiento || '';
    document.getElementById('editGenero').value = atleta.genero || 'Masculino';
    document.getElementById('editCategoria').value = atleta.categoria || '';
    document.getElementById('editEmail').value = atleta.email || '';
    document.getElementById('editTelefono').value = atleta.telefono || '';
    document.getElementById('editEstado').value = atleta.estado || '';
    document.getElementById('editCiudad').value = atleta.ciudad || '';
    document.getElementById('editMetodoPago').value = atleta.metodo_pago || 'Pago Movil';
    document.getElementById('editReferencia').value = atleta.referencia || '';

    modal.classList.remove('hidden');
  }

  formInscrito.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('editId').value;
    
    const payload = {
      nombre: document.getElementById('editNombre').value.trim().toUpperCase(),
      apellido: document.getElementById('editApellido').value.trim().toUpperCase(),
      cedula: document.getElementById('editCedula').value.trim().toUpperCase(),
      fecha_nacimiento: document.getElementById('editFechaNac').value,
      genero: document.getElementById('editGenero').value,
      categoria: document.getElementById('editCategoria').value.trim(),
      email: document.getElementById('editEmail').value.trim().toLowerCase(),
      telefono: document.getElementById('editTelefono').value.trim().toUpperCase(),
      estado: document.getElementById('editEstado').value.trim().toUpperCase(),
      ciudad: document.getElementById('editCiudad').value.trim().toUpperCase(),
      metodo_pago: document.getElementById('editMetodoPago').value,
      referencia: document.getElementById('editReferencia').value.trim().toUpperCase()
    };

    const { error } = await supabase.from('inscripciones_cambibara').update(payload).eq('id', id);
    if (error) {
      alert("Error al actualizar: " + error.message);
    } else {
      modal.classList.add('hidden');
      cargarInscritos();
    }
  });

  const modalEliminar = document.getElementById('modalEliminar');
  const btnCancelarEliminar = document.getElementById('btnCancelarEliminar');
  const btnConfirmarEliminar = document.getElementById('btnConfirmarEliminar');

  function abrirModalEliminar(id) {
    if (!esSuperAdmin) {
      alert("Acción denegada: Solo la Super Administradora puede eliminar inscripciones.");
      return;
    }
    idParaEliminar = id;
    modalEliminar.classList.remove('hidden');
  }

  btnCancelarEliminar.addEventListener('click', () => {
    modalEliminar.classList.add('hidden');
    idParaEliminar = null;
  });

  btnConfirmarEliminar.addEventListener('click', async () => {
    if (!esSuperAdmin || !idParaEliminar) return;

    const { error } = await supabase
      .from('inscripciones_cambibara')
      .delete()
      .match({ id: idParaEliminar });

    if (error) {
      alert("Error al eliminar: " + error.message);
    } else {
      modalEliminar.classList.add('hidden');
      idParaEliminar = null;
      cargarInscritos();
    }
  });

  document.getElementById('btnExportarExcel').addEventListener('click', () => {
    if (listaInscritos.length === 0) return alert("No hay datos para exportar.");
    
    const exportData = listaInscritos.map(row => ({
      Fecha_Registro: new Date(row.created_at).toLocaleDateString('es-VE'),
      Nombre: row.nombre || '',
      Apellido: row.apellido || '',
      Cedula: row.cedula || '',
      Fecha_Nacimiento: row.fecha_nacimiento || '',
      Genero: row.genero || '',
      Categoria: row.categoria || '',
      Email: row.email || '',
      Telefono: row.telefono || '',
      Estado: row.estado || '',
      Ciudad: row.ciudad || '',
      Metodo_Pago: row.metodo_pago || '',
      Referencia: row.referencia || '',
      Comprobante_URL: row.comprobante_url || ''
    }));

    const keys = Object.keys(exportData[0]);
    const csvContent = "\uFEFF" + [
      keys.join(","),
      ...exportData.map(r => keys.map(k => JSON.stringify(r[k] ?? "")).join(","))
    ].join("\n");

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `Inscritos_Cambibara_Race_${new Date().toISOString().split('T')[0]}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  cargarInscritos();
</script>