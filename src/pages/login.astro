---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión | Pupi Bike Kids">
  <!-- Navegación Adaptada para Móvil / Escritorio -->
  <nav class="bg-black text-white p-4 border-b-4 border-cyan-400">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-2xl md:text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPIBIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <a href="/" class="text-cyan-400 font-black italic uppercase text-xs md:text-sm border border-cyan-400 px-3 py-2 md:px-5 md:py-2 hover:bg-cyan-400 hover:text-black transition transform -skew-x-4 shadow-[3px_3px_0px_#00d2ff]">
        ← Volver al Inicio
      </a>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-20 max-w-md relative min-h-[85vh] flex flex-col justify-center">
    <!-- Luces de fondo -->
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan-600 rounded-full mix-blend-screen filter blur-[100px] opacity-20 pointer-events-none"></div>

    <h1 class="text-5xl md:text-5xl font-black text-white mb-2 text-center uppercase italic transform -skew-x-6 drop-shadow-md">Portal de <span class="text-cyan-400">Alumnos</span></h1>
    <p class="text-zinc-400 mb-10 text-center italic text-lg font-medium">Ingresa a tu panel de control y pagos.</p>

    <!-- Formulario -->
    <form id="loginForm" class="bg-zinc-900 p-8 md:p-10 shadow-[8px_8px_0px_#00d2ff] border-2 border-cyan-400 flex flex-col gap-6 relative z-10">
      
      <div>
        <label for="email" class="block text-2sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Correo Electrónico</label>
        <input type="email" id="email" autocomplete="email" placeholder="tucorreo@ejemplo.com" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-cyan-400 transition transform -skew-x-2 placeholder-zinc-700 lowercase">
      </div>
      
      <div>
        <label for="password" class="block text-2sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Contraseña</label>
        <div class="relative transform -skew-x-2">
          <input 
            type="password" 
            id="password" 
            autocomplete="current-password" 
            placeholder="••••••••" 
            required 
            class="w-full pl-4 pr-12 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-cyan-400 transition placeholder-zinc-700"
          >
          <button 
            type="button" 
            id="btnTogglePassword" 
            aria-label="Mostrar u ocultar contraseña" 
            class="absolute inset-y-0 right-0 pr-4 flex items-center text-zinc-400 hover:text-cyan-400 transition focus:outline-none"
          >
            <!-- Ícono ojo abierto (ver) -->
            <svg id="iconoOjoAbierto" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <!-- Ícono ojo tachado (ocultar) -->
            <svg id="iconoOjoCerrado" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mensaje" class="hidden"></div>

      <button type="submit" id="btnSubmit" class="bg-cyan-500 text-black font-black italic uppercase text-xl py-4 hover:bg-cyan-400 transition-all transform -skew-x-6 shadow-[6px_6px_0px_#db2777] hover:translate-y-1 hover:shadow-[2px_2px_0px_#db2777] mt-4 border-2 border-transparent">
        Ingresar al Panel
      </button>
      
      <div class="text-center mt-2 flex flex-col gap-2">
        <button type="button" id="btnRecuperarClave" class="text-2xs font-bold text-white-500 hover:text-cyan-400 italic transition focus:outline-none">
          ¿Olvidaste tu contraseña?
        </button>
        <a href="/registro" class="text-2sm font-bold text-white-400 hover:text-pink-500 italic transition">¿Aún no estás inscrito? Regístrate aquí</a>
      </div>
    </form>
  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('loginForm');
  const mensaje = document.getElementById('mensaje');
  const btnSubmit = document.getElementById('btnSubmit');
  const btnRecuperar = document.getElementById('btnRecuperarClave');

  // Alternar visualización de la contraseña (Ojo)
  const btnTogglePassword = document.getElementById('btnTogglePassword');
  const inputPassword = document.getElementById('password');
  const iconoOjoAbierto = document.getElementById('iconoOjoAbierto');
  const iconoOjoCerrado = document.getElementById('iconoOjoCerrado');

  if (btnTogglePassword && inputPassword) {
    btnTogglePassword.addEventListener('click', () => {
      const esPassword = inputPassword.type === 'password';
      inputPassword.type = esPassword ? 'text' : 'password';
      iconoOjoAbierto.classList.toggle('hidden', esPassword);
      iconoOjoCerrado.classList.toggle('hidden', !esPassword);
    });
  }

  // Recuperación de contraseña por correo
  btnRecuperar?.addEventListener('click', async () => {
    const emailInput = document.getElementById('email');
    const email = emailInput.value.trim().toLowerCase();

    if (!email) {
      mensaje.textContent = "Escribe tu correo electrónico arriba y vuelve a presionar '¿Olvidaste tu contraseña?'.";
      mensaje.className = "p-3 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-cyan-400 text-black block mt-2 text-xs";
      mensaje.classList.remove('hidden');
      emailInput.focus();
      return;
    }

    btnRecuperar.disabled = true;
    btnRecuperar.textContent = "Enviando enlace...";

    try {
      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/dashboard`,
      });
      if (error) throw error;

      mensaje.textContent = "Te enviamos un enlace a tu correo para restablecer tu contraseña. Revisa tu bandeja de entrada o spam.";
      mensaje.className = "p-3 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-lime-400 text-black block mt-2 text-xs";
      mensaje.classList.remove('hidden');
    } catch (err) {
      console.error(err);
      mensaje.textContent = "No se pudo enviar el correo de recuperación. Verifica que esté bien escrito.";
      mensaje.className = "p-3 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-pink-600 text-white block mt-2 text-xs";
      mensaje.classList.remove('hidden');
    } finally {
      btnRecuperar.disabled = false;
      btnRecuperar.textContent = "¿Olvidaste tu contraseña?";
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    btnSubmit.textContent = "VERIFICANDO...";
    btnSubmit.disabled = true;
    mensaje.classList.add('hidden');

    const email = document.getElementById('email').value.trim().toLowerCase();
    const password = document.getElementById('password').value;

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email: email,
        password: password,
      });

      if (error) throw error;

      // Lista de correos administradores
      const correosAdmin = ["pathdawann@gmail.com", "pupibikekids27@gmail.com"];

      if (data.user?.email && correosAdmin.includes(data.user.email)) {
        window.location.href = '/admin';
      } else {
        window.location.href = '/dashboard';
      }

    } catch (error) {
      console.error(error);
      let errorMsg = "Credenciales incorrectas. Verifica tu correo y contraseña.";
      
      if (error.message && error.message.includes('Email not confirmed')) {
        errorMsg = "Debes confirmar tu correo electrónico antes de ingresar. Revisa tu bandeja de entrada o spam.";
      } else if (error.message && error.message.includes('Invalid login credentials')) {
        errorMsg = "Correo o contraseña incorrectos.";
      }

      mensaje.textContent = errorMsg;
      mensaje.className = "p-3 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-pink-600 text-white block mt-2 text-sm";
      mensaje.classList.remove('hidden');
    } finally {
      btnSubmit.textContent = "Ingresar al Panel";
      btnSubmit.disabled = false;
    }
  });
</script>