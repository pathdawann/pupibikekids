---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navegación Adaptada para Móvil / Escritorio -->
  <nav class="bg-black text-white p-4 border-b-4 border-cyan-400">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-2xl md:text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPI BIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <a href="/" class="text-cyan-400 font-black italic uppercase text-xs md:text-sm border border-cyan-400 px-3 py-2 md:px-5 md:py-2 hover:bg-cyan-400 hover:text-black transition transform -skew-x-4 shadow-[3px_3px_0px_#00d2ff]">
        ← Volver al Inicio
      </a>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-20 max-w-md relative min-h-[85vh] flex flex-col justify-center">
    <!-- Luces de fondo -->
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan-600 rounded-full mix-blend-screen filter blur-[100px] opacity-20 pointer-events-none"></div>

    <h1 class="text-4xl md:text-5xl font-black text-white mb-2 text-center uppercase italic transform -skew-x-6 drop-shadow-md">Portal de <span class="text-cyan-400">Alumnos</span></h1>
    <p class="text-zinc-400 mb-10 text-center italic text-lg font-medium">Ingresa a tu panel de control y pagos.</p>

    <!-- Formulario -->
    <form id="loginForm" class="bg-zinc-900 p-8 md:p-10 shadow-[8px_8px_0px_#00d2ff] border-2 border-cyan-400 flex flex-col gap-6 relative z-10">
      
      <div>
        <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Correo Electrónico</label>
        <input type="email" id="email" placeholder="tucorreo@ejemplo.com" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-cyan-400 transition transform -skew-x-2 placeholder-zinc-700">
      </div>
      
      <div>
        <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Contraseña</label>
        <input type="password" id="password" placeholder="••••••••" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-cyan-400 transition transform -skew-x-2 placeholder-zinc-700">
      </div>

      <div id="mensaje" class="hidden"></div>

      <button type="submit" id="btnSubmit" class="bg-cyan-500 text-black font-black italic uppercase text-xl py-4 hover:bg-cyan-400 transition-all transform -skew-x-6 shadow-[6px_6px_0px_#db2777] hover:translate-y-1 hover:shadow-[2px_2px_0px_#db2777] mt-4 border-2 border-transparent">
        Ingresar al Panel
      </button>
      
      <div class="text-center mt-2 flex flex-col gap-2">
        <a href="#" class="text-xs font-bold text-zinc-500 hover:text-cyan-400 italic transition">¿Olvidaste tu contraseña?</a>
        <a href="/registro" class="text-sm font-bold text-zinc-400 hover:text-pink-500 italic transition">¿Aún no estás inscrito? Regístrate aquí</a>
      </div>
    </form>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('loginForm');
  const mensaje = document.getElementById('mensaje');
  const btnSubmit = document.getElementById('btnSubmit');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    btnSubmit.textContent = "VERIFICANDO...";
    btnSubmit.disabled = true;

    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email: email,
        password: password,
      });

      if (error) throw error;

      // Si el login es exitoso, redirigimos al portal interno (que crearemos pronto)
      window.location.href = '/dashboard';

    } catch (error) {
      console.error(error);
      mensaje.textContent = "Credenciales incorrectas. Verifica tu correo y contraseña.";
      mensaje.className = "p-3 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-pink-600 text-white block mt-2 text-sm";
    } finally {
      btnSubmit.textContent = "Ingresar al Panel";
      btnSubmit.disabled = false;
    }
  });
</script>