---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navegación Privada -->
  <nav class="bg-black text-white p-4 border-b-4 border-pink-500 sticky top-0 z-50">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/dashboard" class="text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPI BIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <a href="/dashboard" class="text-cyan-400 font-bold hover:text-white transition italic uppercase text-sm md:text-base underline">
        Volver al Panel
      </a>
    </div>
  </nav>

  <!-- Pantalla de Carga -->
  <div id="pantallaCarga" class="min-h-[80vh] flex flex-col items-center justify-center">
    <div class="w-16 h-16 border-4 border-pink-500 border-t-transparent rounded-full animate-spin mb-4"></div>
    <p class="text-pink-500 font-black italic uppercase tracking-widest animate-pulse">Buscando recibos...</p>
  </div>

  <!-- Contenedor Principal -->
  <main id="historialContenido" class="container mx-auto px-4 py-12 max-w-4xl relative hidden min-h-[80vh]">
    <!-- Luces de fondo -->
    <div class="absolute top-10 left-0 w-80 h-80 bg-cyan-600 rounded-full mix-blend-screen filter blur-[120px] opacity-10 pointer-events-none"></div>

    <div class="mb-10 text-center">
      <div class="bg-black inline-block px-10 py-3 transform -skew-x-6 shadow-[6px_6px_0px_#db2777] mb-4 border border-zinc-800">
        <h1 class="text-3xl md:text-4xl font-black text-white uppercase italic tracking-wider">
          Historial de <span class="text-pink-500">Pagos</span>
        </h1>
      </div>
      <p class="text-zinc-400 italic font-medium text-lg">Registro completo de tus reportes de transferencias.</p>
    </div>

    <!-- Lista donde JavaScript inyectará las tarjetas de pago -->
    <div id="contenedorLista" class="flex flex-col gap-6 relative z-10">
      <!-- Aquí irán los pagos -->
    </div>

    <!-- Mensaje por si no hay pagos registrados -->
    <div id="mensajeVacio" class="hidden bg-zinc-900 border-2 border-zinc-700 p-10 text-center transform -skew-x-2 shadow-lg mt-8">
      <div class="transform skew-x-2">
        <p class="text-zinc-400 text-xl font-bold italic uppercase mb-2">Aún no tienes pagos reportados</p>
        <p class="text-zinc-500 text-sm mb-6">Tus recibos aparecerán aquí una vez que los registres desde tu panel.</p>
        <a href="/dashboard" class="inline-block bg-pink-600 text-white font-black italic uppercase px-6 py-2 hover:bg-pink-500 transition-colors transform -skew-x-4 shadow-[4px_4px_0px_rgba(0,0,0,0.5)]">
          Volver al Panel
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', async () => {
    const pantallaCarga = document.getElementById('pantallaCarga');
    const historialContenido = document.getElementById('historialContenido');
    const contenedorLista = document.getElementById('contenedorLista');
    const mensajeVacio = document.getElementById('mensajeVacio');

    try {
      // 1. Verificar Sesión
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }

      const user = session.user;

      // 2. Obtener el ID del Alumno vinculado a este usuario
      const { data: alumno, error: errAlumno } = await supabase
        .from('alumnos')
        .select('id')
        .eq('user_id', user.id)
        .single();

      if (errAlumno || !alumno) throw new Error("No se pudo identificar al alumno.");

      // 3. Buscar todos los pagos de este alumno (ordenados por el más reciente primero)
      const { data: pagos, error: errPagos } = await supabase
        .from('pagos')
        .select('*')
        .eq('alumno_id', alumno.id)
        .order('created_at', { ascending: false });

      if (errPagos) throw errPagos;

      // 4. Pintar los pagos en la pantalla
      pantallaCarga.classList.add('hidden');
      historialContenido.classList.remove('hidden');

      if (!pagos || pagos.length === 0) {
        mensajeVacio.classList.remove('hidden');
      } else {
        pagos.forEach(pago => {
          // Extraer solo la fecha de la marca de tiempo (created_at)
          const fechaReporte = new Date(pago.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });

          const tarjetaHtml = `
            <div class="bg-zinc-900 border-l-8 border-pink-500 p-6 md:p-8 shadow-[6px_6px_0px_rgba(0,0,0,0.3)] transform -skew-x-2 hover:-translate-y-1 transition-transform border-y border-r border-zinc-800">
              <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 transform skew-x-2">
                
                <div class="flex-1">
                  <p class="text-pink-500 font-black uppercase italic tracking-wider text-xl mb-1">${pago.mes_correspondiente}</p>
                  <p class="text-white font-bold text-lg mb-1">${pago.metodo_pago} <span class="text-zinc-500">|</span> Ref: ${pago.referencia}</p>
                  <p class="text-zinc-500 text-xs font-bold uppercase tracking-wider">Reportado el: ${fechaReporte}</p>
                </div>

                <div class="text-left md:text-right flex flex-row md:flex-col items-center md:items-end justify-between md:justify-center">
                  <p class="text-3xl font-black text-lime-400 italic">${pago.monto}$</p>
                  <p class="text-xs font-bold bg-zinc-800 text-zinc-300 px-3 py-1 uppercase tracking-widest border border-zinc-700 mt-2">En Revisión</p>
                </div>

              </div>
            </div>
          `;
          contenedorLista.innerHTML += tarjetaHtml;
        });
      }

    } catch (error) {
      console.error("Error cargando el historial:", error);
      alert("Hubo un error cargando tu historial.");
      window.location.href = '/dashboard';
    }
  });
</script>