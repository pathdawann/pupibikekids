---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inscripción Cambibara Race">
  <nav class="bg-black text-white p-4 border-b-4 border-green-500">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-2xl font-black italic tracking-wider text-white transform -skew-x-6">
        PUPIBIKE <span class="text-green-500">KIDS</span>
      </a>
      <a href="/" class="text-green-400 font-black italic uppercase text-xs border border-green-500 px-3 py-2 hover:bg-green-500 hover:text-black transition transform -skew-x-4">
        ← Volver
      </a>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-12 max-w-6xl relative min-h-[80vh]">
    <div class="absolute top-0 right-0 w-64 h-64 bg-green-600 rounded-full mix-blend-screen filter blur-[100px] opacity-20 pointer-events-none"></div>

    <!-- PANTALLA DE ÉXITO -->
    <div id="pantallaExito" class="hidden flex-col items-center justify-center text-center py-20 animate-fade-in">
      <div class="text-green-500 text-7xl mb-6">🏆</div>
      <h1 class="text-5xl md:text-6xl font-black text-white uppercase italic transform -skew-x-6 mb-4">¡Inscripción <span class="text-green-500">Exitosa!</span></h1>
      <p class="text-xl text-zinc-300 font-medium mb-2">Atleta: <span id="exitoNombre" class="text-white font-black uppercase"></span></p>
      <p class="text-xl text-zinc-300 font-medium mb-8">Categoría: <span id="exitoCategoria" class="text-green-400 font-black uppercase"></span></p>
      <div class="bg-zinc-900 border-2 border-green-500 px-10 py-6 transform -skew-x-2 shadow-[8px_8px_0px_#22c55e]">
        <p class="text-2xl font-black italic text-white uppercase">"Nos vemos en el Circuito"</p>
      </div>
      <a href="/" class="mt-12 text-zinc-400 hover:text-white underline font-bold italic">Volver al inicio</a>
    </div>

    <!-- FORMULARIO DE REGISTRO -->
    <div id="contenedorFormulario">
      <div class="text-center mb-10">
        <h1 class="text-4xl md:text-6xl font-black text-white uppercase italic transform -skew-x-6 mb-2">Cambibara <span class="text-green-500">Race</span></h1>
        <p class="text-zinc-400 italic text-lg font-medium">Sábado 17 de Octubre - Sector Óvalo</p>
      </div>

      <form id="formCambibara" class="bg-zinc-900 p-6 md:p-12 shadow-[8px_8px_0px_#22c55e] border-2 border-green-500 flex flex-col gap-10 relative z-10">
        
        <!-- SECCIÓN 1: Datos del Corredor -->
        <div>
          <div class="bg-black inline-block px-8 py-3 transform -skew-x-6 shadow-[4px_4px_0px_#22c55e] mb-8">
            <h2 class="text-2xl md:text-2xl font-black uppercase italic text-green-400">1. Datos del Corredor</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Nombre</label>
              <input type="text" id="nombre" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg uppercase focus:border-green-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Apellido</label>
              <input type="text" id="apellido" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg uppercase focus:border-green-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">
                Cédula <span class="text-zinc-400 font-normal lowercase italic text-xs md:text-sm">(Si no posee, agregar la del Representante)</span>
              </label>
              <input type="text" id="cedula" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg uppercase focus:border-green-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Fecha de Nacimiento</label>
              <input type="date" id="fecha_nacimiento" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg focus:border-green-500 focus:outline-none">
            </div>
            
            <!-- Selector de Género -->
            <div class="md:col-span-2">
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Género del Corredor</label>
              <div class="flex gap-6">
                <input type="hidden" id="genero_atleta" required>
                <button type="button" id="btnMasc" class="flex-1 px-6 py-4 bg-zinc-950 border border-zinc-700 text-zinc-400 font-black text-base md:text-lg uppercase transition-all hover:border-zinc-500 focus:outline-none">
                  MASCULINO
                </button>
                <button type="button" id="btnFem" class="flex-1 px-6 py-4 bg-zinc-950 border border-zinc-700 text-zinc-400 font-black text-base md:text-lg uppercase transition-all hover:border-zinc-500 focus:outline-none">
                  FEMENINO
                </button>
              </div>
            </div>

            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Correo Electrónico</label>
              <input type="email" id="email" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg lowercase focus:border-green-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Teléfono</label>
              <input type="text" id="telefono" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg uppercase focus:border-green-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Estado de Residencia</label>
              <input type="text" id="estado_res" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg uppercase focus:border-green-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Ciudad</label>
              <input type="text" id="ciudad" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg uppercase focus:border-green-500 focus:outline-none">
            </div>
          </div>
        </div>

        <!-- CÁLCULO DE CATEGORÍA -->
        <div class="bg-zinc-950 p-6 border border-zinc-800 text-center transform -skew-x-2">
          <p class="text-sm md:text-base font-black text-zinc-400 uppercase tracking-wider mb-2">Categoría Asignada (Año Calendario)</p>
          <p id="categoriaDisplay" class="text-3xl md:text-4xl font-black italic uppercase text-green-500">Ingrese fecha y género</p>
          <input type="hidden" id="categoria_final" required>
        </div>

        <!-- SECCIÓN 2: Reporte de Pago -->
        <div>
          <div class="bg-black inline-block px-8 py-3 transform -skew-x-6 shadow-[4px_4px_0px_#22c55e] mb-8">
            <h2 class="text-2xl md:text-2xl font-black uppercase italic text-green-400">2. Reporte de Pago</h2>
          </div>

          <!-- Datos Bancarios -->
          <div class="bg-zinc-950 p-6 md:p-8 border-l-4 border-green-500 mb-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-inner">
            <div class="flex-1 w-full md:pr-6 md:border-r border-zinc-800">
              <div class="mb-4 pb-4 border-b border-zinc-800">
                <span class="block text-sm font-black uppercase text-zinc-500 tracking-wider mb-2">TOTAL A PAGAR</span>
                <div class="flex items-center gap-3">
                  <span id="montoBolivares" class="text-3xl font-black italic text-green-500 tracking-tight leading-none">Calculando...</span>
                  <span class="text-white font-bold text-xl bg-zinc-800/50 px-3 py-1.5 rounded-sm leading-none">( $8.00 )</span>
                </div>
                <span id="tasaDisplay" class="text-xs md:text-sm text-white-500 font-bold uppercase mt-3 block">TASA BCV: Cargando...</span>
            </div>

            <h3 class="text-white font-black italic uppercase mb-1 text-base md:text-lg">CUENTA OFICIAL DE LA ACADEMIA</h3>
            <p class="text-xs text-zinc-400 font-medium">Haz clic en los datos para copiarlos.</p>
            </div>
            
            <!-- Cajas de Datos Bancarios con Tipografía Más Grande -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm w-full md:w-auto flex-1">
              <div class="bg-black p-4 border border-zinc-800 cursor-pointer hover:border-green-500 transition group" onclick="navigator.clipboard.writeText('0102')">
                <span class="block text-xs text-zinc-400 font-black uppercase mb-1">Banco</span>
                <span class="text-white font-bold text-base md:text-lg group-hover:text-green-500">Venezuela (0102)</span>
              </div>
              <div class="bg-black p-4 border border-zinc-800 cursor-pointer hover:border-green-500 transition group" onclick="navigator.clipboard.writeText('04248781128')">
                <span class="block text-xs text-zinc-400 font-black uppercase mb-1">Teléfono</span>
                <span class="text-white font-bold text-base md:text-lg group-hover:text-green-500">0424-8781128</span>
              </div>
              <div class="bg-black p-4 border border-zinc-800 cursor-pointer hover:border-green-500 transition group" onclick="navigator.clipboard.writeText('24469073')">
                <span class="block text-xs text-zinc-400 font-black uppercase mb-1">Cédula</span>
                <span class="text-white font-bold text-base md:text-lg group-hover:text-green-500">24469073</span>
              </div>
              <div class="bg-black p-4 border border-zinc-800">
                <span class="block text-xs text-zinc-400 font-black uppercase mb-1">Titular</span>
                <span class="text-white font-bold text-base md:text-lg">Cesar Barrios</span>
              </div>
            </div>
        </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Método de Pago</label>
              <select id="metodo_pago" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg focus:border-green-500 focus:outline-none">
                <option value="Pago Movil">Pago Móvil</option>
                <option value="Efectivo Pista">Efectivo en Pista</option>
              </select>
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Número de Referencia</label>
              <input type="text" id="referencia" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg uppercase focus:border-green-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Fecha del Pago</label>
              <input type="date" id="fecha_pago" required class="w-full px-5 py-4 bg-zinc-950 border border-zinc-700 text-white font-bold text-base md:text-lg focus:border-green-500 focus:outline-none">
            </div>
            
            <div>
              <label class="block text-sm md:text-base font-black uppercase text-zinc-300 mb-2">Capture de Pago</label>
              <div class="relative w-full h-14 bg-zinc-950 border-2 border-dashed border-zinc-700 hover:border-green-500 transition flex items-center justify-center cursor-pointer group">
                <input type="file" id="comprobante" required accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                <div class="text-center pointer-events-none flex items-center gap-3">
                  <span class="text-2xl group-hover:text-green-400">📸</span>
                  <span id="nombreArchivo" class="text-sm font-bold text-zinc-400 uppercase group-hover:text-green-400">Toca aquí para subir imagen</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SECCIÓN 3: Exención de Responsabilidad -->
        <div class="bg-zinc-950 p-6 border border-zinc-800 text-center">
          <button type="button" id="btnAbrirModalTerminos" class="text-green-400 hover:text-green-300 font-black italic uppercase underline text-base mb-4 focus:outline-none">
            📖 Leer y Aceptar Exención de Responsabilidad
          </button>
          <div class="flex items-center justify-center gap-3">
            <input type="checkbox" id="checkTerminos" required disabled class="w-6 h-6 accent-green-500 cursor-not-allowed">
            <label class="text-zinc-300 font-bold text-base">Acepto los términos y condiciones de la competencia.</label>
          </div>
        </div>

        <div id="mensajeError" class="hidden text-center bg-red-600 text-white font-black text-lg uppercase p-4 transform -skew-x-2"></div>

        <button type="submit" id="btnProcesar" disabled class="bg-zinc-800 text-zinc-500 font-black italic uppercase text-2xl py-6 transition-all transform -skew-x-6 cursor-not-allowed mt-2 border-2 border-transparent">
          Completar Inscripción
        </button>
      </form>
    </div>

    <!-- MODAL TÉRMINOS -->
    <div id="modalTerminos" class="fixed inset-0 bg-black/95 z-[100] hidden flex items-center justify-center p-4">
      <div class="bg-zinc-900 border-2 border-green-500 max-w-2xl w-full p-6 md:p-8 max-h-[90vh] flex flex-col transform -skew-x-2 shadow-[8px_8px_0px_#22c55e]">
        <h2 class="text-2xl font-black uppercase italic text-green-500 mb-4 tracking-wider">Exención de Responsabilidad</h2>
        <div class="overflow-y-auto pr-4 mb-6 text-zinc-300 text-base space-y-4 font-medium flex-1">
          <p>Al inscribirme en la Cambibara Race, declaro que participo de forma voluntaria y asumo todos los riesgos inherentes a la práctica del ciclismo competitivo con obstáculos.</p>
          <p>Libero de toda responsabilidad legal, civil y penal a la Academia Pupi Bike Kids, sus organizadores, patrocinadores y autoridades competentes ante cualquier accidente, lesión o pérdida material que pudiera ocurrir durante el evento.</p>
          <p>Confirmo que mis datos son correctos y que la categoría asignada corresponde al año calendario oficial de nacimiento.</p>
        </div>
        <button type="button" id="btnAceptarTerminos" class="bg-green-600 text-white font-black text-lg uppercase italic py-4 hover:bg-green-500 transition focus:outline-none shadow-[4px_4px_0px_#000]">
          Sí, Acepto la Responsabilidad
        </button>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  const COSTO_INSCRIPCION_USD = 8.00;

  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const { data: tasaConfig, error } = await supabase
        .from('configuracion')
        .select('valor')
        .eq('clave', 'tasa_dolar')
        .single();
      
      const tasaValor = parseFloat(tasaConfig?.valor || 0);
      
      if (tasaValor > 0 && !error) {
        const montoBs = (COSTO_INSCRIPCION_USD * tasaValor).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('montoBolivares').textContent = `${montoBs} Bs.`;
        document.getElementById('tasaDisplay').textContent = `TASA BCV: ${tasaValor.toLocaleString('es-VE')} Bs.`;
      } else {
        document.getElementById('montoBolivares').textContent = "Consultar al Admin";
        document.getElementById('tasaDisplay').textContent = "TASA BCV NO DISPONIBLE";
      }
    } catch (e) {
      console.error("Error cargando tasa:", e);
      document.getElementById('montoBolivares').textContent = "Consultar al Admin";
    }
  });

  const form = document.getElementById('formCambibara');
  const inputNacimiento = document.getElementById('fecha_nacimiento');
  const displayCategoria = document.getElementById('categoriaDisplay');
  const inputCategoriaFinal = document.getElementById('categoria_final');
  
  const inputGenero = document.getElementById('genero_atleta');
  const btnMasc = document.getElementById('btnMasc');
  const btnFem = document.getElementById('btnFem');

  const checkTerminos = document.getElementById('checkTerminos');
  const btnProcesar = document.getElementById('btnProcesar');
  const btnAbrirModal = document.getElementById('btnAbrirModalTerminos');
  const btnAceptarTerminos = document.getElementById('btnAceptarTerminos');
  const modalTerminos = document.getElementById('modalTerminos');

  document.getElementById('comprobante').addEventListener('change', function(e) {
    const fileName = e.target.files[0]?.name || "Toca aquí para subir imagen";
    document.getElementById('nombreArchivo').textContent = fileName;
    document.getElementById('nombreArchivo').classList.add('text-green-400');
  });

  function seleccionarGenero(genero) {
    inputGenero.value = genero;
    
    btnMasc.className = "flex-1 px-6 py-4 bg-zinc-950 border border-zinc-700 text-zinc-400 font-black text-base md:text-lg uppercase transition-all hover:border-zinc-500 focus:outline-none";
    btnFem.className = "flex-1 px-6 py-4 bg-zinc-950 border border-zinc-700 text-zinc-400 font-black text-base md:text-lg uppercase transition-all hover:border-zinc-500 focus:outline-none";
    
    if (genero === 'Masculino') {
      btnMasc.classList.add('border-green-500', 'text-green-500');
      btnMasc.classList.remove('border-zinc-700', 'text-zinc-400');
    } else {
      btnFem.classList.add('border-green-500', 'text-green-500');
      btnFem.classList.remove('border-zinc-700', 'text-zinc-400');
    }
    
    calcularCategoria();
  }

  btnMasc.addEventListener('click', () => seleccionarGenero('Masculino'));
  btnFem.addEventListener('click', () => seleccionarGenero('Femenino'));

  // Lógica blindada de rangos por edad calendario para el evento 2026
  function calcularCategoria() {
    const fecha = inputNacimiento.value; // Formato "YYYY-MM-DD"
    const genero = inputGenero.value;
    
    if (!fecha || !genero) {
      displayCategoria.textContent = "Ingrese fecha y género";
      return;
    }

    // Extracción segura del año mediante subcadena para evitar problemas de zona horaria
    const anoNacimiento = parseInt(fecha.substring(0, 4), 10);
    const anoEvento = 2026; 
    const edadCalendario = anoEvento - anoNacimiento;

    let catBase = "";

    if (edadCalendario <= 4) {
      catBase = "Balance";
    } else if (edadCalendario >= 5 && edadCalendario <= 6) {
      catBase = "5 y 6 años";
    } else if (edadCalendario >= 7 && edadCalendario <= 8) {
      catBase = "7 y 8 años";
    } else if (edadCalendario >= 9 && edadCalendario <= 10) {
      catBase = "9 y 10 años";
    } else if (edadCalendario >= 11 && edadCalendario <= 12) {
      catBase = "11 y 12 años";
    } else if (edadCalendario >= 13 && edadCalendario <= 14) {
      catBase = "13 y 14 años";
    } else if (edadCalendario >= 15 && edadCalendario <= 16) {
      catBase = "15 y 16 años";
    } else {
      catBase = "Open";
    }

    const catFinal = `${catBase} - ${genero}`;
    
    displayCategoria.textContent = catFinal;
    inputCategoriaFinal.value = catFinal;
  }

  inputNacimiento.addEventListener('change', calcularCategoria);

  btnAbrirModal.addEventListener('click', () => modalTerminos.classList.remove('hidden'));
  
  btnAceptarTerminos.addEventListener('click', () => {
    modalTerminos.classList.add('hidden');
    checkTerminos.checked = true;
    checkTerminos.disabled = false;
    
    btnProcesar.disabled = false;
    btnProcesar.className = "bg-green-600 text-white font-black italic uppercase text-2xl py-6 hover:bg-green-500 transition-all transform -skew-x-6 shadow-[6px_6px_0px_#a3e635] hover:translate-y-1 hover:shadow-[2px_2px_0px_#a3e635] mt-2 border-2 border-transparent cursor-pointer";
  });

  checkTerminos.addEventListener('change', (e) => {
    if (!e.target.checked) {
      btnProcesar.disabled = true;
      btnProcesar.className = "bg-zinc-800 text-zinc-500 font-black italic uppercase text-2xl py-6 transition-all transform -skew-x-6 cursor-not-allowed mt-2 border-2 border-transparent";
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msgError = document.getElementById('mensajeError');
    msgError.classList.add('hidden');

    if (!inputGenero.value) {
      msgError.textContent = "Por favor, seleccione el género del atleta.";
      msgError.classList.remove('hidden');
      return;
    }

    const categoriaSubir = inputCategoriaFinal.value;

    btnProcesar.textContent = "PROCESANDO INSCRIPCIÓN...";
    btnProcesar.disabled = true;

    try {
      const comprobanteFile = document.getElementById('comprobante').files[0];
      let comprobanteUrlFinal = "";

      if (comprobanteFile) {
        const fileExt = comprobanteFile.name.split('.').pop();
        const fileName = `cambibara-${Date.now()}.${fileExt}`;
        
        const { error: uploadError } = await supabase.storage
          .from('comprobantes-eventos')
          .upload(fileName, comprobanteFile);

        if (uploadError) throw uploadError;

        const { data: publicUrlData } = supabase.storage
          .from('comprobantes-eventos')
          .getPublicUrl(fileName);

        comprobanteUrlFinal = publicUrlData.publicUrl;
      }

      const nombreVal = document.getElementById('nombre').value.trim().toUpperCase();
      const apellidoVal = document.getElementById('apellido').value.trim().toUpperCase();
      const generoSeleccionado = inputGenero.value;

      const { error: dbError } = await supabase.from('inscripciones_cambibara').insert([{
        nombre: nombreVal,
        apellido: apellidoVal,
        genero: generoSeleccionado,
        cedula: document.getElementById('cedula').value.trim().toUpperCase(),
        fecha_nacimiento: document.getElementById('fecha_nacimiento').value,
        email: document.getElementById('email').value.trim().toLowerCase(),
        telefono: document.getElementById('telefono').value.trim().toUpperCase(),
        estado: document.getElementById('estado_res').value.trim().toUpperCase(),
        ciudad: document.getElementById('ciudad').value.trim().toUpperCase(),
        categoria: categoriaSubir,
        metodo_pago: document.getElementById('metodo_pago').value,
        referencia: document.getElementById('referencia').value.trim().toUpperCase(),
        fecha_pago: document.getElementById('fecha_pago').value,
        comprobante_url: comprobanteUrlFinal
      }]);

      if (dbError) throw dbError;

      document.getElementById('contenedorFormulario').classList.add('hidden');
      document.getElementById('pantallaExito').classList.remove('hidden');
      document.getElementById('pantallaExito').classList.add('flex');
      
      document.getElementById('exitoNombre').textContent = `${nombreVal} ${apellidoVal}`;
      document.getElementById('exitoCategoria').textContent = categoriaSubir;
      window.scrollTo(0, 0);

    } catch (error) {
      console.error(error);
      msgError.textContent = "Error al procesar la inscripción. Verifique los datos o intente nuevamente.";
      msgError.classList.remove('hidden');
      btnProcesar.textContent = "Completar Inscripción";
      btnProcesar.disabled = false;
    }
  });
</script>