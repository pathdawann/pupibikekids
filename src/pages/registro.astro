---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navegación Adaptada para Móvil / Escritorio -->
  <nav class="bg-black text-white p-4 border-b-4 border-lime-400">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-2xl md:text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPI BIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <a href="/" class="text-lime-400 font-black italic uppercase text-xs md:text-sm border border-lime-400 px-3 py-2 md:px-5 md:py-2 hover:bg-lime-400 hover:text-black transition transform -skew-x-4 shadow-[3px_3px_0px_#db2777]">
        ← Volver al Inicio
      </a>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-16 max-w-4xl relative">
    <div class="absolute top-10 left-0 w-64 h-64 bg-pink-600 rounded-full mix-blend-screen filter blur-[100px] opacity-20 pointer-events-none"></div>

    <h1 class="text-4xl md:text-5xl font-black text-white mb-2 text-center uppercase italic transform -skew-x-6 drop-shadow-md">Inscripción a la <span class="text-lime-400">Academia</span></h1>
    <p class="text-zinc-400 mb-10 text-center italic text-lg font-medium">Crea tu cuenta de representante o atleta y registra tu ficha técnica.</p>

    <!-- Formulario -->
    <form id="registroForm" class="bg-zinc-900 p-8 md:p-10 shadow-[8px_8px_0px_#a3e635] border-2 border-lime-400 flex flex-col gap-8 relative z-10">
      
      <!-- SECCIÓN 1: Credenciales -->
      <div>
        <div class="bg-black inline-block px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_#00d2ff] mb-6">
          <h2 class="text-xl font-black uppercase italic text-cyan-400 tracking-wider">1. Credenciales de Acceso</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Correo Electrónico</label>
            <input type="email" id="email" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-lime-400 transition transform -skew-x-2 lowercase">
          </div>
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Crear Contraseña</label>
            <input type="password" id="password" required minlength="6" placeholder="Mínimo 6 caracteres" class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          </div>
        </div>
      </div>

      <!-- SECCIÓN 2: Ficha del Atleta -->
      <div>
        <div class="bg-black inline-block px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_#00d2ff] mb-6 mt-4">
          <h2 class="text-xl font-black uppercase italic text-cyan-400 tracking-wider">2. Ficha del Atleta</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Nombre del Atleta</label>
            <input type="text" id="nombre" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          </div>
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Cédula (Atleta o Representante)</label>
            <input type="text" id="cedula" placeholder="V-12345678" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          </div>
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Teléfono / WhatsApp</label>
            <input type="text" id="telefono" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          </div>
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Fecha de Nacimiento</label>
            <input type="date" id="fecha_nacimiento" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          </div>
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Dirección / Residencia</label>
            <input type="text" id="direccion" placeholder="Ciudad, Urbanización, Calle" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          </div>
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Nivel a Inscribir</label>
            <select id="nivel" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2 appearance-none">
              <option value="PRINCIPIANTE">PRINCIPIANTE (RUEDITAS / BALANCE)</option>
              <option value="INTERMEDIO">INTERMEDIO (MTB BÁSICO)</option>
              <option value="AVANZADO">AVANZADO (COMPETICIÓN)</option>
            </select>
          </div>
          <!-- NUEVO CAMPO: Tipo de Sangre (Opcional) -->
          <div>
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Tipo de Sangre (Opcional)</label>
            <select id="tipo_sangre" class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2 appearance-none">
              <option value="">-- NO ESPECIFICADO --</option>
              <option value="O+">O+</option>
              <option value="O-">O-</option>
              <option value="A+">A+</option>
              <option value="A-">A-</option>
              <option value="B+">B+</option>
              <option value="B-">B-</option>
              <option value="AB+">AB+</option>
              <option value="AB-">AB-</option>
            </select>
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-black uppercase italic mb-2 text-zinc-300 tracking-wider">Fotografía del Atleta (Opcional)</label>
            <input type="file" id="fotoFile" accept="image/*" class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold file:mr-4 file:py-2 file:px-4 file:border-0 file:text-sm file:font-black file:bg-lime-400 file:text-black hover:file:bg-lime-300 cursor-pointer">
          </div>
        </div>

        <!-- SECCIÓN 3: Bicicleta Principal -->
        <div class="bg-zinc-950 p-6 border-2 border-zinc-800 mt-6">
          <h3 class="text-lime-400 font-black italic uppercase text-lg mb-4">Información de la Bicicleta Principal (Opcional)</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Tipo de Bici</label>
              <select id="biciTipo" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold">
                <option value="MTB">MTB</option>
                <option value="RUTA">RUTA</option>
                <option value="GRAVEL">GRAVEL</option>
                <option value="BALANCE">BALANCE</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Rin</label>
              <input type="text" id="biciRin" placeholder="Ej: 29" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400">
            </div>
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Marca</label>
              <input type="text" id="biciMarca" placeholder="Ej: Giant" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400">
            </div>
            <div>
              <label class="block text-xs font-black uppercase tracking-wider text-zinc-400 mb-1">Color</label>
              <input type="text" id="biciColor" placeholder="Ej: Verde" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400">
            </div>
          </div>
        </div>

      </div>

      <div id="mensaje" class="hidden"></div>

      <button type="submit" id="btnSubmit" class="bg-lime-400 text-black font-black italic uppercase text-2xl py-4 hover:bg-lime-300 transition-all transform -skew-x-6 shadow-[6px_6px_0px_#db2777] hover:translate-y-1 hover:shadow-[2px_2px_0px_#db2777] mt-6 border-2 border-transparent">
        Crear Cuenta
      </button>
    </form>
  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('registroForm');
  const mensaje = document.getElementById('mensaje');
  const btnSubmit = document.getElementById('btnSubmit');

  form.addEventListener('submit', async (e) => {
    e.preventDefault(); 
    
    btnSubmit.textContent = "SUBIENDO FOTO Y CREANDO CUENTA...";
    btnSubmit.disabled = true;

    const email = document.getElementById('email').value.toLowerCase();
    const password = document.getElementById('password').value;
    const nombre = document.getElementById('nombre').value.toUpperCase();
    const cedula = document.getElementById('cedula').value.toUpperCase();
    const telefono = document.getElementById('telefono').value.toUpperCase();
    const fecha_nacimiento = document.getElementById('fecha_nacimiento').value;
    const direccion = document.getElementById('direccion').value.toUpperCase();
    const nivel = document.getElementById('nivel').value.toUpperCase();
    const tipo_sangre = document.getElementById('tipo_sangre').value; // <--- Nuevo valor
    const fotoFile = document.getElementById('fotoFile').files[0];

    let fotoUrlFinal = '';

    try {
      // 1. Crear usuario en Supabase Auth
      const { data: authData, error: authError } = await supabase.auth.signUp({
        email: email,
        password: password,
      });

      if (authError) throw authError;
      
      const userId = authData.user?.id;
      if (!userId) throw new Error("No se pudo obtener el ID del usuario.");

      // 2. Foto a Storage (Opcional)
      if (fotoFile) {
        const fileExt = fotoFile.name.split('.').pop();
        const fileName = `${userId}-${Math.random()}.${fileExt}`;
        const filePath = `${fileName}`;

        const { error: uploadError } = await supabase.storage.from('fotos-atletas').upload(filePath, fotoFile);
        if (uploadError) throw uploadError;

        const { data: publicUrlData } = supabase.storage.from('fotos-atletas').getPublicUrl(filePath);
        fotoUrlFinal = publicUrlData.publicUrl;
      }

      // 3. Bicicleta (Se guarda solo si escribieron algo, ya que es opcional)
      const listaBicicletas = [];
      const biciRin = document.getElementById('biciRin').value.toUpperCase();
      const biciMarca = document.getElementById('biciMarca').value.toUpperCase();
      const biciColor = document.getElementById('biciColor').value.toUpperCase();

      if (biciRin || biciMarca || biciColor) {
        listaBicicletas.push({
          tipo: document.getElementById('biciTipo').value,
          rin: biciRin,
          marca: biciMarca,
          color: biciColor
        });
      }

      // 4. Guardar registro en la tabla alumnos
      const { error: errorAlumno } = await supabase
        .from('alumnos')
        .insert([{ 
          user_id: userId,
          email: email,
          nombre: nombre,
          cedula: cedula,
          telefono: telefono,
          fecha_nacimiento: fecha_nacimiento,
          direccion: direccion,
          nivel: nivel,
          tipo_sangre: tipo_sangre, // <--- Enviado a la base de datos
          foto_url: fotoUrlFinal,
          tipos_bici: listaBicicletas
        }]);

      if (errorAlumno) throw errorAlumno;

      form.reset();
      mensaje.textContent = "¡Inscripción exitosa! Redirigiendo a tu panel...";
      mensaje.className = "p-4 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-lime-400 text-black block mt-2";
      
      setTimeout(() => {
         window.location.href = '/dashboard';
      }, 2000);

    } catch (error) {
      console.error(error);
      let errorMsg = "Hubo un error. Verifica tus datos.";
      if (error.message.includes('already registered')) errorMsg = "Este correo ya está registrado.";
      if (error.message.includes('row-level security') || error.message.includes('policy')) {
        errorMsg = "Error de permisos en Storage. Asegúrate de que el bucket 'fotos-atletas' sea público.";
      }
      
      mensaje.textContent = errorMsg;
      mensaje.className = "p-4 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-pink-600 text-white block mt-2";
    } finally {
      btnSubmit.textContent = "Crear Cuenta";
      btnSubmit.disabled = false;
    }
  });
</script>