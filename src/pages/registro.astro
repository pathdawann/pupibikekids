---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inscripción a la Academia | Pupi Bike Kids">
  <!-- Navegación Adaptada para Móvil / Escritorio -->
  <nav class="bg-black text-white p-4 border-b-4 border-lime-400">
    <div class="container mx-auto px-4 max-w-7xl flex justify-between items-center">
      <a href="/" class="text-2xl md:text-3xl font-black italic tracking-wider text-white transform -skew-x-6 hover:opacity-80 transition">
        PUPI BIKE 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1d4ed8] via-[#06b6d4] to-[#84cc16]">KIDS</span>
      </a>
      <a href="/" class="text-lime-400 font-black italic uppercase text-xs md:text-sm border border-lime-400 px-3 py-2 md:px-5 md:py-2 hover:bg-lime-400 hover:text-black transition transform -skew-x-4 shadow-[3px_3px_0px_#db2777]">
        ← Volver al Inicio
      </a>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-16 max-w-4xl relative">
    <div class="absolute top-10 left-0 w-64 h-64 bg-pink-600 rounded-full mix-blend-screen filter blur-[100px] opacity-20 pointer-events-none"></div>

    <h1 class="text-4xl md:text-5xl font-black text-white mb-2 text-center uppercase italic transform -skew-x-6 drop-shadow-md">Inscripción a la <span class="text-lime-400">Academia</span></h1>
    <p class="text-zinc-100 mb-10 text-center italic text-lg font-medium">Crea tu cuenta de representante o atleta y registra tu ficha técnica.</p>

    <!-- Formulario -->
<form id="registroForm" class="bg-zinc-900 p-8 md:p-10 shadow-[8px_8px_0px_#a3e635] border-2 border-lime-400 flex flex-col gap-8 relative z-10">
  
  <!-- SECCIÓN 1: Credenciales -->
  <div>
    <div class="bg-black inline-block px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_#00d2ff] mb-6">
      <h2 class="text-xl font-black uppercase italic text-cyan-400 tracking-wider">1. Credenciales de Acceso</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="email" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Correo Electrónico</label>
        <input type="email" id="email" autocomplete="email" placeholder="tucorreo@ejemplo.com" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-lime-400 transition transform -skew-x-2 lowercase placeholder-zinc-500">
      </div>
      <div>
        <label for="password" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Crear Contraseña</label>
        <div class="relative transform -skew-x-2">
          <input 
            type="password" 
            id="password" 
            autocomplete="new-password" 
            required 
            minlength="6" 
            placeholder="Mínimo 6 caracteres" 
            class="w-full pl-4 pr-12 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-lime-400 transition placeholder-zinc-500"
          >
          <button 
            type="button" 
            id="btnTogglePassword" 
            aria-label="Mostrar u ocultar contraseña" 
            class="absolute inset-y-0 right-0 pr-4 flex items-center text-zinc-300 hover:text-lime-400 transition focus:outline-none"
          >
            <!-- Ícono ojo abierto (ver) -->
            <svg id="iconoOjoAbierto" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <!-- Ícono ojo tachado (ocultar) -->
            <svg id="iconoOjoCerrado" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- SECCIÓN 2: Ficha del Atleta -->
  <div>
    <div class="bg-black inline-block px-6 py-2 transform -skew-x-6 shadow-[4px_4px_0px_#00d2ff] mb-6 mt-4">
      <h2 class="text-xl font-black uppercase italic text-cyan-400 tracking-wider">2. Ficha del Atleta</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div>
        <label for="nombre" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Nombre y Apellido del Atleta</label>
        <input type="text" id="nombre" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
      </div>
      <div>
        <label for="cedula" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Cédula (Atleta o Representante)</label>
        <input type="text" id="cedula" placeholder="V-12345678" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2 placeholder-zinc-500">
      </div>
      <div>
        <label for="telefono" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Teléfono / WhatsApp</label>
        <input type="text" id="telefono" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
      </div>
      <div>
        <label for="fecha_nacimiento" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Fecha de Nacimiento</label>
        <input type="date" id="fecha_nacimiento" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
      </div>
      <div>
        <label for="direccion" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Dirección / Residencia</label>
        <input type="text" id="direccion" placeholder="Urbanización, Sector, Ciudad." required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2 placeholder-zinc-500">
      </div>
      <div>
        <label for="nivel" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Nivel a Inscribir</label>
        <select id="nivel" required class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          <option value="PRINCIPIANTE">PRINCIPIANTE (RUEDITAS / BALANCE)</option>
          <option value="INTERMEDIO">INTERMEDIO (MTB BÁSICO)</option>
          <option value="AVANZADO">AVANZADO (COMPETICIÓN)</option>
          <option value="PROSPECTO">PROSPECTOS (ALTO RENDIMIENTO)</option>
          <option value="ADULTOS">ENTRENAMIENTO PARA ADULTOS (TÉCNICA Y RESISTENCIA)</option>
        </select>
      </div>
      <!-- Tipo de Sangre (Opcional) -->
      <div>
        <label for="tipo_sangre" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Tipo de Sangre (Opcional)</label>
        <select id="tipo_sangre" class="w-full px-4 py-3 bg-zinc-950 border-2 border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 transition transform -skew-x-2">
          <option value="">-- NO ESPECIFICADO --</option>
          <option value="O+">O+</option>
          <option value="O-">O-</option>
          <option value="A+">A+</option>
          <option value="A-">A-</option>
          <option value="B+">B+</option>
          <option value="B-">B-</option>
          <option value="AB+">AB+</option>
          <option value="AB-">AB-</option>
        </select>
      </div>

      <!-- Fotografía del Atleta -->
      <div>
        <label for="fotoFile" class="block text-sm font-black uppercase italic mb-2 text-white tracking-wider">Fotografía del Atleta</label>
        <input type="file" id="fotoFile" accept="image/*" class="w-full px-4 py-2.5 bg-zinc-950 border-2 border-zinc-700 text-white font-bold file:mr-4 file:py-1.5 file:px-4 file:border-0 file:text-xs file:font-black file:bg-lime-400 file:text-black hover:file:bg-lime-300 cursor-pointer transform -skew-x-2">
      </div>

      <!-- APARTADO INCLUSIVO: Neurodivergencia / Condición de Salud / Acompañamiento -->
      <div class="md:col-span-2 bg-zinc-950 p-6 border-2 border-cyan-400 mt-2">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <label for="tieneCondicion" class="block text-base font-black uppercase italic text-cyan-400 tracking-wider">
              💙 ¿Presentas alguna condición médica, alergia o neurodivergencia?
            </label>
            <p class="text-sm text-white font-medium italic mt-2 leading-relaxed">
              Saber esto nos ayuda a brindar un acompañamiento adecuado, más seguro y personalizado.
            </p>
          </div>
          <div class="w-full md:w-72 flex-shrink-0">
            <select id="tieneCondicion" class="w-full px-4 py-3 bg-zinc-900 border-2 border-zinc-600 text-white font-bold uppercase focus:outline-none focus:border-cyan-400 transition">
              <option value="NO">NO</option>
              <option value="SI">SÍ</option>
            </select>
          </div>
        </div>

        <!-- Cuadro desplegable cuando seleccionan SÍ -->
        <div id="bloqueDetalleCondicion" class="hidden mt-5 pt-4 border-t border-zinc-800">
          <label for="detalleCondicion" class="block text-xs font-black uppercase italic text-lime-400 mb-2 tracking-wider">
            Detalla la condición o recomendaciones especiales para el entrenador:
          </label>
          <textarea 
            id="detalleCondicion" 
            rows="3" 
            placeholder="Ej: TEA, TDAH, asma, alergias, sensibilidad a ruidos fuertes (como silbatos) o sugerencias prácticas para su aprendizaje en pista..." 
            class="w-full px-4 py-3 bg-zinc-900 border-2 border-zinc-600 text-white text-sm font-medium focus:outline-none focus:border-lime-400 transition placeholder-zinc-400"
          ></textarea>
          <span class="text-md text-zinc-100 font-medium italic block mt-2">
            🔒 Información confidencial de uso exclusivo para el equipo de instructores.
          </span>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 3: Bicicleta Principal -->
    <div class="bg-zinc-950 p-6 border-2 border-zinc-800 mt-6">
      <h3 class="text-lime-400 font-black italic uppercase text-lg mb-4">Información de la Bicicleta Principal (Opcional)</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label for="biciTipo" class="block text-xs font-black uppercase tracking-wider text-zinc-200 mb-1">Tipo de Bici</label>
          <select id="biciTipo" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold">
            <option value="MTB">MTB</option>
            <option value="RUTA">RUTA</option>
            <option value="GRAVEL">GRAVEL</option>
            <option value="BALANCE">BALANCE</option>
          </select>
        </div>
        <div>
          <label for="biciRin" class="block text-xs font-black uppercase tracking-wider text-zinc-200 mb-1">Rin</label>
          <input type="text" id="biciRin" placeholder="Ej: 29" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 placeholder-zinc-500">
        </div>
        <div>
          <label for="biciMarca" class="block text-xs font-black uppercase tracking-wider text-zinc-200 mb-1">Marca</label>
          <input type="text" id="biciMarca" placeholder="Ej: Giant" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 placeholder-zinc-500">
        </div>
        <div>
          <label for="biciColor" class="block text-xs font-black uppercase tracking-wider text-zinc-200 mb-1">Color</label>
          <input type="text" id="biciColor" placeholder="Ej: Verde" class="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 text-white font-bold uppercase focus:outline-none focus:border-lime-400 placeholder-zinc-500">
        </div>
      </div>
    </div>

  </div>

  <div id="mensaje" class="hidden"></div>

  <!-- Botón Centrado y Compacto -->
  <div class="flex justify-center w-full mt-4">
    <button type="submit" id="btnSubmit" class="w-full max-w-sm bg-lime-400 text-black font-black italic uppercase text-xl py-3.5 hover:bg-lime-300 transition-all transform -skew-x-6 shadow-[6px_6px_0px_#db2777] hover:translate-y-1 hover:shadow-[2px_2px_0px_#db2777] border-2 border-transparent">
      Crear Cuenta
    </button>
  </div>
</form>
  </main>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('registroForm');
  const mensaje = document.getElementById('mensaje');
  const btnSubmit = document.getElementById('btnSubmit');

  // Alternar visualización de la contraseña (Ojito)
  const btnTogglePassword = document.getElementById('btnTogglePassword');
  const inputPassword = document.getElementById('password');
  const iconoOjoAbierto = document.getElementById('iconoOjoAbierto');
  const iconoOjoCerrado = document.getElementById('iconoOjoCerrado');

  if (btnTogglePassword && inputPassword) {
    btnTogglePassword.addEventListener('click', () => {
      const esPassword = inputPassword.type === 'password';
      inputPassword.type = esPassword ? 'text' : 'password';
      iconoOjoAbierto.classList.toggle('hidden', esPassword);
      iconoOjoCerrado.classList.toggle('hidden', !esPassword);
    });
  }

  // Preselección segura desde la URL (?nivel=...)
  const urlParams = new URLSearchParams(window.location.search);
  const nivelUrl = urlParams.get('nivel')?.toUpperCase();
  const nivelesValidos = ['PRINCIPIANTE', 'INTERMEDIO', 'AVANZADO', 'PROSPECTO', 'ADULTOS'];
  if (nivelUrl && nivelesValidos.includes(nivelUrl)) {
    const selectNivel = document.getElementById('nivel');
    if (selectNivel) {
      selectNivel.value = nivelUrl;
    }
  }

  // Mostrar / ocultar el cuadro de condición especial o neurodivergencia
  const selectTieneCondicion = document.getElementById('tieneCondicion');
  const bloqueDetalleCondicion = document.getElementById('bloqueDetalleCondicion');
  const inputDetalleCondicion = document.getElementById('detalleCondicion');

  selectTieneCondicion?.addEventListener('change', (e) => {
    if (e.target.value === 'SI') {
      bloqueDetalleCondicion.classList.remove('hidden');
      inputDetalleCondicion.required = true;
      inputDetalleCondicion.focus();
    } else {
      bloqueDetalleCondicion.classList.add('hidden');
      inputDetalleCondicion.required = false;
      inputDetalleCondicion.value = '';
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault(); 
    
    mensaje.classList.add('hidden');

    const email = document.getElementById('email').value.trim().toLowerCase();
    const password = document.getElementById('password').value;
    const nombre = document.getElementById('nombre').value.trim().toUpperCase();
    const cedula = document.getElementById('cedula').value.trim().toUpperCase();
    const telefono = document.getElementById('telefono').value.trim().toUpperCase();
    const fecha_nacimiento = document.getElementById('fecha_nacimiento').value;
    const direccion = document.getElementById('direccion').value.trim().toUpperCase();
    const nivel = document.getElementById('nivel').value.toUpperCase();
    const tipo_sangre = document.getElementById('tipo_sangre').value;
    const fotoFile = document.getElementById('fotoFile').files[0];

    // Procesar condición especial / neurodivergencia
    const tieneCondicion = selectTieneCondicion.value;
    const detalleCondicionTexto = inputDetalleCondicion.value.trim().toUpperCase();
    const condicion_especial = (tieneCondicion === 'SI' && detalleCondicionTexto) 
      ? detalleCondicionTexto 
      : 'NINGUNA';

    if (fotoFile && fotoFile.size > 5 * 1024 * 1024) {
      mensaje.textContent = "La fotografía supera los 5 MB. Por favor elige una imagen más liviana.";
      mensaje.className = "p-4 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-pink-600 text-white block mt-2";
      mensaje.classList.remove('hidden');
      return;
    }

    btnSubmit.textContent = "CREANDO CUENTA...";
    btnSubmit.disabled = true;

    let fotoUrlFinal = '';

    try {
      const { data: authData, error: authError } = await supabase.auth.signUp({
        email: email,
        password: password,
      });

      if (authError) throw authError;
      
      const userId = authData.user?.id;
      if (!userId) throw new Error("No se pudo obtener el ID del usuario.");

      if (fotoFile) {
        try {
          btnSubmit.textContent = "SUBIENDO FOTOGRAFÍA...";
          const fileExt = fotoFile.name.split('.').pop()?.toLowerCase() || 'jpg';
          const fileName = `${userId}-perfil.${fileExt}`;

          const { error: uploadError } = await supabase.storage
            .from('fotos-atletas')
            .upload(fileName, fotoFile, { upsert: true });

          if (!uploadError) {
            const { data: publicUrlData } = supabase.storage
              .from('fotos-atletas')
              .getPublicUrl(fileName);

            fotoUrlFinal = publicUrlData.publicUrl;
          } else {
            console.warn("No se pudo subir la foto inicial, se continuará con el registro de la ficha:", uploadError);
          }
        } catch (storageErr) {
          console.warn("Error subiendo foto inicial:", storageErr);
        }
      }

      const listaBicicletas = [];
      const biciRin = document.getElementById('biciRin').value.trim().toUpperCase();
      const biciMarca = document.getElementById('biciMarca').value.trim().toUpperCase();
      const biciColor = document.getElementById('biciColor').value.trim().toUpperCase();

      if (biciRin || biciMarca || biciColor) {
        listaBicicletas.push({
          tipo: document.getElementById('biciTipo').value,
          rin: biciRin,
          marca: biciMarca,
          color: biciColor
        });
      }

      btnSubmit.textContent = "GUARDANDO FICHA...";
      const { error: errorAlumno } = await supabase
        .from('alumnos')
        .insert([{ 
          user_id: userId,
          email: email,
          nombre: nombre,
          cedula: cedula,
          telefono: telefono,
          fecha_nacimiento: fecha_nacimiento,
          direccion: direccion,
          nivel: nivel,
          tipo_sangre: tipo_sangre,
          condicion_especial: condicion_especial,
          foto_url: fotoUrlFinal,
          tipos_bici: listaBicicletas
        }]);

      if (errorAlumno) throw errorAlumno;

      form.reset();
      bloqueDetalleCondicion.classList.add('hidden');

      if (!authData.session) {
        mensaje.textContent = "¡Inscripción registrada! Revisa tu correo para confirmar tu cuenta antes de iniciar sesión.";
        mensaje.className = "p-4 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-cyan-400 text-black block mt-2";
        mensaje.classList.remove('hidden');
        setTimeout(() => {
          window.location.href = '/login';
        }, 3500);
      } else {
        mensaje.textContent = "¡Inscripción exitosa! Redirigiendo a tu panel...";
        mensaje.className = "p-4 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-lime-400 text-black block mt-2";
        mensaje.classList.remove('hidden');
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 2000);
      }

    } catch (error) {
      console.error(error);
      let errorMsg = "Hubo un error. Verifica tus datos.";
      if (error.message && error.message.includes('already registered')) {
        errorMsg = "Este correo ya está registrado. Por favor inicia sesión.";
      } else if (error.message) {
        errorMsg = error.message;
      }
      
      mensaje.textContent = errorMsg;
      mensaje.className = "p-4 text-center font-black italic uppercase transform -skew-x-6 shadow-[4px_4px_0px_rgba(0,0,0,0.5)] bg-pink-600 text-white block mt-2";
      mensaje.classList.remove('hidden');
    } finally {
      btnSubmit.textContent = "Crear Cuenta";
      btnSubmit.disabled = false;
    }
  });
</script>