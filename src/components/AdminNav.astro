---
// src/components/AdminNav.astro
const { titulo = "ADMIN", color = "blue", volverAdmin = false } = Astro.props;

// Mapeo estricto para que Tailwind detecte las clases correctamente
const bgColor = color === 'emerald' ? 'bg-emerald-600' : color === 'pink' ? 'bg-pink-600' : color === 'purple' ? 'bg-purple-600' : 'bg-blue-600';
const textColor = color === 'emerald' ? 'text-emerald-600' : color === 'pink' ? 'text-pink-600' : color === 'purple' ? 'text-purple-600' : 'text-blue-600';
---

<nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
  <div class="container mx-auto px-4 lg:px-8 max-w-[96%] flex justify-between items-center h-16">
    <div class="flex items-center gap-2">
      <div class={`w-8 h-8 ${bgColor} rounded-lg flex items-center justify-center`}>
        <span class="text-white font-black text-sm italic">PK</span>
      </div>
      <a href="/admin" class="text-xl font-black italic tracking-tight text-gray-900">
        PUPIBIKE<span class={textColor}>{titulo}</span>
      </a>
    </div>
    <div class="flex items-center gap-4">
      {volverAdmin ? (
        <a href="/admin" class={`text-sm font-bold text-gray-500 hover:${textColor} transition`}>← Volver al Admin</a>
      ) : (
        <>
          <a href="/dashboard" class="text-sm font-medium text-gray-500 hover:text-blue-600 transition">Vista Atleta</a>
          <button id="btnAdminNavLogout" class="text-sm font-medium text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-4 py-1.5 rounded-md transition">
            Cerrar Sesión
          </button>
        </>
      )}
    </div>
  </div>
</nav>

{!volverAdmin && (
  <script type="module">
    import { supabase } from '../lib/supabase.js';
    document.getElementById('btnAdminNavLogout')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  </script>
)}